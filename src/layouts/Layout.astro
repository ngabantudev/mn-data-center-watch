---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  metadata?: {
    title?: string;
    description?: string;
    ogImage?: string;
    ignoreTitleTemplate?: boolean;
  };
}

const { metadata = {} } = Astro.props;

const siteTitle = "MN Data Center Watch";
const siteDescription =
  "Community-driven, open-source tracking of proposed and operating AI data centers across Minnesota — capacity, cost, water use, and local news in one map.";

const displayTitle = metadata.title
  ? metadata.ignoreTitleTemplate
    ? metadata.title
    : `${metadata.title} | ${siteTitle}`
  : siteTitle;
const displayDescription = metadata.description || siteDescription;

// Minimal favicon matching the map's own marker style: a colored circle
// with a white ring on a dark square, so the browser tab echoes the map.
// Kept theme-independent — the tab icon shouldn't flicker on theme switch.
const faviconSvg =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
  '<rect width="32" height="32" rx="8" fill="#131314"/>' +
  '<circle cx="16" cy="16" r="9" fill="#10b981" stroke="#ffffff" stroke-width="2"/>' +
  "</svg>";
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!--
  No `dark` class in the served markup — the inline script in <head> adds it
  before first paint when that's the stored preference. Keeping it off the
  static HTML means the light civic theme is what a no-JS or slow-JS visitor
  sees, which is the safer default for a public-records site.
-->
<html lang="en" class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#002d5d" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    {/*
      Runs before first paint to avoid a flash of the wrong theme. It has to
      be inline and dependency-free — importing siteTheme.ts here would defer
      it past paint, which is the exact problem it exists to solve — so the
      storage key and theme-color values are duplicated from that module.
      Keep the two in sync if either changes.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("siteTheme");
          if (stored !== "light" && stored !== "dark") stored = "light";
          if (stored === "dark") {
            document.documentElement.classList.add("dark");
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute("content", "#131314");
          }
        } catch (e) {}
      })();
    </script>
    <title>{displayTitle}</title>
    <meta name="description" content={displayDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={displayDescription} />
    {metadata.ogImage && <meta property="og:image" content={metadata.ogImage} />}

    <meta
      name="twitter:card"
      content={metadata.ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={displayDescription} />
    {metadata.ogImage && <meta name="twitter:image" content={metadata.ogImage} />}

    <!--
      Warm up the connections the map needs on first paint: the basemap
      tile server (used immediately) and the R2 bucket serving the
      PMTiles environmental layers (used as soon as a layer toggle fires).
    -->
    <link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin />
    <link
      rel="preconnect"
      href="https://pub-9f0c29be0f0040ee8ff0b8e3bad571d5.r2.dev"
      crossorigin
    />

    <!--
    MapLibre's CSS is imported directly in MapParent.astro's script
    (`import 'maplibre-gl/dist/maplibre-gl.css'`), so it always matches
    whatever maplibre-gl version is actually installed. Intentionally not
    duplicated here via CDN to avoid loading two different versions.
  -->
  </head>

  <!--
    text-ink-canvas, not text-ink: the body sits on --canvas (the map backdrop),
    which is a different surface from the panels --ink is measured against. See
    the palette notes in global.css.
  -->
  <body class="bg-canvas text-ink-canvas antialiased h-full flex flex-col">
    <main id="main-content" class="grow">
      <slot />
    </main>
  </body>
</html>
