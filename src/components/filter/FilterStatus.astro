---
// src/components/filter/FilterStatus.astro
//
// Project-status checkboxes and legend. Presentational only — MapFilterParent
// owns the single dispatcher that assembles FilterCriteria.
//
// Reads STATUS_META and owns its icon map directly, the way FilterSize and
// FilterLegal read theirs. Both used to arrive as props from MapFilterParent,
// which meant the parent imported a registry it never otherwise touched purely
// to hand it straight back down, and the icons for a status axis lived in a file
// that has nothing to do with statuses.
import AccordionSection from "~/components/ui/AccordionSection.astro";
import type { ProjectStatus } from "~/data/dataCenters";
import { STATUS_META } from "~/data/mapStatusMeta";
import {
  Zap,
  HardHat,
  ClipboardList,
  CirclePause,
  CircleX,
} from "lucide-astro";

interface Props {
  countsByStatus: Partial<Record<ProjectStatus, number>>;
}

const { countsByStatus } = Astro.props;

const STATUS_ICONS: Record<ProjectStatus, typeof Zap> = {
  active: Zap,
  construction: HardHat,
  planned: ClipboardList,
  paused: CirclePause,
  rejected: CircleX,
};
---

<AccordionSection title="Project Status">
  <div
    class="flex items-center justify-between gap-2 px-3.5 md:px-4 py-2 border-t border-b border-hair bg-panel-3"
  >
    <div class="flex items-center gap-2 text-[10px] font-semibold">
      <button
        id="mf-select-all"
        type="button"
        class="text-accent hover:text-accent-hover underline underline-offset-2"
        >All</button
      >
      <span class="text-ink-4">/</span>
      <button
        id="mf-clear-all"
        type="button"
        class="text-ink-4 hover:text-ink underline underline-offset-2"
        >None</button
      >
    </div>
    <span
      class="text-[9px] uppercase tracking-wider text-ink-4 font-semibold whitespace-nowrap"
    >
      {STATUS_META.length} types
    </span>
  </div>

  <div
    class="grid grid-cols-2 gap-1 p-2 md:flex md:flex-col md:gap-0.5 md:p-1.5 pb-3"
  >
    {
      STATUS_META.map((meta) => {
        const Icon = STATUS_ICONS[meta.status];
        const count = countsByStatus[meta.status] ?? 0;
        return (
          <label class="group flex items-center gap-2.5 md:gap-3 cursor-pointer rounded-lg px-2 py-2 transition-colors hover:bg-hover">
            <input
              type="checkbox"
              class="mf-checkbox w-3.5 h-3.5 rounded border-hair-strong bg-panel-2 shrink-0 cursor-pointer"
              style={`accent-color: ${meta.hex}`}
              value={meta.status}
              checked
            />
            <div class="relative w-6 h-6 md:w-7 md:h-7 shrink-0 flex items-center justify-center">
              {meta.activePulse && (
                <span
                  class="absolute inline-flex h-full w-full rounded-full opacity-50 animate-ping"
                  style={`background-color: ${meta.hex}`}
                />
              )}
              <span
                class="relative flex items-center justify-center w-full h-full rounded-full"
                style={`background-color: ${meta.hex}26; color: ${meta.hex};`}
              >
                <Icon size={14} stroke-width={2.25} />
              </span>
            </div>
            <span class="text-[11px] md:text-xs font-semibold text-ink leading-none flex-1 min-w-0 truncate">
              {meta.filterLabel}
            </span>
            <span class="text-[10px] md:text-[11px] font-bold text-ink-4 group-hover:text-ink-2 font-mono tabular-nums shrink-0 ml-auto">
              {count}
            </span>
          </label>
        );
      })
    }
  </div>
</AccordionSection>
