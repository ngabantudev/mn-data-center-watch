---
import AccordionSection from "~/components/ui/AccordionSection.astro";
import { ChevronRight } from "lucide-astro";
import type { Project } from "~/data/dataCenters";

interface Props {
  largestProjects: Project[];
  openByDefault?: boolean;
}

const { largestProjects } = Astro.props;
---

<AccordionSection id="projects" title="Largest Centers">
  <div
    class="px-3.5 md:px-4 pb-4 max-h-60 overflow-y-auto hide-scrollbar space-y-0.5 pt-2"
  >
    {
      largestProjects.map((project) => (
        <button
          type="button"
          data-project-name={project.name}
          class="mf-project-link flex items-center justify-between w-full px-2 py-1.5 rounded-md hover:bg-hover transition-colors text-left group"
        >
          <div class="min-w-0 flex flex-col">
            <span class="text-[11px] font-medium text-ink-2 truncate">
              {project.name}
            </span>
            <span class="text-[9px] text-ink-4 group-hover:text-ink-2">
              {project.powerCapacityMW}
            </span>
          </div>
          <ChevronRight
            size={14}
            class="text-ink-4 group-hover:text-ink shrink-0 ml-2"
          />
        </button>
      ))
    }
  </div>
</AccordionSection>
