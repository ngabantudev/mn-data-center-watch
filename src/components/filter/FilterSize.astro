---
// src/components/filter/FilterSize.astro
//
// Capacity buckets, replacing the old continuous MW slider. A slider asked
// the user to already know what "120 MW" means; these encode the meaning
// (and the venue the fight lands in) directly, show per-bucket counts, and
// are far easier to hit on mobile than a range input.
//
// Presentational only — MapFilterParent owns the single dispatcher that
// assembles FilterCriteria.
import AccordionSection from "~/components/ui/AccordionSection.astro";
import type { SizeTier } from "~/data/sizeTierMeta";
import { SIZE_TIER_META } from "~/data/sizeTierMeta";

interface Props {
  countsByTier: Record<SizeTier, number>;
  openByDefault?: boolean;
}

const { countsByTier } = Astro.props;
---

<AccordionSection id="size" title="Capacity Scale">
  <div
    class="flex items-center justify-between gap-2 px-3.5 md:px-4 py-2 border-t border-b border-white/5 bg-neutral-950/30"
  >
    <div class="flex items-center gap-2 text-[10px] font-semibold">
      <button
        id="mf-size-all"
        type="button"
        class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2"
        >All</button
      >
      <span class="text-neutral-700">/</span>
      <button
        id="mf-size-none"
        type="button"
        class="text-neutral-500 hover:text-neutral-300 underline underline-offset-2"
        >None</button
      >
    </div>
    <span
      class="text-[9px] uppercase tracking-wider text-neutral-600 font-semibold whitespace-nowrap"
    >
      Grid draw
    </span>
  </div>

  <div class="flex flex-col gap-0.5 p-1.5 pb-3">
    {
      SIZE_TIER_META.map((meta) => (
        <label class="mf-row group flex items-center gap-2.5 md:gap-3 cursor-pointer rounded-lg px-2 py-2 transition-colors hover:bg-white/5">
          <input
            type="checkbox"
            class="mf-size-checkbox w-3.5 h-3.5 rounded border-neutral-600 bg-neutral-800 shrink-0 cursor-pointer"
            style={`accent-color: ${meta.hex}`}
            value={meta.tier}
            checked
          />
          {/* Dot scales with the tier so the legend reads as the map does */}
          <span class="w-7 shrink-0 flex items-center justify-center">
            <span
              class="rounded-full"
              style={`width: ${meta.dotSize}px; height: ${meta.dotSize}px; background-color: ${meta.hex}; box-shadow: 0 0 0 2px ${meta.hex}26`}
            />
          </span>
          <span class="flex-1 min-w-0">
            <span class="flex items-baseline gap-1.5">
              <span class="text-[11px] md:text-xs font-semibold text-neutral-100 leading-none">
                {meta.label}
              </span>
              <span class="text-[9px] font-mono text-neutral-500 leading-none">
                {meta.rangeLabel}
              </span>
            </span>
            <span class="block text-[9px] text-neutral-500 leading-tight mt-1 truncate">
              {meta.description}
            </span>
          </span>
          <span class="text-[10px] md:text-[11px] font-bold text-neutral-500 font-mono tabular-nums shrink-0 ml-auto">
            {countsByTier[meta.tier] ?? 0}
          </span>
        </label>
      ))
    }
  </div>
</AccordionSection>
