---
// src/components/filter/FilterLayer.astro
import AccordionSection from "~/components/ui/AccordionSection.astro";
import {
  MAP_LAYER_GROUP_TITLE,
  layersInGroup,
  type MapLayerGroup,
} from "~/data/mapLayers";
import { Trees, Droplet, Landmark, Zap } from "lucide-astro";

interface Props {
  /** Which section this renders — one accordion per group. */
  group: MapLayerGroup;
}

const { group } = Astro.props;
const layers = layersInGroup(group);

// Ids, labels, event keys, file names, and fill hexes all come from
// ~/data/mapLayers.ts — the same registry MapParent.astro builds the layers
// from, so a toggle can no longer point at a layer that doesn't exist.
//
// What stays here, keyed by that registry's id:
//
//   * the icon, because lucide-astro exports Astro components and importing
//     those into a plain .ts data module is the wrong direction;
//   * the Tailwind swatch classes, which have to be written out as literal
//     strings in a template for the class scanner to see them, and which
//     deliberately differ per theme.
//
// These hues are layer *identity*, not chrome, so they stay fixed rather than
// going through the theme tokens — each one matches the fill its layer paints
// on the map, and that pairing has to hold in both themes.
//
// The two themes sit these on opposite surfaces, so each needs the opposite end
// of its ramp. The dark theme keeps the 500/400 pair it has always used, on
// near-black. The light theme's panel body is the portal off-white (#e9e9e9 for
// this strip), where the 400s land at 1.4–2.3:1 — invisible. It takes the 700 of
// each ramp instead: 4.2–5.9:1 there, clear of the 3.0:1 floor for UI graphics,
// and close enough to the `outlineHex` each layer already draws its own borders
// with to still read as that layer's colour. Hover deepens a further step, the
// same direction the ink tokens move on hover in this theme.
interface LayerSwatch {
  icon: typeof Trees;
  colorClass: string;
  accentClass: string;
}

/**
 * What a layer with no entry below gets: the neutral ink the city-boundaries
 * row uses, and a generic icon.
 *
 * There has to be one. mapLayers.ts exists so that adding an overlay is a
 * single edit to a single registry — and this map, keyed by that registry's
 * ids with no compiler link back to them, was the one place that quietly
 * wasn't. A fifth entry in MAP_LAYER_META without a matching swatch here
 * dereferenced `undefined.icon` and took the whole build down, which is a
 * hard failure for a purely cosmetic omission. Now the row renders in neutral
 * and the layer works; add the hue when you know what it should be.
 */
const FALLBACK_SWATCH: LayerSwatch = {
  icon: Landmark,
  colorClass: "text-ink-2 group-hover:text-ink",
  accentClass: "accent-neutral-800 dark:accent-neutral-300",
};

const SWATCHES: Record<string, LayerSwatch> = {
  "protected-lands": {
    icon: Trees,
    colorClass:
      "text-emerald-700 group-hover:text-emerald-800 dark:text-emerald-500 dark:group-hover:text-emerald-400",
    accentClass: "accent-emerald-700 dark:accent-emerald-400",
  },
  "drinking-water": {
    icon: Droplet,
    colorClass:
      "text-blue-700 group-hover:text-blue-800 dark:text-blue-500 dark:group-hover:text-blue-400",
    accentClass: "accent-blue-700 dark:accent-blue-400",
  },
  // The one entry that isn't a hue. This layer's identity on the map is a
  // black border per city, not a fill, and a purple swatch beside it would be
  // pointing at the 5%-opacity tint nobody sees. Black itself is unusable in
  // the dark theme, so each theme takes the darkest ink its panel can carry —
  // which is what "an outline" looks like on that surface.
  "city-boundaries": {
    icon: Landmark,
    colorClass: "text-ink group-hover:text-ink dark:text-ink-2 dark:group-hover:text-ink",
    accentClass: "accent-neutral-800 dark:accent-neutral-300",
  },
  "coop-territories": {
    icon: Zap,
    colorClass:
      "text-amber-700 group-hover:text-amber-800 dark:text-amber-500 dark:group-hover:text-amber-400",
    accentClass: "accent-amber-700 dark:accent-amber-400",
  },
};
---

<AccordionSection title={MAP_LAYER_GROUP_TITLE[group]}>
  <div
    class="flex flex-col gap-1 px-3.5 md:px-4 py-3 bg-panel-3 border-t border-b border-hair"
  >
    {
      layers.map((layer) => {
        const swatch = SWATCHES[layer.id] ?? FALLBACK_SWATCH;
        const IconComponent = swatch.icon;
        return (
          <label
            class="flex items-start gap-3 cursor-pointer group rounded-lg px-2 py-2 transition-colors hover:bg-hover has-disabled:cursor-not-allowed has-disabled:opacity-55 has-disabled:hover:bg-transparent"
          >
            <input
              type="checkbox"
              id={layer.toggleId}
              data-api-key={layer.apiKey}
              data-layer-id={layer.id}
              class={`environmental-layer-toggle mt-0.5 w-3.5 h-3.5 rounded border-hair-strong bg-panel-2 ${swatch.accentClass} cursor-pointer disabled:cursor-not-allowed`}
            />
            <span class={`mt-0.5 shrink-0 transition-colors ${swatch.colorClass}`}>
              <IconComponent size={16} stroke-width={2} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-xs font-semibold text-ink-2 group-hover:text-ink transition-colors">
                {layer.label}
              </span>
              <span class="block text-[10px] leading-snug text-ink-4 mt-0.5">
                {layer.description}
              </span>
              {/* Filled in only if the map reports the archive missing. */}
              <span
                class="hidden mt-1 text-[10px] font-semibold leading-snug text-ink-3"
                data-layer-status
              />
            </span>
          </label>
        );
      })
    }
  </div>

  <!-- Anything else that belongs in this section but isn't a tile overlay —
       today, the Politics section's moratorium layer, which is compiled from a
       hand-sourced registry rather than a PMTiles archive and so can't come
       from MAP_LAYER_META. -->
  <slot />
</AccordionSection>

<script>
  import { onReady } from "~/lib/domReady";
  import {
    LAYER_UNAVAILABLE_EVENT,
    type LayerUnavailableDetail,
    type LayerUnavailableReason,
  } from "~/data/mapLayers";

  // `onReady` re-runs this after every Astro navigation (see domReady.ts). The
  // listeners below are on elements rather than on `document`, but the elements
  // survive a navigation too — so a second run without this would leave each
  // checkbox dispatching `mapfilterchange` twice per click.
  let toggleCleanups: (() => void)[] = [];

  function setupLayerToggles() {
    while (toggleCleanups.length > 0) {
      toggleCleanups.pop()?.();
    }

    const toggles = document.querySelectorAll<HTMLInputElement>(
      ".environmental-layer-toggle",
    );

    toggles.forEach((toggle) => {
      const onChange = () => {
        const apiKey = toggle.dataset.apiKey;
        if (!apiKey) return;

        // Dispatch custom event matching MapParent's listener layout exactly
        document.dispatchEvent(
          new CustomEvent("mapfilterchange", {
            detail: { [apiKey]: toggle.checked },
          }),
        );
      };
      toggle.addEventListener("change", onChange);
      toggleCleanups.push(() => toggle.removeEventListener("change", onChange));
    });
  }

  // An overlay whose tile archive isn't published (or is unreachable) would
  // otherwise sit checked over an empty map with no explanation. The map tells
  // us once, and the row says so and stops offering the toggle. Since the map
  // now reads every archive during idle time after load rather than on first
  // click, a row that can't work says so before anyone waits on it.
  //
  // Two sentences, because they aren't the same fact: a dataset we haven't
  // uploaded is a gap in this map, while one we failed to fetch is a fault that
  // a reload might clear. Reporting the second as the first would tell a
  // visitor a public dataset doesn't exist yet.
  const UNAVAILABLE_TEXT: Record<LayerUnavailableReason, string> = {
    missing: "Dataset not published yet.",
    unreadable: "Couldn't load this dataset — try reloading.",
  };

  // Registered at module scope rather than inside setupLayerToggles(), which
  // `onReady` would re-run on `astro:page-load`: this listener is on
  // `document`, which survives a navigation, so re-registering would stack a
  // fresh copy per page view. It resolves the toggle by query at fire time, so
  // it stays correct across re-renders without being re-bound. (Nothing
  // dispatches `astro:page-load` on this site yet — see domReady.ts — so this
  // is the invariant being kept, not a bug being fixed.)
  document.addEventListener(LAYER_UNAVAILABLE_EVENT, (event) => {
    const { id, reason } = (event as CustomEvent<LayerUnavailableDetail>).detail;
    const toggle = document.querySelector<HTMLInputElement>(
      `.environmental-layer-toggle[data-layer-id="${id}"]`,
    );
    if (!toggle) return;

    toggle.checked = false;
    toggle.disabled = true;

    const status = toggle
      .closest("label")
      ?.querySelector<HTMLElement>("[data-layer-status]");
    if (status) {
      status.textContent = UNAVAILABLE_TEXT[reason];
      status.classList.remove("hidden");
    }
  });

  onReady(setupLayerToggles);
</script>
