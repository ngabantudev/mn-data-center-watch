---
import AccordionSection from "~/components/ui/AccordionSection.astro";
import { Trees } from "lucide-astro";
---

<div class="mf-accordion-section">
  <AccordionSection id="layers" title="Community Impacts">
    <div
      class="px-3.5 md:px-4 py-3 bg-neutral-950/20 border-t border-b border-white/5"
    >
      <label
        class="flex items-center gap-3 cursor-pointer group rounded-lg px-2 py-2 transition-colors hover:bg-white/5"
      >
        <input
          type="checkbox"
          id="mf-toggle-protected"
          class="w-3.5 h-3.5 rounded border-neutral-600 bg-neutral-800 accent-emerald-400 cursor-pointer"
        />
        <span
          class="text-emerald-500 group-hover:text-emerald-400 transition-colors"
        >
          <Trees size={16} stroke-width={2} />
        </span>
        <span
          class="text-xs font-semibold text-neutral-200 group-hover:text-white transition-colors"
        >
          Protected Areas
        </span>
      </label>
    </div>
  </AccordionSection>
</div>
