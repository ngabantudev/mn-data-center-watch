---
// src/components/filter/FilterHeader.astro
//
// The masthead plus the four headline totals, over the whole dataset rather
// than the current filter — this is the scale of the buildout, not a readout of
// what's on screen (that's the "Showing N of M" line in MapFilterParent).
//
// Desktop only, and presentational only. It used to render a `<button
// id="mf-header-trigger">` carrying a `md:hidden` chevron — inside a block that
// is itself `hidden md:flex`, so the chevron could never be on screen at any
// width, and the button's own handler was a no-op above 768px. Between them the
// sidebar had no working collapse on a phone and a dead control on the desktop.
// Opening and closing this panel is the desktop pull-tab's job at this width
// and MobileToolbar.astro's Filters tab below it; neither belongs in a masthead.
import { clientProjects } from "~/data/dataCenters";
import { countBy } from "~/lib/collections";
import { parseMW } from "~/lib/projectMetrics";

interface Props {
  totalCount: number;
}

const { totalCount } = Astro.props;

// Rejected and withdrawn projects are excluded from the money/power/jobs
// totals: they describe what Minnesota is actually being asked to absorb, and a
// cancelled site absorbs nothing. The Active/Total tile below still counts them,
// because there the denominator is the whole record.
const validProjects = clientProjects.filter((p) => p.status !== "rejected");

// `parseMW`, not a second regex. This file used to carry its own — one that
// averaged a range ("~10-15 MW" -> 12.5) where every other consumer on the map
// takes the first figure (-> 10). One capacity string in the dataset is a range,
// so the header was quietly reporting a total no other surface agreed with.
const totalMW = validProjects.reduce((sum, p) => sum + parseMW(p.powerCapacityMW), 0);

// `estimatedCost` is freetext, and several records legitimately carry more
// than one dollar figure -- an initial build cost alongside a later
// buildout/sale/upgrade figure (e.g. "$26 Million (2013 initial build); ~$90
// Million additional planned..."). Stripping every non-digit character and
// concatenating what's left -- the previous approach -- doesn't stop at the
// first number; it also swallows any year or count sitting nearby ("(2013",
// "3-building"), so that one string alone parsed as $262 *trillion*. Anchor
// the match to a single "<number> million|billion" pair and take the first
// one, which is always the headline figure by convention in this dataset.
const totalCapExBillion = validProjects.reduce((sum, p) => {
  const cost = p.estimatedCost?.toLowerCase();
  if (!cost) return sum;
  const match = cost.match(/([\d.]+)\+?\s*(million|billion)/);
  if (!match) return sum;
  const val = parseFloat(match[1]);
  if (isNaN(val)) return sum;
  return sum + (match[2] === "billion" ? val : val / 1000);
}, 0);

// "Minnesota" is itself an anglicization of the Dakota "Mni Sóta Makoce" —
// roughly "land where the waters reflect the clouds" — the source of the
// state's name (see Westerman & White, "Mni Sota Makoce: The Land of the
// Dakota," MNHS Press 2012). Between actual sunrise and sunset the masthead
// crossfades to the Dakota name; outside those hours it reads "Minnesota".
// Sunrise/sunset are computed client-side (sunrise equation, good to a
// minute or two) from a fixed Minnesota reference point rather than a
// geolocation prompt or weather API call — consistent with "zero
// third-party assets" and no-tracking. No-JS visitors see English.
const DAKOTA_PLACE_NAME = "Mni Sóta Makoce";
const ENGLISH_PLACE_NAME = "Minnesota";
const MN_REFERENCE_LAT = 44.9537; // State Capitol, Saint Paul
const MN_REFERENCE_LON = -93.09;

const activeCount = countBy(clientProjects, (p) => p.status).active ?? 0;

const totalPermanentJobs = validProjects.reduce(
  (sum, p) => sum + (p.economicAsymmetry?.permanentOperationalJobsEstimate ?? 0),
  0,
);

// The four tiles, so the classes shared by all of them are written once rather
// than four times. `.stat-well` is surface + hairline + inner shadow together,
// defined in global.css because the three have to move as a unit; inside this
// header's band the light theme reads it as recessed and the dark theme as
// raised.
const STATS: Array<{
  label: string;
  value: string;
  /** De-emphasised trailing text, for a value that is a ratio. */
  muted?: string;
  /** The lead figure of the four gets the accent ink. */
  accent?: boolean;
}> = [
  { label: "Total Power", value: `${(totalMW / 1000).toFixed(2)} GW`, accent: true },
  { label: "Total Cost", value: `$${totalCapExBillion.toFixed(1)}B` },
  { label: "Active Centers", value: String(activeCount), muted: `/ ${totalCount}` },
  { label: "Permanent Tech Jobs", value: `~${totalPermanentJobs}` },
];
---

<!--
  The whole header block is one band: in the light theme the state flag's Night
  Sky Blue with white type and a Water Blue eyebrow, under which the rest of the
  sidebar is the portal's off-white; in the dark theme near-black with light
  type, i.e. what this header looked like before. One markup path, both results —
  and the tokens the masthead and the stat tiles below use are re-pointed by the
  band, so neither needs a `dark:` twin.
-->
<div class="band bg-panel w-full hidden md:flex flex-col border-b border-hair">
  <div class="w-full px-4 py-4 shrink-0 min-w-0">
    <span class="block text-sm font-semibold tracking-[0.25em] text-accent uppercase leading-none mb-2">
      Data Center Watch
    </span>
    <!--
      This sidebar is a fixed 288px (`md:w-72` on the panel in
      MapFilterParent.astro) at every width this header ever renders at — it's
      `hidden` below `md` and there's no wider breakpoint override above it, so
      there is no viewport to fluidly scale against here. text-2xl is sized
      against that fixed 256px content box (288px − px-4 both sides) for the
      longer of the two crossfading strings, "Mni Sóta Makoce": at font-black
      weight with tracking-tight it measures ~223px, leaving headroom for
      non-Apple system-font substitution before it'd wrap. text-4xl measured
      ~336px there — comfortably wider than the box, which is what was pushing
      it onto a second line. `whitespace-nowrap` is the backstop if a
      substituted font ever runs wider than that headroom.
    -->
    <h1
      id="mf-header-place-name"
      class="text-2xl font-black tracking-tight text-ink uppercase leading-none whitespace-nowrap transition-opacity duration-700 ease-in-out motion-reduce:transition-none"
      title={`${DAKOTA_PLACE_NAME} (Dakota): "land where the waters reflect the clouds," the source of the name "Minnesota"`}
    >
      {ENGLISH_PLACE_NAME}
    </h1>
  </div>

  <script
    is:inline
    define:vars={{ DAKOTA_PLACE_NAME, ENGLISH_PLACE_NAME, MN_REFERENCE_LAT, MN_REFERENCE_LON }}
  >
    (function () {
      try {
        var el = document.getElementById("mf-header-place-name");
        if (!el) return;

        // Sunrise equation (en.wikipedia.org/wiki/Sunrise_equation): returns
        // { sunrise, sunset } as Date objects for the UTC calendar day
        // containing `date`, at the given latitude/longitude.
        function sunTimes(date, lat, lon) {
          var jd = date.getTime() / 86400000 + 2440587.5;
          var n = Math.floor(jd - 2451545.0 + 0.0008);
          var Jstar = n - lon / 360;
          var M = (357.5291 + 0.98560028 * Jstar) % 360;
          if (M < 0) M += 360;
          var Mrad = (M * Math.PI) / 180;
          var C =
            1.9148 * Math.sin(Mrad) + 0.02 * Math.sin(2 * Mrad) + 0.0003 * Math.sin(3 * Mrad);
          var lambda = (M + C + 180 + 102.9372) % 360;
          if (lambda < 0) lambda += 360;
          var lambdaRad = (lambda * Math.PI) / 180;
          var Jtransit =
            2451545.0 + Jstar + 0.0053 * Math.sin(Mrad) - 0.0069 * Math.sin(2 * lambdaRad);
          var delta = Math.asin(Math.sin(lambdaRad) * Math.sin((23.4397 * Math.PI) / 180));
          var latRad = (lat * Math.PI) / 180;
          var cosOmega =
            (Math.sin((-0.833 * Math.PI) / 180) - Math.sin(latRad) * Math.sin(delta)) /
            (Math.cos(latRad) * Math.cos(delta));
          if (cosOmega > 1 || cosOmega < -1) return { sunrise: null, sunset: null };
          var omega = (Math.acos(cosOmega) * 180) / Math.PI;
          return {
            sunrise: new Date((Jtransit - omega / 360 - 2440587.5) * 86400000),
            sunset: new Date((Jtransit + omega / 360 - 2440587.5) * 86400000),
          };
        }

        var DAY_MS = 86400000;
        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function isDaytime(now) {
          var t = sunTimes(now, MN_REFERENCE_LAT, MN_REFERENCE_LON);
          if (!t.sunrise || !t.sunset) return true; // polar edge case: not reachable at MN's latitude
          return now >= t.sunrise && now < t.sunset;
        }

        function nextBoundary(now) {
          var t = sunTimes(now, MN_REFERENCE_LAT, MN_REFERENCE_LON);
          if (t.sunrise && now < t.sunrise) return t.sunrise;
          if (t.sunset && now < t.sunset) return t.sunset;
          var tomorrow = sunTimes(new Date(now.getTime() + DAY_MS), MN_REFERENCE_LAT, MN_REFERENCE_LON);
          return tomorrow.sunrise || new Date(now.getTime() + DAY_MS);
        }

        function render(day) {
          el.textContent = day ? DAKOTA_PLACE_NAME : ENGLISH_PLACE_NAME;
          el.lang = day ? "dak" : "en";
        }

        function scheduleNext() {
          var now = new Date();
          var delay = Math.max(nextBoundary(now).getTime() - now.getTime(), 1000);
          window.setTimeout(function () {
            var day = isDaytime(new Date());
            if (reduceMotion) {
              render(day);
            } else {
              el.style.opacity = "0";
              window.setTimeout(function () {
                render(day);
                el.style.opacity = "1";
              }, 700);
            }
            scheduleNext();
          }, delay);
        }

        render(isDaytime(new Date()));
        scheduleNext();
      } catch (e) {}
    })();
  </script>

  <div class="grid grid-cols-2 gap-3 px-4 pb-4">
    {
      STATS.map((stat) => (
        <div class="p-3 rounded-lg stat-well flex flex-col justify-center gap-1 min-w-0">
          <span class="text-[10px] font-medium text-ink-3 uppercase tracking-wider leading-tight">
            {stat.label}
          </span>
          <span
            class:list={[
              "text-xl md:text-2xl font-bold tracking-tight tabular-nums",
              stat.accent ? "text-accent" : "text-ink",
            ]}
          >
            {stat.value}
            {stat.muted && <span class="text-ink-4"> {stat.muted}</span>}
          </span>
        </div>
      ))
    }
  </div>
</div>