---
import type { STATUS_META } from '~/data/mapStatusMeta';
import type { ProjectStatus } from '~/data/dataCenters';

interface Props {
  statusMeta: typeof STATUS_META;
  countsByStatus: Record<ProjectStatus, number>;
  statusIcons: Record<ProjectStatus, any>;
}

const { statusMeta, countsByStatus, statusIcons } = Astro.props;
---

<div id="mf-compact" class="hidden flex-row md:flex-col items-center gap-1.5 px-3 py-3 md:px-0 md:py-4 md:flex-1 md:overflow-y-auto">
  {statusMeta.map((meta) => {
    const Icon = statusIcons[meta.status];
    return (
      <button
        type="button"
        class="mf-dot relative flex items-center justify-center w-8 h-8 rounded-full hover:bg-white/10 transition shrink-0"
        data-status={meta.status}
        aria-label={`Toggle ${meta.filterLabel}`}
        title={`${meta.filterLabel} (${countsByStatus[meta.status as ProjectStatus]})`}
      >
        {meta.activePulse && (
          <span class="absolute inline-flex h-6 w-6 rounded-full opacity-60 animate-ping" style={`background-color: ${meta.hex}`} />
        )}
        <span class="relative flex items-center justify-center w-6 h-6 rounded-full" style={`background-color: ${meta.hex}26; color: ${meta.hex};`}>
          <Icon size={13} stroke-width={2.25} />
        </span>
      </button>
    );
  })}
</div>