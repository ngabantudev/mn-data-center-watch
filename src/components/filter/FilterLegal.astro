---
// src/components/filter/FilterLegal.astro
//
// Isolate toggle + legend for the environmental-review / legal-hold axis.
// The toggle itself carries the `mf-legal-hold-only` id that
// MapFilterParent's single dispatcher reads — this component stays
// presentational so there's exactly one place building FilterCriteria.
import AccordionSection from "~/components/ui/AccordionSection.astro";
import { Scale } from "lucide-astro";
import type { LegalStatus } from "~/data/dataCenters";
import { LEGAL_STATUS_META } from "~/data/legalStatusMeta";

interface Props {
  countsByLegalStatus: Partial<Record<LegalStatus, number>>;
  holdCount: number;
}

const { countsByLegalStatus, holdCount } = Astro.props;
const holdMeta = LEGAL_STATUS_META.filter((m) => m.isHold);
---

<AccordionSection title="Environmental Review & Legal Hold">
  <div
    class="px-3.5 md:px-4 py-3 bg-panel-3 border-t border-b border-hair"
  >
    <label
      class="flex items-center gap-3 cursor-pointer group rounded-lg px-2 py-2 transition-colors hover:bg-hover"
    >
      <input
        id="mf-legal-hold-only"
        type="checkbox"
        class="w-3.5 h-3.5 rounded border-hair-strong bg-panel-2 accent-yellow-700 dark:accent-amber-400 shrink-0 cursor-pointer"
      />
      <!-- The legal-hold signal colour shared with the map's hold ring, so it
           stays fixed rather than becoming a theme token. The two themes put it
           on opposite surfaces: amber-400 on the dark panel, and on the light
           theme's off-white a mid-tone gold — yellow-700, the same register
           legalStatusMeta.ts settled on (#a16207) for the same reason on the
           light basemap. A bright amber measures 1.4:1 on this strip. -->
      <span
        class="text-yellow-700 group-hover:text-yellow-800 dark:text-amber-500 dark:group-hover:text-amber-400 transition-colors"
      >
        <Scale size={16} stroke-width={2} />
      </span>
      <span
        class="text-xs font-semibold text-ink-2 group-hover:text-ink transition-colors flex-1 min-w-0"
      >
        Under Review / Legal Hold only
      </span>
      <span
        class="text-[10px] font-bold text-ink-4 group-hover:text-ink-2 font-mono tabular-nums shrink-0"
      >
        {holdCount}
      </span>
    </label>

    <p class="px-2 pt-1 text-[10px] leading-snug text-ink-4">
      Sites tied up in state environmental review (EAW/EIS) or active
      litigation. These are where legal support and statewide precedent move
      fastest.
    </p>
  </div>

  <div class="flex flex-col gap-0.5 p-1.5 pb-3">
    {
      holdMeta.map((meta) => (
        <div class="flex items-center gap-2.5 rounded-lg px-2 py-1.5">
          <span
            class="w-2.5 h-2.5 rounded-full shrink-0 ring-2"
            style={`background-color: ${meta.hex}; --tw-ring-color: ${meta.hex}40`}
          />
          <span class="flex-1 min-w-0">
            <span class="block text-[11px] font-semibold text-ink leading-none truncate">
              {meta.label}
            </span>
            <span class="block text-[9px] text-ink-4 leading-tight mt-0.5 truncate">
              {meta.description}
            </span>
          </span>
          <span class="text-[10px] font-bold text-ink-4 font-mono tabular-nums shrink-0">
            {countsByLegalStatus[meta.legalStatus] ?? 0}
          </span>
        </div>
      ))
    }
  </div>
</AccordionSection>
