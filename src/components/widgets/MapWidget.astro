---
// src/components/widgets/MapWidget.astro
import { clientProjects } from '~/data/projects';
---

<section class="relative w-screen h-screen overflow-hidden bg-[#f4f4f5]">
  <div class="absolute top-4 left-4 z-10 bg-white/90 backdrop-blur-sm border border-neutral-200 shadow-lg rounded-xl p-2 flex flex-col gap-1.5 pointer-events-auto">
    <label for="map-style-select" class="text-[10px] font-bold text-neutral-400 uppercase tracking-wider px-1">Map Theme</label>
    <select 
      id="map-style-select" 
      class="bg-neutral-50 text-xs font-semibold text-neutral-800 border border-neutral-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer min-w-32.5"
    >
      <option value="https://tiles.openfreemap.org/styles/fiord">Fiord (Muted)</option>
      <option value="https://tiles.openfreemap.org/styles/liberty">Liberty (Google Maps)</option>
      <option value="https://tiles.openfreemap.org/styles/positron">Light Minimal</option>
      <option value="https://tiles.openfreemap.org/styles/dark" selected>Dark Mode</option>
    </select>
  </div>

  <div class="relative w-screen h-screen">
    <div id="map" class="absolute inset-0 w-full h-full bg-[#f4f4f5]"></div>
  </div>
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css'; 
  import { clientProjects } from '~/data/projects';

  const TWIN_CITIES_CENTER: [number, number] = [-93.1900, 44.9650]; 
  const DEFAULT_ZOOM = 9;

  function getColorClass(score: number): string {
    if (score >= 90) return 'border-emerald-500 text-emerald-600 bg-emerald-50/30';
    if (score >= 50) return 'border-amber-500 text-amber-600 bg-amber-50/30';
    return 'border-rose-500 text-rose-600 bg-rose-50/30';
  }

  function updateSingleBadge(popupId: string, type: string, scoreVal: any): void {
    if (typeof scoreVal !== 'number') return;
    const finalValue = Math.round(scoreVal * 100);
    const element = document.getElementById(`${popupId}-${type}`);
    if (element) {
      element.textContent = `${finalValue}`;
      element.className = `w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-500 ${getColorClass(finalValue)}`;
    }
  }

  async function fetchLiveLighthouseScores(targetUrl: string, popupId: string): Promise<void> {
    try {
      const apiUrl = `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(targetUrl)}&category=PERFORMANCE&category=ACCESSIBILITY&category=BEST_PRACTICES&category=SEO`;
      const response = await fetch(apiUrl);
      if (!response.ok) return;

      const data = await response.json();
      const categories = data?.lighthouseResult?.categories;

      updateSingleBadge(popupId, 'perf', categories?.performance?.score);
      updateSingleBadge(popupId, 'acc', categories?.accessibility?.score);
      updateSingleBadge(popupId, 'bp', categories?.['best-practices']?.score);
      updateSingleBadge(popupId, 'seo', categories?.seo?.score);
    } catch (e) {
      console.warn("Live audit postponed or throttled by network configuration.", e);
    }
  }

  function initMap(): void {
    const mapElement = document.getElementById('map');
    const styleSelector = document.getElementById('map-style-select') as HTMLSelectElement | null;
    if (!mapElement) return;

    const initialStyle = styleSelector?.value || 'https://tiles.openfreemap.org/styles/dark';

    const map = new maplibregl.Map({
      container: 'map',
      style: initialStyle, 
      center: TWIN_CITIES_CENTER,
      zoom: DEFAULT_ZOOM,
      scrollZoom: true,
      attributionControl: false
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    
    map.on('load', () => {
      setTimeout(() => map.resize(), 100);
    });

    if (styleSelector) {
      styleSelector.addEventListener('change', (event) => {
        const targetStyle = (event.target as HTMLSelectElement).value;
        map.setStyle(targetStyle);
      });
    }

    if (Array.isArray(clientProjects)) {
      clientProjects.forEach((project, index) => {
        if (!project.coordinates) return;
        const coords: [number, number] = [project.coordinates[1], project.coordinates[0]];
        const popupId = `lh-${index}`;
        
        let closeTimer: number | null = null;

        const popup = new maplibregl.Popup({ 
          offset: 15,
          closeButton: false,
          maxWidth: '320px'
        }).setHTML(`
          <div id="container-${popupId}" class="p-1 text-neutral-900 font-sans">
            <h3 class="font-bold text-base text-neutral-900 border-b border-neutral-200 pb-1 mb-1">${project.name}</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mb-4">${project.description}</p>
            
            <div class="flex items-center justify-between gap-2 mb-4 px-1">
              <div class="flex flex-col items-center gap-1">
                <div id="${popupId}-perf" class="w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300 ${getColorClass(project.fallbacks.performance)}">
                  ${project.fallbacks.performance}
                </div>
                <span class="text-[9px] font-bold text-neutral-500 tracking-tight uppercase">Perf</span>
              </div>

              <div class="flex flex-col items-center gap-1">
                <div id="${popupId}-acc" class="w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300 ${getColorClass(project.fallbacks.accessibility)}">
                  ${project.fallbacks.accessibility}
                </div>
                <span class="text-[9px] font-bold text-neutral-500 tracking-tight uppercase">Access</span>
              </div>

              <div class="flex flex-col items-center gap-1">
                <div id="${popupId}-bp" class="w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300 ${getColorClass(project.fallbacks.bestPractices)}">
                  ${project.fallbacks.bestPractices}
                </div>
                <span class="text-[9px] font-bold text-neutral-500 tracking-tight uppercase">Best Pr.</span>
              </div>

              <div class="flex flex-col items-center gap-1">
                <div id="${popupId}-seo" class="w-11 h-11 rounded-full border-2 flex items-center justify-center text-xs font-bold transition-all duration-300 ${getColorClass(project.fallbacks.seo)}">
                  ${project.fallbacks.seo}
                </div>
                <span class="text-[9px] font-bold text-neutral-500 tracking-tight uppercase">SEO</span>
              </div>
            </div>

            <div class="bg-neutral-50 border border-neutral-200/60 p-2.5 rounded-lg mb-4">
              <span class="block text-[10px] text-neutral-400 font-bold uppercase tracking-wider mb-0.5">Engineering Highlight</span>
              <p class="text-xs text-neutral-700 leading-normal font-medium">${project.businessImpact}</p>
            </div>

            <a href="${project.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full text-center text-xs bg-neutral-900 text-white py-2.5 px-3 rounded-lg hover:bg-neutral-800 transition font-medium tracking-wide shadow-sm pointer-events-auto">
              View Website &rarr;
            </a>
          </div>
        `);

        popup.on('open', () => {
          const popupNode = popup.getElement();
          if (popupNode) {
            popupNode.addEventListener('mouseenter', () => {
              if (closeTimer) {
                clearTimeout(closeTimer);
                closeTimer = null;
              }
            });

            popupNode.addEventListener('mouseleave', () => {
              closeTimer = window.setTimeout(() => {
                popup.remove();
              }, 300);
            });
          }
        });

        const marker = new maplibregl.Marker({ color: '#10b981' })
          .setLngLat(coords)
          .addTo(map);

        const markerEl = marker.getElement();

        markerEl.addEventListener('mouseenter', () => {
          if (closeTimer) {
            clearTimeout(closeTimer);
            closeTimer = null;
          }
          
          if (!popup.isOpen()) {
            popup.setLngLat(coords).addTo(map);
            fetchLiveLighthouseScores(project.url, popupId);
          }
        });

        markerEl.addEventListener('mouseleave', () => {
          closeTimer = window.setTimeout(() => {
            popup.remove();
          }, 300);
        });
      });
    }
  }

  document.addEventListener('astro:page-load', initMap);
  if (document.readyState !== 'loading') {
    initMap();
  } else {
    document.addEventListener('DOMContentLoaded', initMap);
  }
</script>