---
// src/components/grid/CleanGridTracker.astro
//
// Minnesota's 100%-carbon-free-by-2040 mandate, tracked against the last
// published figure for where the state actually is — and against the load the
// data centers on this map would add to the grid that has to get there.
//
// WHY IT IS A MODAL AND NOT A RAIL SECTION ANY MORE
//
// It was an AccordionSection in the filters rail, and it was invisible there:
// every section of that rail ships closed, so the mandate rendered as a 10px
// grey label among five filter sections that looked exactly like it. The fix
// was a banner over the map (CleanGridBar.astro), and once the banner carried
// the headline and the meter, a rail section holding the remainder was a third
// place to look for one subject.
//
// So the rail section is gone and this is what the banner opens. Which raises
// the obvious question — why keep any of it, rather than letting the banner be
// the whole widget?
//
// BECAUSE THE BANNER CANNOT QUALIFY WHAT IT SAYS. It has room for a share, a
// countdown and one conditional. It has no room for: the 2030 milestone having
// two statutory tracks (80% investor-owned, 60% municipal and co-op — quoting
// only the 80% is the commonest error in coverage of this law); the 55% being
// *generation* mix rather than a compliance score, which is a different
// denominator entirely; Xcel's figure being four years old and its later
// numbers being emissions reductions rather than carbon-free shares; the
// § 216B.1691 subd. 2b off-ramp, which is the actual risk to 2040 and the
// reason a data center watchdog tracks this at all; or the five sources every
// number here comes from.
//
// A civic site that renders the figures and drops the provenance is worth less
// than one that renders neither. This is where the provenance lives.
//
// TWO AXES, AND WHY THE METER ONLY PLOTS ONE
//
// The obvious build is a bar that runs "today → 2040" with the milestones as
// waypoints along it. That bar cannot show a shortfall: time advances whether
// or not the grid decarbonises, so a time-axis fill would sit at ~30% in 2030
// and read as *progress* in a year the state might have missed its first
// statutory target. The axis is therefore carbon-free share, 0–100%, with the
// milestones plotted at the percentages the law requires. Time is carried by
// the countdown, where it can't be mistaken for achievement. The meter itself
// now lives on the banner; this note stays because the rule governs both.
//
// See ~/data/mnCleanGridStandard.ts before touching any number in here: the
// 2030 milestone has two different statutory tracks, and the widely-quoted
// Xcel "80% by 2030" is an emissions reduction against 2005 rather than a
// carbon-free share, so it is not plottable on this axis at all.
import { AlertTriangle, ExternalLink, X, Zap } from "lucide-astro";
import {
  CARBON_FREE_DEADLINE_YEAR,
  CARBON_FREE_MILESTONES,
  CARBON_FREE_OFF_RAMP,
  CARBON_FREE_STATUTE,
  MN_CARBON_FREE_SHARE,
  MN_RENEWABLE_SHARE_2025,
  RENEWABLE_STANDARD_2035,
  XCEL_CONTRACTED_QUEUE_GW,
  XCEL_UPPER_MIDWEST_CARBON_FREE,
} from "~/data/mnCleanGridStandard";
import { cleanGridProgress, dataCenterLoadPressure } from "~/lib/cleanGridProgress";

// Build-time year. The page is prerendered, so this is the year of the last
// deploy rather than the reader's — the script at the bottom re-runs the same
// function against their clock and rewrites the slots it affects. Rendering it
// server-side anyway keeps the countdown correct without JS and stops the tile
// from being blank on first paint.
const buildYear = new Date().getFullYear();
const progress = cleanGridProgress(buildYear);
const pressure = dataCenterLoadPressure();

const pct = (fraction: number) => `${Math.round(fraction * 100)}%`;

// The share-of-state-load figure runs from a fraction of a percent to double
// digits across plausible datasets, so it needs a precision that survives both
// ends rather than a fixed one.
const sharePct = (fraction: number) => {
  const value = fraction * 100;
  if (value >= 10) return `${value.toFixed(0)}%`;
  if (value >= 1) return `${value.toFixed(1)}%`;
  return `${value.toFixed(2)}%`;
};

const currentPct = Math.round(MN_CARBON_FREE_SHARE.share * 100);

// Ticks are drawn for every distinct required percentage, not for every
// milestone: 2030 contributes two (80 investor-owned, 60 co-op/municipal) and
// 2040's 100 sits on the track's end cap. Deduped so the two converged tracks
// in 2035 and 2040 don't stack two lines in one place.
const tickPercents = [
  ...new Set(
    CARBON_FREE_MILESTONES.flatMap((m) => [
      Math.round(m.publicUtility * 100),
      Math.round(m.otherUtility * 100),
    ]),
  ),
].sort((a, b) => a - b);
---

<!--
  Same `<dialog>` treatment CampaignBanner's take-action panel uses, and for the
  same reasons: the top layer, focus trapping, Esc-to-close and an inert
  background, none of which is worth reimplementing.

  Centring is spelled out rather than inherited — the UA centres a modal with
  `margin: auto`, and Tailwind's preflight zeroes margin on every element,
  dialog included. Height is capped in dvh with the body scrolling inside, so a
  short or keyboard-shrunk viewport keeps the header and close button reachable.
  `open:flex`, not `flex`: an author `display:flex` outranks the UA's
  `dialog:not([open]) { display: none }` and would leave this on screen forever.
-->
<dialog
  id="cg-dialog"
  aria-labelledby="cg-dialog-title"
  class="font-sans fixed inset-0 m-auto open:flex h-fit max-h-[92dvh] w-[min(30rem,92vw)] flex-col overflow-hidden rounded-2xl border border-hair bg-panel p-0 text-ink backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div
    class="band bg-panel shrink-0 flex items-start justify-between gap-3 px-4 py-3.5 border-b border-hair"
  >
    <div class="min-w-0">
      <h2 id="cg-dialog-title" class="text-sm font-bold text-ink leading-tight">
        MN 2040 Clean Grid Tracker
      </h2>
      <p class="mt-1 text-[11px] text-ink-3 leading-snug">
        Minnesota's statutory 100% carbon-free electricity mandate, against the
        real-world load data centers are asking the same grid to carry.
      </p>
    </div>
    <button
      id="cg-dialog-close"
      type="button"
      aria-label="Close"
      class="shrink-0 rounded-lg p-1 text-ink-4 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
    >
      <X size={16} />
    </button>
  </div>

  <!-- No `data-cg-root` here any more. It scoped this component's own year
       correction to its own subtree, back when that correction lived in this
       file; ~/lib/cleanGridClient.ts queries the document instead, precisely so
       the banner and this record cannot disagree about the countdown. The
       attribute survived the move as a hook nothing reads. -->
  <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-4">
    <!--
      The meter is deliberately NOT here any more — it is the banner over the
      map (CleanGridBar.astro), which is where a reader meets this widget now.
      Repeating it at the top of its own record would be two renderings of one
      number a click apart, which is the drift this codebase keeps designing
      against. What stays is everything the banner has no room to qualify: the
      two 2030 tracks, the vintage of the 55%, the off-ramp, and the sources.
    -->

    <!--
      The milestones as a list, which is also the accessible rendering of the
      ticks above. Each row states the year, what is required, and how far the
      last published figure is from it — so the shortfall is text, not a
      distance a reader has to eyeball on a 288px track.
    -->
    <ul class="flex flex-col gap-px" data-cg="milestones">
      {
        CARBON_FREE_MILESTONES.map((m) => {
          const gap = Math.round((m.publicUtility - MN_CARBON_FREE_SHARE.share) * 100);
          const isNext = progress.next?.year === m.year;
          return (
            <li
              class="flex flex-col gap-0.5 rounded-md px-2 py-1.5 border border-transparent data-next:border-hair-strong data-next:bg-hover"
              data-cg-milestone={m.year}
              data-next={isNext ? "" : undefined}
            >
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-[11px] font-bold text-ink tabular-nums">
                  {m.year}
                </span>
                <span class="text-[11px] font-semibold text-ink-2 tabular-nums">
                  {m.split
                    ? `${pct(m.publicUtility)} / ${pct(m.otherUtility)}`
                    : pct(m.publicUtility)}
                </span>
              </div>
              <span class="text-[10px] text-ink-4 leading-snug">{m.note}</span>
              <span class="text-[10px] text-ink-3 leading-snug tabular-nums">
                {gap > 0
                  ? `${gap} points above where the state stands today.`
                  : "Already met by the statewide generation mix."}
              </span>
            </li>
          );
        })
      }
    </ul>

    <!-- Stats grid. `.stat-well` is the same recessed treatment the header's
         totals use, so these read as the same class of readout. -->
    <div class="grid grid-cols-2 gap-2">
      <div class="stat-well rounded-lg p-2.5 flex flex-col gap-1 min-w-0">
        <span
          class="text-[9px] font-medium text-ink-3 uppercase tracking-wider leading-tight"
        >
          Years Remaining
        </span>
        <span
          class="text-xl font-bold text-ink tabular-nums leading-none"
          data-cg="years-left">{progress.yearsLeft}</span
        >
        <span class="text-[9px] text-ink-4 leading-tight" data-cg="deadline-note">
          to {CARBON_FREE_DEADLINE_YEAR}
        </span>
      </div>

      <div class="stat-well rounded-lg p-2.5 flex flex-col gap-1 min-w-0">
        <span
          class="text-[9px] font-medium text-ink-3 uppercase tracking-wider leading-tight"
        >
          Renewable Share
        </span>
        <span class="text-xl font-bold text-ink tabular-nums leading-none">
          {pct(MN_RENEWABLE_SHARE_2025)}
        </span>
        <span class="text-[9px] text-ink-4 leading-tight">
          of {pct(MN_CARBON_FREE_SHARE.share)} carbon-free; rest is nuclear
        </span>
      </div>
    </div>

    <!--
      THE RISK CARD.

      Colour is doing no work here, deliberately. The obvious treatment is an
      amber warning panel, but this palette's amber measures ~2.1:1 on the light
      theme's off-white body — under AA for text and under 3:1 even for an icon
      carrying meaning. So the emphasis is the recessed well, the rule, and the
      wording; the figures stay on the contrast-checked ink ramp.
    -->
    <div class="stat-well rounded-lg p-3 flex flex-col gap-2">
      <div class="flex items-center gap-1.5">
        <AlertTriangle size={13} class="text-ink-2 shrink-0" aria-hidden="true" />
        <span
          class="text-[9px] font-bold text-ink uppercase tracking-wider leading-none"
        >
          The Risk Factor
        </span>
      </div>

      <!-- Stated as a conditional, not a current draw. Most of this capacity is
           proposed rather than energised, and a flat "the buildout uses 45% of
           the state's power" would be false today — which is the one sentence
           an opponent would need to discredit the rest of the panel. -->
      <p class="text-[11px] text-ink-2 leading-snug">
        If every non-rejected site on this map were built and running at {
          pct(pressure.loadFactor)
        } utilisation, the <span class="font-semibold tabular-nums"
          >{pressure.totalGW.toFixed(2)} GW</span
        > tracked here would draw about{" "}<span class="font-semibold tabular-nums"
          >{sharePct(pressure.shareOfStateLoad)}</span
        > of Minnesota's entire annual retail electricity sales.
      </p>

      <p class="text-[11px] text-ink-2 leading-snug">
        Xcel alone reports more than {XCEL_CONTRACTED_QUEUE_GW.nowGW} GW of data
        center capacity already under contract, and expects {
          XCEL_CONTRACTED_QUEUE_GW.byYearGW
        } GW in queue by {XCEL_CONTRACTED_QUEUE_GW.byYear}.
      </p>

      <p class="text-[11px] text-ink-3 leading-snug border-t border-hair pt-2">
        <span class="font-semibold text-ink-2">Why that bears on 2040:</span> the
        deadline is not self-executing. Under {CARBON_FREE_OFF_RAMP.citation} the
        PUC may delay or modify a utility's compliance on cost, reliability or
        feasibility grounds. New load of this scale is the argument that
        off-ramp gets made with.
      </p>
    </div>

    <!--
      Sources and method. A native `<details>`, not another `.mf-accordion-*`
      section: the rail's accordion script is *exclusive*, so a second section
      opening here would close the tracker that contains it. `<details>` also
      keeps this working with no JS at all, which the sources block of a
      public-records widget is the last thing that should depend on.
    -->
    <details class="group border-t border-hair pt-2">
      <summary
        class="flex items-center justify-between gap-2 cursor-pointer list-none text-[10px] font-bold text-ink-3 hover:text-ink uppercase tracking-wider focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 rounded"
      >
        Sources &amp; Methodology
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="text-ink-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
        >
          <path
            d="M6 9l6 6 6-6"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </summary>

      <div class="flex flex-col gap-2.5 pt-2.5 text-[10px] text-ink-3 leading-snug">
        <p>
          <span class="font-semibold text-ink-2">The mandate.</span>{" "}
          {CARBON_FREE_STATUTE.citation}, enacted by {
            CARBON_FREE_STATUTE.actLabel
          }. The 2030 milestone has two tracks — {
            pct(CARBON_FREE_MILESTONES[0].publicUtility)
          } for investor-owned utilities, {
            pct(CARBON_FREE_MILESTONES[0].otherUtility)
          } for municipals and co-ops. A separate renewable standard requires {
            pct(RENEWABLE_STANDARD_2035)
          } renewable by 2035; nuclear counts as carbon-free but not as
          renewable, which is why the two are tracked apart.
        </p>

        <p>
          <span class="font-semibold text-ink-2">The {currentPct}%.</span>{" "}
          {MN_CARBON_FREE_SHARE.sourceLabel}, covering {
            MN_CARBON_FREE_SHARE.dataYear
          }. This is the share of electricity <em>generated in</em> Minnesota. The
          statute is enforced per utility against <em>retail sales</em> to that
          utility's own Minnesota customers, and the state sits inside MISO, so
          this is an indicator of the state's trajectory rather than a
          compliance score. No statewide compliance figure is published, because
          compliance is not a statewide quantity.
        </p>

        <p>
          <span class="font-semibold text-ink-2">Largest utility.</span> Xcel put
          its Upper Midwest system at {
            pct(XCEL_UPPER_MIDWEST_CARBON_FREE.share)
          } carbon-free in {XCEL_UPPER_MIDWEST_CARBON_FREE.asOfYear} and has not
          published an updated share since; its figures since are emissions
          reductions against a 2005 baseline, which is a different measure and is
          not plotted here. That system also covers parts of the Dakotas,
          Wisconsin and Michigan, so it is not a Minnesota-only figure.
        </p>

        <p>
          <span class="font-semibold text-ink-2">Data center load.</span>{" "}
          Nameplate capacity of the {pressure.projectCount} non-rejected sites in
          this map's dataset, at {pct(pressure.loadFactor)} utilisation, against
          Minnesota's total annual retail sales. It measures how much electricity
          the buildout wants — not how that electricity is generated, which is
          the open question, not a settled one.
        </p>

        <ul class="flex flex-col gap-1.5 pt-0.5">
          {
            [
              { label: CARBON_FREE_STATUTE.citation, url: CARBON_FREE_STATUTE.url },
              { label: CARBON_FREE_STATUTE.actLabel, url: CARBON_FREE_STATUTE.actUrl },
              {
                label: MN_CARBON_FREE_SHARE.sourceLabel,
                url: MN_CARBON_FREE_SHARE.sourceUrl,
              },
              {
                label: XCEL_UPPER_MIDWEST_CARBON_FREE.sourceLabel,
                url: XCEL_UPPER_MIDWEST_CARBON_FREE.sourceUrl,
              },
              {
                label: XCEL_CONTRACTED_QUEUE_GW.sourceLabel,
                url: XCEL_CONTRACTED_QUEUE_GW.sourceUrl,
              },
            ].map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-start gap-1 text-accent hover:text-accent-hover hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 rounded"
                >
                  <span class="min-w-0">{source.label}</span>
                  <ExternalLink size={9} class="shrink-0 mt-0.5" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <p class="flex items-start gap-1.5 text-[10px] text-ink-4 leading-snug">
      <Zap size={11} class="shrink-0 mt-0.5" aria-hidden="true" />
      <span>
        Figures are the most recent published; there is no live feed for the
        statewide mix. Corrections welcome — this is a public record, not an
        estimate.
      </span>
    </p>
  </div>
</dialog>

<script>
  import { onReady } from "~/lib/domReady";
  // The countdown correction lives in ~/lib/cleanGridClient.ts. It rewrites only
  // the `data-cg` slots the reader's year affects — the markup above stays the
  // server's, the same way ratepayerWidget.ts hydrates by slot rather than
  // re-templating — and it is document-wide, so this record and the banner
  // cannot show two different numbers of years remaining.
  import {
    OPEN_CLEAN_GRID_EVENT,
    syncCleanGridYear,
  } from "~/lib/cleanGridClient";

  let trackerCleanups: (() => void)[] = [];

  function initCleanGridDialog(): void {
    const dialog = document.getElementById(
      "cg-dialog",
    ) as HTMLDialogElement | null;
    if (!dialog) return;

    while (trackerCleanups.length > 0) {
      trackerCleanups.pop()?.();
    }

    syncCleanGridYear();

    // The banner asks; this answers. One direction, one event — see the note in
    // ~/lib/cleanGridClient.ts for why the banner cannot open this itself.
    const onOpen = () => {
      if (!dialog.open) dialog.showModal();
    };
    document.addEventListener(OPEN_CLEAN_GRID_EVENT, onOpen);
    trackerCleanups.push(() =>
      document.removeEventListener(OPEN_CLEAN_GRID_EVENT, onOpen),
    );

    const closeBtn = document.getElementById("cg-dialog-close");
    const onCloseClick = () => dialog.close();
    closeBtn?.addEventListener("click", onCloseClick);
    trackerCleanups.push(() =>
      closeBtn?.removeEventListener("click", onCloseClick),
    );

    // Click-outside-to-close. The ::backdrop registers as a click on the dialog
    // element itself, so compare against the content box — the same test
    // CampaignBanner's modal uses.
    const onDialogClick = (event: MouseEvent) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    };
    dialog.addEventListener("click", onDialogClick);
    trackerCleanups.push(() =>
      dialog.removeEventListener("click", onDialogClick),
    );
  }

  onReady(initCleanGridDialog);
</script>
