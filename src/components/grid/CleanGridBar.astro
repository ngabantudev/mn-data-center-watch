---
// src/components/grid/CleanGridBar.astro
//
// The 2040 mandate as a headline, at the top of the map.
//
// WHY A SECOND SURFACE FOR SOMETHING THE RAIL ALREADY HAS
//
// CleanGridTracker.astro renders the whole readout — the meter, the milestone
// list with both 2030 tracks, the risk card, the sources — as a section of the
// filters rail. That is still where it lives. But every section of that rail
// ships closed, so the mandate this whole map argues against was a 10px grey
// accordion label reading "2040 CLEAN GRID TRACKER", styled to recede, sitting
// among five filter sections that look exactly like it. It was present and
// invisible.
//
// This bar is the headline for it: three facts, in the masthead's own voice,
// visible without a click. It is not a duplicate readout — it deliberately
// carries no meter, no milestones and no sources, because a reader who wants
// those should land in the section that has room to qualify them properly.
// Clicking the bar is what takes them there.
//
// WHAT IT IS ALLOWED TO SAY, which is the part to be careful about.
//
// The buildout figure is a CONDITIONAL and has to read as one at a glance.
// Most of the capacity on this map is proposed rather than energised, so a flat
// "data centers use 45% of Minnesota's power" would be false today — and it is
// the single sentence an opponent would need to discredit everything else here.
// CleanGridTracker states it as "If every non-rejected site on this map were
// built and running at 80% utilisation…"; this bar has one line for the same
// claim, so the "if all are built" clause leads it and is not abbreviated away.
//
// It is also a LOAD figure and nothing more. It says how much electricity the
// buildout wants. It does not say that electricity is fossil-fired — whether
// new load is served cleanly is precisely what is contested, and asserting the
// answer in a bar over the map would concede the argument the map exists to
// have.
//
// DESKTOP ONLY, like the campaign pill it stacks with. On a phone the top of
// the screen is map, the toolbar owns the bottom, and a third permanent surface
// is what the single-sheet refactor removed. The tracker is still one tap away
// in the Filters sheet.
import { ChevronRight } from "lucide-astro";
import { MN_CARBON_FREE_SHARE } from "~/data/mnCleanGridStandard";
import {
  cleanGridProgress,
  dataCenterLoadPressure,
} from "~/lib/cleanGridProgress";

// Build-time year, corrected on the client by ~/lib/cleanGridClient.ts — see the
// `data-cg="years-phrase"` slot below. Rendered server-side anyway so the bar
// is not blank on first paint and is correct with no JS at all.
const progress = cleanGridProgress(new Date().getFullYear());
const pressure = dataCenterLoadPressure();

const sharePct = Math.round(MN_CARBON_FREE_SHARE.share * 100);

// Same precision rule the tracker's own readout uses: this figure runs from a
// fraction of a percent to double digits across plausible datasets, so a fixed
// precision is wrong at one end or the other.
const drawPct = (() => {
  const value = pressure.shareOfStateLoad * 100;
  if (value >= 10) return `${value.toFixed(0)}%`;
  if (value >= 1) return `${value.toFixed(1)}%`;
  return `${value.toFixed(2)}%`;
})();

const yearsPhrase =
  progress.yearsLeft > 0
    ? `${progress.yearsLeft} ${progress.yearsLeft === 1 ? "yr" : "yrs"} to 2040`
    : "2040 mandate due";
---

<!--
  `band` for the same reason CampaignBanner opts into it: this sits over the map
  in the flag's Night Sky Blue in the light theme, and near-black in the dark
  one, so the two floating surfaces at the top of the screen read as one piece
  of chrome.

  THE TYPOGRAPHY IS THE MASTHEAD'S, deliberately and at its scale. FilterHeader
  sets "DATA CENTER WATCH" as `text-sm font-semibold tracking-[0.25em] uppercase`
  over "MINNESOTA" at `text-4xl font-black tracking-tight uppercase`, and the
  urgency in that pairing is the size jump between the two lines, not either one
  on its own. A 9px eyebrow over a 20px figure — which is what this was — reads
  as a status chip. Matched to the masthead it reads as a headline, which is
  what a statutory deadline the whole map argues against should be.

  THE GREEN IS mn.gov's OWN, #78be21, verified in the portal's core.css where it
  appears fifteen times. It is used there exactly as it is used here — as type
  on the navy, not as a fill:

    button.search-toggle          { color: #78be21; background: 0 }
    #jumbo-search-form button     { background: rgba(0,56,101,0.8); color: #78be21 }
    .button-brand-secondary:hover { background: #86d425 }

  so #86d425 is the portal's own hover for it and is what this uses too.

  Written as literal arbitrary values rather than as a theme token, which is the
  rule global.css states: a colour that encodes identity rather than chrome must
  stay stable across themes, so it does not get a `--color-*` token that `.dark`
  could re-point. Same treatment billStageMeta.ts gives its stage hexes, and for
  the same reason — Tailwind only emits classes it can find as literal text.

  MEASURED on both surfaces this band resolves to, since the light and dark
  themes put it on different grounds:

    #78be21 on #002d5d (light band, the flag's Night Sky Blue)  5.99:1
    #78be21 on #09090b (dark band)                              8.71:1
    #86d425 on #002d5d (hover)                                  7.47:1
    #86d425 on #09090b (hover)                                 10.85:1

  All clear of 4.5:1 for text at any size. For reference the portal's own navy
  is #003865, where this green measures 5.24:1 — the flag blue we use is very
  slightly kinder to it.

  `hidden md:block`: see the note on desktop-only above.
-->
<button
  id="cg-bar"
  type="button"
  aria-label="Minnesota 2040 clean grid mandate — open the full tracker"
  class="band group hidden md:block w-full text-left rounded-xl bg-panel/95 backdrop-blur-md border border-hair shadow-2xl shadow-(color:--shadow-panel) px-3.5 py-2 pointer-events-auto font-sans hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
>
  <!-- The eyebrow, at the masthead's own size and tracking. Not truncated: at
       the 13rem clamp floor it wraps to two lines, which is legible, where
       clipping "MN 2040 CLEAN GR…" is not. -->
  <span class="flex items-start gap-2">
    <span
      class="text-xs xl:text-sm font-semibold uppercase tracking-[0.25em] leading-none text-[#78be21]"
      >MN 2040 Clean Grid</span
    >
    <ChevronRight
      size={16}
      class="ml-auto shrink-0 -mt-0.5 text-[#78be21] opacity-70 group-hover:opacity-100 transition-opacity"
    />
  </span>

  <!--
    The headline, at MINNESOTA's weight and scale. The qualifier is set with it
    rather than under it because it is not decoration: 55% is the share of
    in-state *generation* that is carbon-free, which is not a compliance score —
    the statute is enforced per utility against retail sales, and the tracker's
    Sources block is where that distinction has room. A bare "55%" over the map
    would be the misread this whole file is trying to avoid.
  -->
  <!--
    `xl:` is where the width clamp stops biting. Below 1280px
    `calc(100vw - 50rem)` resolves under the full 28rem, so this headline wraps
    to two or three lines and the box grows against the map — 213px tall at
    1024px with the type at one fixed size, which is a lot of map spent on four
    facts. One step down through that band keeps it a headline without letting
    it become a panel.
  -->
  <span class="mt-1.5 block text-2xl xl:text-3xl font-black uppercase tracking-tight leading-none text-[#78be21]">
    <span class="tabular-nums">{sharePct}%</span> carbon-free
  </span>

  <!--
    The countdown as its own line, in the ink rather than the green, so the two
    facts don't merge into one green block. `nowrap` because "14 yrs to" / "2040"
    is not a break worth allowing at any width.
  -->
  <span
    class="mt-2 block text-xs xl:text-sm font-black uppercase tracking-[0.12em] leading-none text-ink whitespace-nowrap"
    data-cg="years-phrase">{yearsPhrase}</span
  >

  <!--
    The conditional, in full. "If all are built" leads the sentence rather than
    trailing it, because a reader who takes only the first half of this line has
    to come away with a hypothetical rather than a claim about today. See the
    header note.
  -->
  <span class="mt-2 block text-[10px] leading-snug text-ink-3">
    If all are built, the {pressure.totalGW.toFixed(2)} GW tracked here adds load
    equal to {drawPct} of MN retail electricity sales.
  </span>
</button>

<script>
  import { onReady } from "~/lib/domReady";
  import {
    OPEN_CLEAN_GRID_EVENT,
    syncCleanGridYear,
  } from "~/lib/cleanGridClient";
  

  // Called here as well as from CleanGridTracker, rather than relying on that
  // component having mounted: the correction is idempotent (it only writes text
  // derived from the current year), and a bar whose countdown depends on
  // another island being present is a bar that silently goes stale the day
  // somebody unmounts the rail.
  let barCleanups: (() => void)[] = [];

  function initCleanGridBar(): void {
    const bar = document.getElementById("cg-bar");
    if (!bar) return;

    while (barCleanups.length > 0) {
      barCleanups.pop()?.();
    }

    syncCleanGridYear();

    // The bar is a headline, so it has to lead somewhere. MapFilterParent owns
    // the rail's exclusive accordion and its collapsed state, and it is the
    // only thing that can honour this — reaching into its DOM from here would
    // be the two-owners bug the layout notes keep warning about.
    const onClick = () => {
      document.dispatchEvent(new CustomEvent(OPEN_CLEAN_GRID_EVENT));
    };
    bar.addEventListener("click", onClick);
    barCleanups.push(() => bar.removeEventListener("click", onClick));
  }

  onReady(initCleanGridBar);
</script>
