---
// src/components/news/NewsFeedList.astro
import type { NewsItem } from '~/lib/newsFeed';
import { Newspaper } from 'lucide-astro';

interface Props {
  newsItems: NewsItem[];
  errorMessage: string | null;
}

const { newsItems, errorMessage } = Astro.props;
---

<div class="flex flex-col h-full w-full">
  <!-- Desktop Header: Hidden inside mobile accordion contexts via hidden md:flex -->
  <div class="hidden md:flex items-center gap-2.5 px-4 py-3.5 shrink-0 min-w-0 border-b border-white/10">
    <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-white/5 shrink-0">
      <Newspaper size={14} stroke-width={2} class="text-emerald-400" />
    </div>
    <div class="min-w-0 flex-1">
      <h4 class="text-[10px] font-bold text-neutral-500 uppercase tracking-wider leading-none whitespace-nowrap">
        Local Coverage
      </h4>
      <p class="text-[11.5px] font-semibold text-neutral-100 mt-1 leading-none truncate">
        Minnesota Data Centers
      </p>
    </div>
  </div>

  <!-- 
    News List Content:
    Optimized scrolling architecture to avoid nested viewport conflicts.
    Mobile: expands naturally (overflow-visible) to allow the parent accordion/sidebar wrapper to handle layout scrolling.
    Desktop: acts as an independent scroll container (md:overflow-y-auto) inside the dedicated right-hand desktop panel.
  -->
  <div class="flex-1 overflow-visible md:overflow-y-auto p-3.5 md:p-4 space-y-4 hide-scrollbar">
    {errorMessage ? (
      <div class="p-3 bg-red-950/30 text-red-400 rounded-lg text-xs border border-red-900/50">
        <strong>Error:</strong> {errorMessage}
      </div>
    ) : newsItems.length === 0 ? (
      <p class="text-neutral-500 text-xs font-medium px-1">No new local updates found within the last week.</p>
    ) : (
      newsItems.map((item) => (
        <article class="border-b border-white/5 pb-3.5 last:border-0 last:pb-0 group">
          <span class="text-[9px] font-bold text-emerald-400/80 tracking-wider uppercase block mb-1">
            {item.source}
          </span>
          <h3 class="text-[11.5px] md:text-xs font-medium text-neutral-200 hover:text-emerald-300 leading-snug transition-colors">
            <a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a>
          </h3>
          <span class="text-[10px] text-neutral-500 block mt-1.5 font-medium">
            {new Date(item.published).toLocaleDateString(undefined, {
              month: 'short',
              day: 'numeric',
              year: 'numeric'
            })}
          </span>
        </article>
      ))
    )}
  </div>
</div>

<style>
  .hide-scrollbar::-webkit-scrollbar { display: none; }
  .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>