---
// src/components/news/NewsFeedParent.astro
import { formatNewsDate, type NewsPayload } from "~/lib/newsFeed";
import { Newspaper } from "lucide-astro";

interface Props extends NewsPayload {
  initialDays?: number;
}

const { newsItems, errorMessage, truncated, initialDays = 7 } = Astro.props;

// Said once, here, so the server's first paint and the client's re-render
// below can't drift into telling the reader two different things.
const TRUNCATION_NOTICE =
  "Google returns at most 100 results per search, and this range hit that limit. These are a sample of the period, not every story in it.";

const RANGE_OPTIONS = [
  { label: "24H", days: 1 },
  { label: "7D", days: 7 },
  { label: "30D", days: 30 },
  { label: "1Y", days: 365 },
];
---

<!--
  One list, both layouts.

  Desktop: the full-height right rail it has always been.

  Phone: the `news` sheet above MobileToolbar.astro — `.mobile-sheet` in
  global.css restates the position, so the desktop utilities below are the only
  ones this element needs. There used to be a second, separate mobile UI here: a
  floating card at the top of the screen containing a snap-scrolling carousel of
  headlines, its own dot indicator, its own auto-rotate timer and its own
  dismiss button. All of it is gone. It existed because a 122px card at the top
  of a phone could only ever show one headline at a time; a sheet shows the same
  list the desktop rail does, and the one thing the card genuinely did better —
  putting a headline in front of someone who never asked for one — is now the
  toolbar's ticker line, which costs 28px instead of 122 and needs no timer.
-->
<div
  id="news-feed-panel"
  data-initial-days={initialDays}
  class="mobile-sheet absolute top-0 bottom-0 right-0 left-auto z-30 pointer-events-auto font-sans bg-panel backdrop-blur-md border border-hair md:border-l md:border-t-0 md:border-r-0 md:border-b-0 rounded-2xl md:rounded-none shadow-2xl shadow-(color:--shadow-panel) md:w-96 flex flex-col overflow-hidden md:overflow-visible transition-transform duration-300 ease-out translate-x-0"
>
  <!--
    Header. Same navy band as the filter sidebar's masthead (see global.css), so
    the two rails are headed identically and the article list below reads as the
    portal's off-white body. Shown at every width now that the phone layout uses
    this same panel rather than a card of its own.
  -->
  <div
    class="band bg-panel flex items-center gap-2.5 px-4 py-3.5 border-b border-hair shrink-0"
  >
    <div
      class="flex items-center justify-center w-7 h-7 rounded-lg bg-hover shrink-0"
    >
      <Newspaper size={14} stroke-width={2} class="text-accent" />
    </div>
    <div class="min-w-0 flex-1">
      <h4
        class="text-[10px] font-bold text-ink mt-1 uppercase tracking-wider leading-none"
      >
        Related MN Coverage
      </h4>
    </div>
    <!--
      `data-sheet-close` is the toolbar's documented way to be asked to close
      the open sheet without this panel needing to know what a sheet is — see
      ~/lib/mobileSheet.ts. The scrim and the tab itself both close it too; this
      is the affordance that says so.
    -->
    <button
      type="button"
      data-sheet-close
      aria-label="Close news panel"
      class="md:hidden w-8 h-8 -mr-1 flex items-center justify-center rounded-full text-ink-3 active:bg-hover transition-colors shrink-0"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M18 6L6 18M6 6l12 12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <!--
    Date Range Selector. `.band-sub` is the portal's dark footer grey: a third
    surface between the navy header and the off-white list, which is what keeps
    the range pills reading as chrome rather than as the first article.

    Offered at every width again. These were hidden on phones because four 9px
    pills wedged into a 122px notification card were unhittable; in a sheet
    there is room to give them a real target height.
  -->
  <div
    id="nf-range-group"
    role="group"
    aria-label="News date range"
    class="band-sub bg-panel flex items-center gap-1.5 px-4 py-2.5 border-b border-hair shrink-0"
  >
    {
      RANGE_OPTIONS.map((opt) => (
        <button
          type="button"
          class="nf-range-btn text-[9px] font-bold uppercase tracking-wider px-3 min-h-8 md:min-h-0 md:py-1 rounded-full border transition-colors text-ink-4 border-hair hover:text-ink"
          data-days={opt.days}
          aria-pressed={opt.days === initialDays ? "true" : "false"}
        >
          {opt.label}
        </button>
      ))
    }
    <span
      id="nf-range-status"
      class="text-[9px] text-ink-4 ml-auto uppercase tracking-wider"
    />
  </div>

  <div
    id="nf-content-area"
    class="overflow-y-auto p-4 space-y-4 hide-scrollbar flex-1 min-h-0"
  >
    {
      errorMessage ? (
        <div class="p-3 bg-red-500/10 text-red-700 dark:text-red-300 rounded-lg text-xs border border-red-500/30 dark:border-red-400/40">
          <strong>Error:</strong> {errorMessage}
        </div>
      ) : newsItems.length === 0 ? (
        <p class="text-ink-4 text-xs font-medium px-1">
          No new local updates found.
        </p>
      ) : (
        <Fragment>
          {truncated && (
            <p class="text-[10px] text-ink-4 leading-snug px-1 pb-1 border-b border-hair">
              {TRUNCATION_NOTICE}
            </p>
          )}
          {newsItems.map((item) => (
          <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
            <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-1">
              {item.source}
            </span>
            <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
            </h3>
            <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">
              {formatNewsDate(item.published)}
            </span>
          </article>
          ))}
        </Fragment>
      )
    }
  </div>

  <!-- Desktop pull-tab toggle -->
  <button
    id="nf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="news-feed-panel"
    aria-label="Toggle news feed panel"
    class="hidden md:flex absolute z-40 items-center justify-center bg-panel border border-hair border-r-0 text-ink-3 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50
           top-1/2 left-0 -translate-x-full -translate-y-1/2 w-8 h-12 rounded-l-xl"
  >
    <svg
      id="nf-toggle-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      class="transition-transform duration-300 ease-out"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M9 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script
  is:inline
  type="application/json"
  id="nf-initial-data"
  set:html={JSON.stringify({ newsItems, errorMessage, truncated, notice: TRUNCATION_NOTICE }).replace(/</g, "\\u003c")}
/>

<script>
  import { onReady } from "~/lib/domReady";
  import {
    byPublishedDesc,
    formatNewsDate,
    type NewsItem,
    type NewsPayload,
  } from "~/lib/newsFeed";
  import { readStoredFlag, writeStoredFlag } from "~/lib/storage";
  import { onSheetChange, type SheetId } from "~/lib/mobileSheet";

  const STORAGE_KEY = "newsFeedCollapsed";
  const DESKTOP_MEDIA_QUERY = "(min-width: 768px)";
  const DAY_MS = 24 * 60 * 60 * 1000;

  let isMarkerSelected = false;
  /** Desktop only: the pull-tab's persisted state. */
  let isNewsCollapsed = false;
  /** Phone only: which sheet the toolbar says is open. */
  let openSheet: SheetId | null = null;
  let newsCleanups: (() => void)[] = [];
  let currentDays = 7;
  let desktopMql: MediaQueryList | null = null;

  // Every article ever fetched this session, keyed by normalized
  // title+source (see dedupeKey below) — not by url. Google News RSS
  // doesn't return consistent results across *differently scoped* queries
  // for the same underlying story: a `when:1d` query and a `when:7d`
  // query can report the same headline under two different Google
  // redirect URLs and two different published dates, and one is not
  // reliably a superset of the other in either direction. That means
  // every range still has to hit the network for itself (there is no way
  // to safely derive a narrower window's results by filtering a wider
  // window's cached response, or vice versa — an earlier version of this
  // file tried exactly that and silently dropped today's freshest article
  // from "24H" because the cached "7D" fetch never contained it), and
  // deduping by url would show that same story twice. What accumulating
  // fetched results into one title-keyed pool *does* still buy us: once
  // an article has been seen under any window, switching to a wider
  // window won't lose it or duplicate it just because that window's own
  // live query returned a different URL/date for the identical headline.
  let articleCache = new Map<string, NewsItem>();
  let lastFetchError: string | null = null;

  // Google's per-query redirect URLs aren't a stable identity for "the
  // same story" (see note above), but a title from the same outlet is —
  // two truly distinct stories that happen to share a headline but come
  // from different outlets are still treated as separate entries.
  function dedupeKey(item: NewsItem): string {
    return `${item.title.trim().toLowerCase()}::${item.source.trim().toLowerCase()}`;
  }

  function mergeItems(items: NewsItem[]): void {
    for (const item of items) articleCache.set(dedupeKey(item), item);
  }

  function itemsWithinWindow(days: number): NewsItem[] {
    const cutoff = Date.now() - days * DAY_MS;
    return Array.from(articleCache.values())
      .filter((item) => new Date(item.published).getTime() >= cutoff)
      .sort(byPublishedDesc);
  }

  // Carried over from the server render rather than restated here, so the two
  // copies of this sentence can't drift apart.
  let truncationNotice = "";

  // Truncation is a property of the window being shown, not of the accumulated
  // pool, so it's tracked per window: switching from 1Y back to 7D has to drop
  // the caveat along with the year's extra articles.
  const truncatedWindows = new Set<number>();

  function readInitialPayload(): NewsPayload & { notice?: string } {
    const el = document.getElementById("nf-initial-data");
    const empty = { newsItems: [], errorMessage: null, truncated: false };
    if (!el?.textContent) return empty;
    try {
      return JSON.parse(el.textContent);
    } catch {
      return empty;
    }
  }

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function itemHTML(item: NewsItem): string {
    return `
      <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
        <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-1">${escapeHtml(item.source)}</span>
        <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
          <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title)}</a>
        </h3>
        <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">${formatNewsDate(item.published)}</span>
      </article>`;
  }

  /**
   * The toolbar's one-line ticker (MobileToolbar.astro).
   *
   * This is the whole of what the deleted mobile news card did that a tab
   * cannot: put a headline in front of someone who never went looking for one.
   * `textContent`, not innerHTML — the title is third-party RSS.
   *
   * Hidden whenever there is nothing to say, so an outage or an empty window
   * costs no height rather than showing an empty bar.
   */
  function renderTicker(newsItems: NewsItem[]): void {
    const ticker = document.getElementById("mt-ticker");
    const text = document.getElementById("mt-ticker-text");
    if (!ticker || !text) return;

    const lead = newsItems[0];
    if (!lead) {
      ticker.classList.add("hidden");
      ticker.classList.remove("flex");
      text.textContent = "";
      return;
    }
    text.textContent = lead.title;
    ticker.classList.remove("hidden");
    ticker.classList.add("flex");
  }

  function renderNews(newsItems: NewsItem[], errorMessage: string | null): void {
    const area = document.getElementById("nf-content-area");
    if (!area) return;

    if (errorMessage) {
      area.innerHTML = `<div class="p-3 bg-red-500/10 text-red-700 dark:text-red-300 rounded-lg text-xs border border-red-500/30 dark:border-red-400/40"><strong>Error:</strong> ${escapeHtml(errorMessage)}</div>`;
    } else if (newsItems.length === 0) {
      area.innerHTML = `<p class="text-ink-4 text-xs font-medium px-1">No new local updates found.</p>`;
    } else {
      const notice =
        truncatedWindows.has(currentDays) && truncationNotice
          ? `<p class="text-[10px] text-ink-4 leading-snug px-1 pb-1 border-b border-hair">${escapeHtml(truncationNotice)}</p>`
          : "";
      area.innerHTML = notice + newsItems.map(itemHTML).join("");
    }

    renderTicker(errorMessage ? [] : newsItems);
  }

  // `bg-accent-soft`, not `bg-accent/10`: the campaign banner's chamber pills are
  // the same affordance (its comment says so) and use the token, so this had
  // drifted to a differently-mixed wash of the same colour.
  const PILL_ON = ["text-accent", "border-accent/30", "bg-accent-soft"];
  const PILL_OFF = ["text-ink-4", "border-hair"];

  function updateRangeButtons(root: HTMLElement): void {
    root.querySelectorAll<HTMLButtonElement>(".nf-range-btn").forEach((btn) => {
      const isActive = Number(btn.dataset.days) === currentDays;
      btn.setAttribute("aria-pressed", String(isActive));
      btn.classList.add(...(isActive ? PILL_ON : PILL_OFF));
      btn.classList.remove(...(isActive ? PILL_OFF : PILL_ON));
    });
  }

  /**
   * Fetch and render one window.
   *
   * `silent` is for the refresh on mount, where there is already server-rendered
   * content on screen: flashing "Loading…" over headlines the reader is halfway
   * through, to replace them with the same headlines, is worse than saying
   * nothing. A range *click* is an explicit request and does show progress.
   */
  async function showRange(
    root: HTMLElement,
    days: number,
    opts: { silent?: boolean } = {},
  ): Promise<void> {
    currentDays = days;
    updateRangeButtons(root);

    // Always fetch this window's own live results — a wider window's
    // cached response can't be trusted to contain everything a direct
    // query for `days` would (see the note on articleCache above).
    const status = document.getElementById("nf-range-status");
    if (status && !opts.silent) status.textContent = "Loading…";

    const buttons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    if (!opts.silent) buttons.forEach((btn) => (btn.disabled = true));

    try {
      const res = await fetch(`/api/news?days=${days}`);
      if (!res.ok) throw new Error("Request failed");
      const data = (await res.json()) as NewsPayload;
      if (data.errorMessage) {
        lastFetchError = data.errorMessage;
      } else {
        mergeItems(data.newsItems ?? []);
        lastFetchError = null;
        // Recorded, not just read, because the pool this window renders from
        // accumulates across fetches: once 1Y has been shown to be cut off,
        // coming back to it later must still say so.
        if (data.truncated) truncatedWindows.add(days);
        else truncatedWindows.delete(days);
      }
      // Best-effort: if we still have relevant cached items (from a prior
      // successful fetch of a different window) show those rather than
      // blanking the panel over one failed range's error.
      if (articleCache.size > 0) {
        renderNews(itemsWithinWindow(days), null);
      } else {
        renderNews([], lastFetchError ?? "No updates found.");
      }
    } catch {
      if (articleCache.size > 0) {
        renderNews(itemsWithinWindow(days), null);
      } else {
        renderNews([], "Couldn't load news for that range.");
      }
    } finally {
      buttons.forEach((btn) => (btn.disabled = false));
      if (status && !opts.silent) status.textContent = "";
    }
  }

  function initNewsFeed(): void {
    const root = document.getElementById("news-feed-panel");
    if (!root) return;

    while (newsCleanups.length > 0) {
      newsCleanups.pop()?.();
    }

    const parsedInitialDays = Number(root.dataset.initialDays);
    currentDays = Number.isNaN(parsedInitialDays) ? 7 : parsedInitialDays;

    // Seed the shared pool with whatever the server already fetched for
    // the initial (default) range, so it's not lost if the user switches
    // away and back.
    articleCache = new Map();
    lastFetchError = null;
    truncatedWindows.clear();
    const initialPayload = readInitialPayload();
    truncationNotice = initialPayload.notice ?? "";
    if (initialPayload.errorMessage) {
      lastFetchError = initialPayload.errorMessage;
    } else {
      mergeItems(initialPayload.newsItems);
      if (initialPayload.truncated) truncatedWindows.add(currentDays);
    }
    renderTicker(
      initialPayload.errorMessage ? [] : initialPayload.newsItems,
    );

    const toggleBtn = document.getElementById(
      "nf-toggle",
    ) as HTMLButtonElement | null;
    const toggleIcon = document.getElementById(
      "nf-toggle-icon",
    ) as SVGElement | null;

    const rangeButtons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    rangeButtons.forEach((btn) => {
      const onClick = () => {
        const days = Number(btn.dataset.days);
        if (!Number.isNaN(days) && days !== currentDays) {
          showRange(root, days);
        }
      };
      btn.addEventListener("click", onClick);
      newsCleanups.push(() => btn.removeEventListener("click", onClick));
    });
    updateRangeButtons(root);

    desktopMql = window.matchMedia(DESKTOP_MEDIA_QUERY);

    isMarkerSelected = false;
    isNewsCollapsed = readStoredFlag(STORAGE_KEY);
    openSheet = null;

    /**
     * Keeps the map's control stack clear of the right-hand rail.
     *
     * MapLibre's zoom buttons, its attribution, and MapThemeSelector.astro's
     * layers button all anchor to --map-ctrl-right (see global.css), which was
     * a flat 10px — the map container's own right edge. This panel is docked to
     * that same edge at `md:w-96` and sits above them at z-30, so with the news
     * rail showing, which is its default, every one of those controls was
     * underneath it: not merely hard to see but unclickable, at every desktop
     * width. Collapsing the rail was the only way to reach the basemap picker
     * or the zoom buttons, and nothing said so.
     *
     * Written from here, and only here, because this island is the one that
     * knows whether the corner is occupied: it tracks its own collapsed state
     * *and* the marker selection that slides the facility panel — the same
     * width — into the same edge. A second writer would be the two-owners
     * problem MobileToolbar.astro's --map-controls-bottom note describes.
     */
    function publishControlEdge(occupied: boolean): void {
      const style = document.documentElement.style;
      if (occupied) {
        style.setProperty(
          "--map-ctrl-right",
          "calc(var(--map-rail-w) + var(--map-ctrl-edge))",
        );
      } else {
        style.removeProperty("--map-ctrl-right");
      }
    }

    function updatePanelDOM(): void {
      // On a phone this panel is one of three that share a slot, and the
      // toolbar decides which. `hidden` beats the `flex` in the class list
      // above (Tailwind emits it later in the utilities layer), which is the
      // same mechanism the facility panel uses.
      if (!desktopMql!.matches) {
        root!.classList.toggle("hidden", openSheet !== "news");
        toggleBtn?.classList.add("hidden");
        // A sheet docks to the bottom edge above the toolbar, not to the right
        // one, so the corner is the map's again.
        publishControlEdge(false);
        return;
      }

      // Either surface holds the right edge at the same width — see
      // `publishControlEdge`.
      publishControlEdge(isMarkerSelected || !isNewsCollapsed);

      // Desktop owns its own visibility again; anything the phone layout put
      // on this element has to come back off, or the rail stays gone at a
      // width where nothing can bring it back.
      root!.classList.remove("hidden");

      if (isMarkerSelected) {
        root!.classList.add("translate-x-full");
        root!.classList.remove("translate-x-0");
        toggleBtn?.classList.add("hidden");
      } else {
        toggleBtn?.classList.remove("hidden");
        if (isNewsCollapsed) {
          root!.classList.add("translate-x-full");
          root!.classList.remove("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "false");
          if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
        } else {
          root!.classList.remove("translate-x-full");
          root!.classList.add("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "true");
          if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
        }
      }
    }

    /** Desktop pull-tab. Persisted, because a rail someone slid shut should
     *  stay shut — and it can always be slid back open. */
    const onToggleClick = () => {
      isNewsCollapsed = !isNewsCollapsed;
      writeStoredFlag(STORAGE_KEY, isNewsCollapsed);
      updatePanelDOM();
    };
    toggleBtn?.addEventListener("click", onToggleClick);
    newsCleanups.push(() =>
      toggleBtn?.removeEventListener("click", onToggleClick),
    );

    const onMarkerSelect = (event: Event) => {
      const detail = (
        event as CustomEvent<{ project: unknown } | null>
      ).detail;
      isMarkerSelected = !!detail?.project;
      updatePanelDOM();
    };
    document.addEventListener("mapmarkerselect", onMarkerSelect);
    newsCleanups.push(() =>
      document.removeEventListener("mapmarkerselect", onMarkerSelect),
    );

    newsCleanups.push(
      onSheetChange((open) => {
        openSheet = open;
        updatePanelDOM();
      }),
    );

    const onMediaChange = () => updatePanelDOM();
    desktopMql.addEventListener("change", onMediaChange);
    newsCleanups.push(() =>
      desktopMql!.removeEventListener("change", onMediaChange),
    );

    updatePanelDOM();

    // Refresh from the live route on mount.
    //
    // This is what makes the scheduled full-site rebuild unnecessary. The
    // markup above is a build-time snapshot — it paints instantly and works
    // without JS, but it's frozen at deploy time, and refreshing it was the
    // only job of the six-hourly cron. /api/news answers the same query live
    // and is cached server-side per window, so one fetch serves every visitor
    // in that window and the panel is never older than its freshness period.
    //
    // Silent when there's already something on screen: the common case is that
    // live results match the snapshot, and a visible reload for no visible
    // change is just noise.
    const hasPaintedItems =
      !initialPayload.errorMessage && initialPayload.newsItems.length > 0;
    void showRange(root, currentDays, { silent: hasPaintedItems });
  }

  onReady(initNewsFeed);
</script>
