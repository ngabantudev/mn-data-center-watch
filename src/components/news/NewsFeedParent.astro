---
// src/components/news/NewsFeedParent.astro
import type { NewsItem } from "~/lib/newsFeed";
import { Newspaper } from "lucide-astro";

interface Props {
  newsItems: NewsItem[];
  errorMessage: string | null;
  initialDays?: number;
}

const { newsItems, errorMessage, initialDays = 7 } = Astro.props;

const RANGE_OPTIONS = [
  { label: "24H", days: 1 },
  { label: "7D", days: 7 },
  { label: "30D", days: 30 },
  { label: "1Y", days: 365 },
];
---

<div
  id="news-feed-panel"
  data-initial-days={initialDays}
  class="fixed md:absolute top-3 left-4 right-4 max-w-sm mx-auto md:mx-0 md:inset-x-auto md:top-0 md:bottom-0 md:right-0 md:left-auto z-50 md:z-30 pointer-events-auto font-sans bg-panel/90 md:bg-panel backdrop-blur-xl md:backdrop-blur-md border border-hair md:border-l md:border-t-0 md:border-r-0 md:border-b-0 rounded-2xl md:rounded-none shadow-2xl shadow-[color:var(--shadow-panel)] md:w-96 flex flex-col overflow-hidden md:overflow-visible transition-transform duration-300 ease-out translate-x-0"
>
  <!-- Desktop Header -->
  <div
    id="nf-header-row"
    class="hidden md:flex items-center gap-2.5 px-4 py-3.5 border-b border-hair shrink-0"
  >
    <div
      class="flex items-center justify-center w-7 h-7 rounded-lg bg-hover shrink-0"
    >
      <Newspaper size={14} stroke-width={2} class="text-accent" />
    </div>
    <div class="min-w-0 flex-1">
      <h4
        class="text-[10px] font-bold text-ink mt-1 uppercase tracking-wider leading-none"
      >
        Related MN Coverage
      </h4>
    </div>
  </div>

  <!-- Date Range Selector -->
  <div
    id="nf-range-group"
    role="group"
    aria-label="News date range"
    class="flex items-center gap-1.5 px-4 py-2.5 border-b border-hair shrink-0"
  >
    {
      RANGE_OPTIONS.map((opt) => (
        <button
          type="button"
          class="nf-range-btn text-[9px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border transition-colors text-ink-4 border-hair hover:text-ink"
          data-days={opt.days}
          aria-pressed={opt.days === initialDays ? "true" : "false"}
        >
          {opt.label}
        </button>
      ))
    }
    <span
      id="nf-range-status"
      class="text-[9px] text-ink-4 ml-auto uppercase tracking-wider"
    />
  </div>

  <!-- Mobile Notification (Carousel) -->
  <div id="nf-mobile-wrap" class="md:hidden relative w-full flex flex-col">
    <div
      id="nf-carousel"
      class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full"
    >
      {
        errorMessage ? (
          <div class="p-4 text-red-300 text-xs w-full text-center">
            {errorMessage}
          </div>
        ) : newsItems.length === 0 ? (
          <p class="text-ink-4 text-xs w-full text-center p-4">
            No updates found.
          </p>
        ) : (
          newsItems.map((item) => (
            <article class="w-full shrink-0 snap-center p-3 flex flex-col justify-center">
              <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-0.5">
                Breaking News
              </span>
              <h3 class="text-xs font-medium text-ink-2 leading-snug line-clamp-2">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              </h3>
            </article>
          ))
        )
      }
    </div>

    {
      newsItems.length > 0 && !errorMessage && (
        <div id="nf-dots" class="flex justify-center gap-1.5 pb-2">
          {newsItems.map((_, i) => (
            <div
              class="news-dot w-1 h-1 rounded-full bg-ink-4 transition-colors"
              data-index={i}
            />
          ))}
        </div>
      )
    }
  </div>

  <!-- Desktop List Content -->
  <div
    id="nf-content-area"
    class="hidden md:block overflow-y-auto p-4 space-y-4 hide-scrollbar flex-1"
  >
    {
      errorMessage ? (
        <div class="p-3 bg-red-500/10 text-red-300 rounded-lg text-xs border border-red-400/40">
          <strong>Error:</strong> {errorMessage}
        </div>
      ) : newsItems.length === 0 ? (
        <p class="text-ink-4 text-xs font-medium px-1">
          No new local updates found.
        </p>
      ) : (
        newsItems.map((item) => (
          <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
            <span class="text-[9px] font-bold text-accent/80 tracking-wider uppercase block mb-1">
              {item.source}
            </span>
            <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
            </h3>
            <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">
              {new Date(item.published).toLocaleDateString(undefined, {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </span>
          </article>
        ))
      )
    }
  </div>

  <!-- Mobile Close Action -->
  <div class="block md:hidden border-t border-hair shrink-0">
    <button
      id="nf-mobile-close"
      type="button"
      class="w-full py-1.5 text-center text-[9px] font-bold uppercase tracking-wider text-ink-4 hover:text-ink transition-colors"
    >
      Dismiss
    </button>
  </div>

  <!-- Desktop pull-tab toggle -->
  <button
    id="nf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="news-feed-panel"
    aria-label="Toggle news feed panel"
    class="hidden md:flex absolute z-40 items-center justify-center bg-panel border border-hair border-r-0 text-ink-3 hover:text-ink hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50
           top-1/2 left-0 -translate-x-full -translate-y-1/2 w-8 h-12 rounded-l-xl"
  >
    <svg
      id="nf-toggle-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      class="transition-transform duration-300 ease-out"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M9 6l6 6-6 6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script
  type="application/json"
  id="nf-initial-data"
  set:html={JSON.stringify({ newsItems, errorMessage }).replace(/</g, "\\u003c")}
/>

<script>
  import type { NewsItem } from "~/lib/newsFeed";

  const STORAGE_KEY = "newsFeedCollapsed";
  const DESKTOP_MEDIA_QUERY = "(min-width: 768px)";
  const DAY_MS = 24 * 60 * 60 * 1000;

  let isMarkerSelected = false;
  let isNewsCollapsed = false;
  let newsCleanups: (() => void)[] = [];
  let currentDays = 7;
  let carouselCleanup: (() => void) | null = null;

  // Every article ever fetched this session, keyed by normalized
  // title+source (see dedupeKey below) — not by url. Google News RSS
  // doesn't return consistent results across *differently scoped* queries
  // for the same underlying story: a `when:1d` query and a `when:7d`
  // query can report the same headline under two different Google
  // redirect URLs and two different published dates, and one is not
  // reliably a superset of the other in either direction. That means
  // every range still has to hit the network for itself (there is no way
  // to safely derive a narrower window's results by filtering a wider
  // window's cached response, or vice versa — an earlier version of this
  // file tried exactly that and silently dropped today's freshest article
  // from "24H" because the cached "7D" fetch never contained it), and
  // deduping by url would show that same story twice. What accumulating
  // fetched results into one title-keyed pool *does* still buy us: once
  // an article has been seen under any window, switching to a wider
  // window won't lose it or duplicate it just because that window's own
  // live query returned a different URL/date for the identical headline.
  let articleCache = new Map<string, NewsItem>();
  let lastFetchError: string | null = null;

  // Google's per-query redirect URLs aren't a stable identity for "the
  // same story" (see note above), but a title from the same outlet is —
  // two truly distinct stories that happen to share a headline but come
  // from different outlets are still treated as separate entries.
  function dedupeKey(item: NewsItem): string {
    return `${item.title.trim().toLowerCase()}::${item.source.trim().toLowerCase()}`;
  }

  function mergeItems(items: NewsItem[]): void {
    for (const item of items) articleCache.set(dedupeKey(item), item);
  }

  function itemsWithinWindow(days: number): NewsItem[] {
    const cutoff = Date.now() - days * DAY_MS;
    return Array.from(articleCache.values())
      .filter((item) => new Date(item.published).getTime() >= cutoff)
      .sort(
        (a, b) => new Date(b.published).getTime() - new Date(a.published).getTime(),
      );
  }

  function readInitialPayload(): {
    newsItems: NewsItem[];
    errorMessage: string | null;
  } {
    const el = document.getElementById("nf-initial-data");
    if (!el?.textContent) return { newsItems: [], errorMessage: null };
    try {
      return JSON.parse(el.textContent);
    } catch {
      return { newsItems: [], errorMessage: null };
    }
  }

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function formatDate(published: string): string {
    return new Date(published).toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  }

  function desktopItemHTML(item: NewsItem): string {
    return `
      <article class="border-b border-hair pb-3.5 last:border-0 last:pb-0 group">
        <span class="text-[9px] font-bold text-accent/80 tracking-wider uppercase block mb-1">${escapeHtml(item.source)}</span>
        <h3 class="text-xs font-medium text-ink-2 hover:text-accent-hover leading-snug">
          <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title)}</a>
        </h3>
        <span class="text-[10px] text-ink-4 block mt-1.5 font-medium">${formatDate(item.published)}</span>
      </article>`;
  }

  function mobileItemHTML(item: NewsItem): string {
    return `
      <article class="w-full shrink-0 snap-center p-3 flex flex-col justify-center">
        <span class="text-[9px] font-bold text-accent tracking-wider uppercase block mb-0.5">Breaking News</span>
        <h3 class="text-xs font-medium text-ink-2 leading-snug line-clamp-2">
          <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(item.title)}</a>
        </h3>
      </article>`;
  }

  function renderNews(newsItems: NewsItem[], errorMessage: string | null): void {
    const desktopArea = document.getElementById("nf-content-area");
    const mobileWrap = document.getElementById("nf-mobile-wrap");
    if (!desktopArea || !mobileWrap) return;

    if (errorMessage) {
      desktopArea.innerHTML = `<div class="p-3 bg-red-500/10 text-red-300 rounded-lg text-xs border border-red-400/40"><strong>Error:</strong> ${escapeHtml(errorMessage)}</div>`;
      mobileWrap.innerHTML = `<div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full"><div class="p-4 text-red-300 text-xs w-full text-center">${escapeHtml(errorMessage)}</div></div>`;
      return;
    }

    if (newsItems.length === 0) {
      desktopArea.innerHTML = `<p class="text-ink-4 text-xs font-medium px-1">No new local updates found.</p>`;
      mobileWrap.innerHTML = `<div class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full"><p class="text-ink-4 text-xs w-full text-center p-4">No updates found.</p></div>`;
      return;
    }

    desktopArea.innerHTML = newsItems.map(desktopItemHTML).join("");
    mobileWrap.innerHTML = `
      <div id="nf-carousel" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar w-full">
        ${newsItems.map(mobileItemHTML).join("")}
      </div>
      <div id="nf-dots" class="flex justify-center gap-1.5 pb-2">
        ${newsItems.map((_, i) => `<div class="news-dot w-1 h-1 rounded-full bg-ink-4 transition-colors" data-index="${i}"></div>`).join("")}
      </div>`;

    initCarousel();
  }

  function initCarousel(): void {
    carouselCleanup?.();
    carouselCleanup = null;

    const carousel = document.getElementById("nf-carousel") as HTMLDivElement | null;
    const dots = document.querySelectorAll<HTMLDivElement>(".news-dot");
    if (!carousel || carousel.children.length === 0) return;

    let currentIndex = 0;
    const totalItems = carousel.children.length;
    let autoRotateInterval: number;

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-accent", i === index);
        dot.classList.toggle("bg-ink-4", i !== index);
      });
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % totalItems;
      carousel!.scrollTo({ left: carousel!.offsetWidth * currentIndex, behavior: "smooth" });
      updateDots(currentIndex);
    }

    function startAutoRotate() {
      autoRotateInterval = window.setInterval(nextSlide, 5000);
    }

    function resetAutoRotate() {
      clearInterval(autoRotateInterval);
      startAutoRotate();
    }

    const onCarouselScroll = () => {
      const index = Math.round(carousel.scrollLeft / carousel.offsetWidth);
      if (index !== currentIndex) {
        currentIndex = index;
        updateDots(currentIndex);
        resetAutoRotate();
      }
    };
    carousel.addEventListener("scroll", onCarouselScroll);

    updateDots(0);
    startAutoRotate();

    carouselCleanup = () => {
      carousel.removeEventListener("scroll", onCarouselScroll);
      clearInterval(autoRotateInterval);
    };
  }

  function updateRangeButtons(root: HTMLElement): void {
    const buttons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    buttons.forEach((btn) => {
      const isActive = Number(btn.dataset.days) === currentDays;
      btn.setAttribute("aria-pressed", String(isActive));
      btn.classList.toggle("text-accent", isActive);
      btn.classList.toggle("border-accent/30", isActive);
      btn.classList.toggle("bg-accent/10", isActive);
      btn.classList.toggle("text-ink-4", !isActive);
      btn.classList.toggle("border-hair", !isActive);
    });
  }

  async function showRange(root: HTMLElement, days: number): Promise<void> {
    currentDays = days;
    updateRangeButtons(root);

    // Always fetch this window's own live results — a wider window's
    // cached response can't be trusted to contain everything a direct
    // query for `days` would (see the note on articleCache above).
    const status = document.getElementById("nf-range-status");
    if (status) status.textContent = "Loading…";

    const buttons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    buttons.forEach((btn) => (btn.disabled = true));

    try {
      const res = await fetch(`/api/news?days=${days}`);
      if (!res.ok) throw new Error("Request failed");
      const data = (await res.json()) as {
        newsItems: NewsItem[];
        errorMessage: string | null;
      };
      if (data.errorMessage) {
        lastFetchError = data.errorMessage;
      } else {
        mergeItems(data.newsItems ?? []);
        lastFetchError = null;
      }
      // Best-effort: if we still have relevant cached items (from a prior
      // successful fetch of a different window) show those rather than
      // blanking the panel over one failed range's error.
      if (articleCache.size > 0) {
        renderNews(itemsWithinWindow(days), null);
      } else {
        renderNews([], lastFetchError ?? "No updates found.");
      }
    } catch {
      if (articleCache.size > 0) {
        renderNews(itemsWithinWindow(days), null);
      } else {
        renderNews([], "Couldn't load news for that range.");
      }
    } finally {
      buttons.forEach((btn) => (btn.disabled = false));
      if (status) status.textContent = "";
    }
  }

  function initNewsFeed(): void {
    const root = document.getElementById("news-feed-panel");
    if (!root) return;

    while (newsCleanups.length > 0) {
      newsCleanups.pop()?.();
    }

    const parsedInitialDays = Number(root.dataset.initialDays);
    currentDays = Number.isNaN(parsedInitialDays) ? 7 : parsedInitialDays;

    // Seed the shared pool with whatever the server already fetched for
    // the initial (default) range, so it's not lost if the user switches
    // away and back.
    articleCache = new Map();
    lastFetchError = null;
    const initialPayload = readInitialPayload();
    if (initialPayload.errorMessage) {
      lastFetchError = initialPayload.errorMessage;
    } else {
      mergeItems(initialPayload.newsItems);
    }

    const toggleBtn = document.getElementById(
      "nf-toggle",
    ) as HTMLButtonElement | null;
    const toggleIcon = document.getElementById(
      "nf-toggle-icon",
    ) as SVGElement | null;
    const closeBtn = document.getElementById(
      "nf-mobile-close",
    ) as HTMLButtonElement | null;

    const rangeButtons = root.querySelectorAll<HTMLButtonElement>(".nf-range-btn");
    rangeButtons.forEach((btn) => {
      const onClick = () => {
        const days = Number(btn.dataset.days);
        if (!Number.isNaN(days) && days !== currentDays) {
          showRange(root, days);
        }
      };
      btn.addEventListener("click", onClick);
      newsCleanups.push(() => btn.removeEventListener("click", onClick));
    });
    updateRangeButtons(root);

    const desktopMql = window.matchMedia(DESKTOP_MEDIA_QUERY);

    isMarkerSelected = false;
    try {
      isNewsCollapsed = localStorage.getItem(STORAGE_KEY) === "true";
    } catch {
      isNewsCollapsed = false;
    }

    function updatePanelDOM(): void {
      const isDesktop = desktopMql.matches;

      if (!isDesktop) {
        root!.classList.remove("translate-x-full");
        root!.classList.add("translate-x-0");
        toggleBtn?.classList.add("hidden");
        return;
      }

      if (isMarkerSelected) {
        root!.classList.add("translate-x-full");
        root!.classList.remove("translate-x-0");
        toggleBtn?.classList.add("hidden");
      } else {
        toggleBtn?.classList.remove("hidden");
        if (isNewsCollapsed) {
          root!.classList.add("translate-x-full");
          root!.classList.remove("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "false");
          if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
        } else {
          root!.classList.remove("translate-x-full");
          root!.classList.add("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "true");
          if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
        }
      }
    }

    function setCollapsed(next: boolean): void {
      isNewsCollapsed = next;
      try {
        localStorage.setItem(STORAGE_KEY, String(isNewsCollapsed));
      } catch {}
      updatePanelDOM();
    }

    const onToggleClick = () => setCollapsed(!isNewsCollapsed);
    toggleBtn?.addEventListener("click", onToggleClick);
    newsCleanups.push(() =>
      toggleBtn?.removeEventListener("click", onToggleClick),
    );

    const onCloseClick = () => setCollapsed(true);
    closeBtn?.addEventListener("click", onCloseClick);
    newsCleanups.push(() =>
      closeBtn?.removeEventListener("click", onCloseClick),
    );

    const onMarkerSelect = (event: Event) => {
      const detail = (
        event as CustomEvent<{ project: unknown } | null>
      ).detail;
      isMarkerSelected = !!detail?.project;
      updatePanelDOM();
    };
    document.addEventListener("mapmarkerselect", onMarkerSelect);
    newsCleanups.push(() =>
      document.removeEventListener("mapmarkerselect", onMarkerSelect),
    );

    const onMediaChange = () => updatePanelDOM();
    desktopMql.addEventListener("change", onMediaChange);
    newsCleanups.push(() =>
      desktopMql.removeEventListener("change", onMediaChange),
    );

    updatePanelDOM();

    // Mobile carousel (server-rendered items on first mount, re-run after range changes)
    initCarousel();
    newsCleanups.push(() => carouselCleanup?.());
  }

  document.addEventListener("astro:page-load", initNewsFeed);
  if (document.readyState !== "loading") {
    initNewsFeed();
  } else {
    document.addEventListener("DOMContentLoaded", initNewsFeed);
  }
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>