---
// src/components/map/MapDetailCta.astro
//
// The campaign action block. Lives on the *map*, in a MapLibre popup anchored
// above the selected facility's marker — not in the detail sidebar. It appears
// only after a marker is selected (no hover required) and is torn down on
// deselect. MapParent.astro owns that lifecycle.
//
// This component renders the block once into a hidden host and does nothing
// else; MapParent.astro hands the *same DOM node* to `popup.setDOMContent()`
// on each selection and returns it here on close.
//
// ---------------------------------------------------------------------------
// NO PERSONAL DATA.
// ---------------------------------------------------------------------------
// This block used to be a name / ZIP / email signup form posting to
// /api/join. That endpoint validated and logged all three fields to Worker
// observability and persisted none of them — it collected personal data
// without being able to deliver anything for it. Both the form and the
// endpoint are gone.
//
// The replacement routes people to channels that already exist and are
// already public, so the campaign never becomes the custodian of a volunteer
// list. For a campaign opposing well-funded development, a list of who
// opposes it is the most sensitive thing the project could hold, and the
// safest way to hold it is not to.
//
// Every action below is a link out. If you are adding to this block, the test
// is simple: it must not accept input, and it must not require us to know who
// anyone is. See MEMORY of the sourcing rule — same instinct, applied to
// people instead of facts.
//
// Styling is fixed dark-on-white rather than themed, because
// `.maplibregl-popup-content` is deliberately white in both themes (see
// global.css) — same reasoning buildPreviewHtml() follows in mapMarkers.ts.
import { Megaphone, Landmark, Scale, FileText } from 'lucide-astro';
import {
  MN_LEG_DIRECTORY_URL,
  PUC_COMMENT_URL,
  PUC_EDOCKETS_URL,
} from '~/data/legislation';

/**
 * The three things a resident can actually do about a facility today, in
 * rough order of leverage. All are public processes open to anyone — none of
 * them route through us, and none require an account with anybody.
 */
const ACTIONS = [
  {
    href: PUC_COMMENT_URL,
    icon: Scale,
    label: 'Comment to the PUC',
    detail: 'Public comment is open to anyone — you do not have to be a party to the case.',
  },
  {
    href: MN_LEG_DIRECTORY_URL,
    icon: Landmark,
    label: 'Contact your legislators',
    detail: 'Find the House and Senate members for your address at the state directory.',
  },
  {
    href: PUC_EDOCKETS_URL,
    icon: FileText,
    label: 'Read the filings',
    detail: 'Search eDockets for the utility filings behind a project.',
  },
];
---

<!-- Parked here at render time; MapParent.astro moves #mcta-block in and out
     of the popup. `hidden` keeps it out of the page while it's parked. -->
<div id="mcta-host" hidden>
  <!--
    Two homes, two widths. On desktop this is a MapLibre popup, which sizes to
    its content — so it needs the explicit 286px it has always had. On a phone
    it is parked in the facility sheet's `#mdp-cta` slot (see MapParent.astro),
    where a fixed 286px would leave a ragged white gutter down one side of a
    full-width panel.
  -->
  <div
    id="mcta-block"
    class="font-sans w-full md:w-71.5 max-w-full select-text text-neutral-900"
  >
    <div class="flex items-start gap-2 mb-2">
      <div class="flex items-center justify-center w-6 h-6 rounded-md bg-emerald-50 border border-emerald-200 shrink-0 mt-0.5">
        <Megaphone size={13} stroke-width={2.25} class="text-emerald-700" />
      </div>
      <div class="min-w-0">
        <h4 class="text-[12px] font-bold text-neutral-900 leading-tight wrap-break-word">
          Stop Corporate Tech Sprawl: Act on This Facility.
        </h4>
        <p id="mcta-context" class="text-[10.5px] text-neutral-500 leading-snug mt-1"></p>
      </div>
    </div>

    <ul class="flex flex-col gap-1">
      {
        ACTIONS.map((action) => {
          const Icon = action.icon;
          return (
            <li>
              <a
                href={action.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-2 rounded-lg border border-neutral-200 bg-neutral-50 px-2 py-1.5 transition hover:border-emerald-300 hover:bg-emerald-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60"
              >
                <span class="mt-0.5 shrink-0 text-neutral-400 transition-colors group-hover:text-emerald-700">
                  <Icon size={13} stroke-width={2.25} />
                </span>
                <span class="min-w-0">
                  <span class="block text-[11px] font-semibold text-neutral-900">
                    {action.label} <span aria-hidden="true">&rarr;</span>
                  </span>
                  <span class="block text-[10px] leading-snug text-neutral-500">
                    {action.detail}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <p class="mt-2 border-t border-neutral-200 pt-1.5 text-[9.5px] leading-snug text-neutral-500">
      This site asks for nothing about you — no name, no email, no account. Every link
      above goes to a public process you can enter directly.
    </p>
  </div>
</div>

<script>
  import { onReady } from '~/lib/domReady';

  // Stacking two more `stopPropagation` listeners on a second `onReady` pass
  // would do no visible harm, which is exactly why it is worth dropping them
  // anyway: the invariant domReady.ts asks for is that every island is
  // idempotent, and an island that is only accidentally harmless is the one
  // that stops being harmless when someone adds a second line to it.
  let ctaCleanups: (() => void)[] = [];

  function initCampaignCta(): void {
    const block = document.getElementById('mcta-block');
    if (!block) return;

    while (ctaCleanups.length > 0) {
      ctaCleanups.pop()?.();
    }

    // A click inside the popup must not reach the map — MapLibre would read it
    // as a click on empty basemap and deselect the marker, closing this popup
    // out from under the person using it.
    const swallow = (e: Event) => e.stopPropagation();
    for (const type of ['click', 'mousedown'] as const) {
      block.addEventListener(type, swallow);
      ctaCleanups.push(() => block.removeEventListener(type, swallow));
    }
  }

  onReady(initCampaignCta);
</script>
