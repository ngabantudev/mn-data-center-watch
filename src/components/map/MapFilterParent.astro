---
// src/components/map/MapFilterParent.astro
import { clientProjects, type ProjectStatus } from "~/data/dataCenters";
import { STATUS_META } from "~/data/mapStatusMeta";
import {
  Zap,
  HardHat,
  ClipboardList,
  CirclePause,
  CircleX,
} from "lucide-astro";
import type { NewsItem } from "~/lib/newsFeed";
import FilterHeader from "~/components/filter/FilterHeader.astro";
import FilterLayer from "../filter/FilterLayer.astro";
import FilterStatus from "../filter/FilterStatus.astro";
import FilterProject from "../filter/FilterProject.astro";

interface Props {
  newsItems: NewsItem[];
  errorMessage: string | null;
}

// Logic setup
const countsByStatus = STATUS_META.reduce(
  (acc, meta) => {
    acc[meta.status] = clientProjects.filter(
      (p) => p.status === meta.status,
    ).length;
    return acc;
  },
  {} as Record<ProjectStatus, number>,
);

const parseMW = (val: string | undefined): number => {
  if (!val) return 0;
  const cleaned = val.replace(/,/g, "");
  const match = cleaned.match(/(\d+)/);
  return match ? parseInt(match[1], 10) : 0;
};

const largestProjects = [...clientProjects].sort(
  (a, b) => parseMW(b.powerCapacityMW) - parseMW(a.powerCapacityMW),
);

const maxMW = largestProjects.reduce((max, p) => {
  const val = parseMW(p.powerCapacityMW);
  return val > max ? val : max;
}, 100);

const totalCount = clientProjects.length;

const STATUS_ICONS: Record<ProjectStatus, typeof Zap> = {
  active: Zap,
  construction: HardHat,
  planned: ClipboardList,
  paused: CirclePause,
  rejected: CircleX,
};
---

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<div
  id="map-filters"
  data-total={totalCount}
  class="absolute z-10 pointer-events-auto font-sans bottom-4 left-4 right-4 md:right-auto md:top-0 md:bottom-0 md:left-0 w-auto md:w-72 bg-neutral-900 backdrop-blur-md border border-white/10 md:border-r md:border-l-0 md:border-t-0 md:border-b-0 shadow-2xl shadow-black/60 flex flex-col overflow-hidden md:overflow-visible transition-transform duration-300 ease-out translate-x-0 rounded-2xl md:rounded-none"
>
  <FilterHeader totalCount={totalCount} />

  <div
    id="mf-content"
    class="flex flex-col min-h-0 flex-1 overflow-y-auto hide-scrollbar"
  >
    <FilterStatus
      maxMW={maxMW}
      STATUS_META={STATUS_META}
      countsByStatus={countsByStatus}
      STATUS_ICONS={STATUS_ICONS}
      openByDefault={false}
    />

    <FilterLayer openByDefault={false} />

    <FilterProject largestProjects={largestProjects} openByDefault={false} />
  </div>

  <!-- Desktop pull-tab toggle -->
  <button
    id="mf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="map-filters"
    aria-label="Toggle map filters panel"
    class="hidden md:flex absolute z-40 items-center justify-center bg-neutral-900 border border-white/10 border-l-0 text-neutral-400 hover:text-neutral-100 hover:bg-[#17171d] transition-colors
           top-1/2 right-0 translate-x-full -translate-y-1/2 w-8 h-12 rounded-r-xl"
  >
    <svg
      id="mf-toggle-icon"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      class="transition-transform duration-300 ease-out"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M15 18l-6-6 6-6"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
</div>

<script>
  import { clientProjects } from "~/data/dataCenters";

  const STORAGE_KEY = "mapFiltersCollapsed";
  const parseMW = (val: string | undefined): number => {
    if (!val) return 0;
    const cleaned = val.replace(/,/g, "");
    const match = cleaned.match(/(\d+)/);
    return match ? parseInt(match[1], 10) : 0;
  };

  let filterCleanups: (() => void)[] = [];

  function initMapFilters(): void {
    const root = document.getElementById("map-filters");
    if (!root) return;

    while (filterCleanups.length > 0) {
      filterCleanups.pop()?.();
    }

    const headerTrigger = document.getElementById("mf-header-trigger");
    const content = document.getElementById("mf-content") as HTMLElement | null;
    const countLabel = document.getElementById(
      "mf-count",
    ) as HTMLElement | null;
    const selectAllBtn = document.getElementById("mf-select-all");
    const clearAllBtn = document.getElementById("mf-clear-all");
    const checkboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>(".mf-checkbox"),
    );
    const projectLinks = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".mf-project-link"),
    );
    const mwSlider = document.getElementById(
      "mf-mw-slider",
    ) as HTMLInputElement | null;
    const mwLabel = document.getElementById("mf-mw-val");
    const protectedToggle = document.getElementById(
      "mf-toggle-protected",
    ) as HTMLInputElement | null;
    const toggleBtn = document.getElementById("mf-toggle") as HTMLButtonElement | null;
    const toggleIcon = document.getElementById("mf-toggle-icon") as SVGElement | null;

    const totalCount = clientProjects.length;

    let collapsed = false;
    try {
      collapsed = localStorage.getItem(STORAGE_KEY) === "true";
    } catch {}

    const MOBILE_QUERY = "(max-width: 767px)";
    const FILTERS_BOTTOM_OFFSET = 16;
    const CONTROLS_GAP_ABOVE_FILTERS = 12;

    function updateControlsOffset(): void {
      if (!window.matchMedia(MOBILE_QUERY).matches) {
        document.documentElement.style.removeProperty("--map-controls-bottom");
        return;
      }
      const filtersHeight = root!.getBoundingClientRect().height;
      const offset =
        FILTERS_BOTTOM_OFFSET + filtersHeight + CONTROLS_GAP_ABOVE_FILTERS;
      document.documentElement.style.setProperty(
        "--map-controls-bottom",
        `${offset}px`,
      );
    }

    function applyCollapsedState(): void {
      const isMobile = window.innerWidth < 768;

      if (isMobile) {
        root!.classList.remove("-translate-x-full");
        root!.classList.add("translate-x-0");
        if (collapsed) {
          content?.classList.add("hidden");
        } else {
          content?.classList.remove("hidden");
        }
        headerTrigger?.setAttribute("aria-expanded", String(!collapsed));
        headerTrigger?.querySelector("svg")?.classList.toggle("-rotate-90", collapsed);
      } else {
        content?.classList.remove("hidden");
        if (collapsed) {
          root!.classList.add("-translate-x-full");
          root!.classList.remove("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "false");
          if (toggleIcon) toggleIcon.style.transform = "rotate(180deg)";
        } else {
          root!.classList.remove("-translate-x-full");
          root!.classList.add("translate-x-0");
          toggleBtn?.setAttribute("aria-expanded", "true");
          if (toggleIcon) toggleIcon.style.transform = "rotate(0deg)";
        }
      }
    }

    function handleResize() {
      applyCollapsedState();
      updateControlsOffset();
    }

    const controlsResizeObserver = new ResizeObserver(() =>
      updateControlsOffset(),
    );
    controlsResizeObserver.observe(root);
    window.addEventListener("resize", handleResize);

    filterCleanups.push(() => {
      controlsResizeObserver.disconnect();
      window.removeEventListener("resize", handleResize);
    });

    // Exclusive Accordion Logic
    const accordionSections = document.querySelectorAll(
      ".mf-accordion-section",
    );
    accordionSections.forEach((section) => {
      const trigger = section.querySelector(
        ".mf-accordion-trigger",
      ) as HTMLButtonElement | null;
      const contentWrapper = section.querySelector(
        ".mf-accordion-content",
      ) as HTMLElement | null;

      if (!trigger || !contentWrapper) return;

      const onTriggerClick = () => {
        const isOpening = trigger.getAttribute("aria-expanded") === "false";

        accordionSections.forEach((s) => {
          const t = s.querySelector(
            ".mf-accordion-trigger",
          ) as HTMLButtonElement | null;
          const c = s.querySelector(
            ".mf-accordion-content",
          ) as HTMLElement | null;
          if (t && c) {
            t.setAttribute("aria-expanded", "false");
            c.classList.remove("grid-rows-[1fr]");
            c.classList.add("grid-rows-[0fr]");
            t.querySelector("svg")?.classList.add("-rotate-90");
          }
        });

        if (isOpening) {
          trigger.setAttribute("aria-expanded", "true");
          contentWrapper.classList.remove("grid-rows-[0fr]");
          contentWrapper.classList.add("grid-rows-[1fr]");
          trigger.querySelector("svg")?.classList.remove("-rotate-90");
        }

        setTimeout(updateControlsOffset, 200);
      };

      trigger.addEventListener("click", onTriggerClick);
      filterCleanups.push(() =>
        trigger.removeEventListener("click", onTriggerClick),
      );
    });

    const onHeaderTriggerClick = () => {
      if (window.innerWidth < 768) {
        collapsed = !collapsed;
        try {
          localStorage.setItem(STORAGE_KEY, String(collapsed));
        } catch {}
        applyCollapsedState();
        updateControlsOffset();
      }
    };
    headerTrigger?.addEventListener("click", onHeaderTriggerClick);
    filterCleanups.push(() =>
      headerTrigger?.removeEventListener("click", onHeaderTriggerClick),
    );

    const onToggleClick = () => {
      collapsed = !collapsed;
      try {
        localStorage.setItem(STORAGE_KEY, String(collapsed));
      } catch {}
      applyCollapsedState();
    };
    toggleBtn?.addEventListener("click", onToggleClick);
    filterCleanups.push(() =>
      toggleBtn?.removeEventListener("click", onToggleClick),
    );

    function dispatchFilterChange(): void {
      const statuses = getActiveStatuses();
      const minMW = mwSlider ? Number(mwSlider.value) : 0;
      const showProtectedLands = protectedToggle
        ? protectedToggle.checked
        : false;

      if (countLabel) {
        const visibleCount = clientProjects.filter((p) => {
          const status = p.status || "planned";
          return (
            statuses.includes(status) && parseMW(p.powerCapacityMW) >= minMW
          );
        }).length;
        countLabel.textContent = `Showing ${visibleCount} of ${totalCount}`;
      }

      document.dispatchEvent(
        new CustomEvent("mapfilterchange", {
          detail: { statuses, minMW, showProtectedLands },
        }),
      );
    }

    function getActiveStatuses(): string[] {
      return checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);
    }

    checkboxes.forEach((checkbox) => {
      const onChange = () => dispatchFilterChange();
      checkbox.addEventListener("change", onChange);
      filterCleanups.push(() =>
        checkbox.removeEventListener("change", onChange),
      );
    });

    const onSelectAll = () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      dispatchFilterChange();
    };
    selectAllBtn?.addEventListener("click", onSelectAll);
    filterCleanups.push(() =>
      selectAllBtn?.removeEventListener("click", onSelectAll),
    );

    const onClearAll = () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      dispatchFilterChange();
    };
    clearAllBtn?.addEventListener("click", onClearAll);
    filterCleanups.push(() =>
      clearAllBtn?.removeEventListener("click", onClearAll),
    );

    const onMwInput = () => {
      if (mwLabel) mwLabel.textContent = `${mwSlider!.value} MW`;
      dispatchFilterChange();
    };
    mwSlider?.addEventListener("input", onMwInput);
    filterCleanups.push(() =>
      mwSlider?.removeEventListener("input", onMwInput),
    );

    const onProtectedChange = () => dispatchFilterChange();
    protectedToggle?.addEventListener("change", onProtectedChange);
    filterCleanups.push(() =>
      protectedToggle?.removeEventListener("change", onProtectedChange),
    );

    projectLinks.forEach((link) => {
      const onProjectClick = () => {
        const name = link.dataset.projectName;
        const project = clientProjects.find((p) => p.name === name);
        if (!project) return;
        document.dispatchEvent(
          new CustomEvent("mapmarkerselect", { detail: { project } }),
        );
      };
      link.addEventListener("click", onProjectClick);
      filterCleanups.push(() =>
        link.removeEventListener("click", onProjectClick),
      );
    });

    applyCollapsedState();
  }

  document.addEventListener("astro:page-load", initMapFilters);
  if (document.readyState !== "loading") {
    initMapFilters();
  } else {
    document.addEventListener("DOMContentLoaded", initMapFilters);
  }
</script>