---
// src/components/map/MapDetailParent.astro
//
// Full project detail, opened when a marker is clicked (see MapParent.astro's
// `mapmarkerselect` dispatch). Listens for a `mapmarkerselect` CustomEvent on
// `document` with `{ project } | null` — `null` closes the panel.
//
// Styling mirrors MapFilterParent.astro: a `.band` header with an accent icon
// chip over a --panel body, hairline borders throughout. Desktop: a right-edge
// sidebar (MapFilterParent.astro is the left-edge counterpart).
// Mobile: a bottom sheet, and while it's open it is the only panel on screen —
// MapFilterParent.astro steps aside and NewsFeedParent.astro hides, rather than
// the sheet being stacked on top of them. Tapping outside, hitting Escape, or
// clicking empty map all close it.
import { Building2 } from 'lucide-astro';
---

<!--
  Starts `hidden`; `open()` swaps that for `flex` (see the script below).
  The panel being a flex column is load-bearing, not decoration — laid out as
  `display: block` the `flex-1` on `#mdp-content` resolves against nothing, so
  the panel's own `overflow-hidden` *clips* a long facility record instead of
  letting it scroll. Worst on desktop, where `top-0 bottom-0` pins the height.
-->
<!--
  `bottom-(--mobile-toolbar-h)`: the phone layout's toolbar is fixed to the
  bottom edge, so this sheet docks to the top of it rather than under it. The
  variable is published by MobileToolbar.astro from its own measured height —
  it isn't a constant, because the ticker row appears only once there's a
  headline and the safe-area padding is whatever the device reports. It falls
  back to 0px, which is what desktop uses and what a phone shows for the frame
  before the toolbar has measured itself.
-->
<div
  id="map-detail-panel"
  class="hidden pointer-events-auto font-sans absolute z-40
         bottom-(--mobile-toolbar-h) inset-x-0 max-h-[78dvh] rounded-t-2xl translate-y-full
         md:inset-x-auto md:top-0 md:bottom-0 md:right-0 md:left-auto md:w-96 md:max-h-none md:rounded-none md:translate-y-0 md:translate-x-full
         bg-panel backdrop-blur-md border border-hair md:border-r-0
         shadow-2xl shadow-(color:--shadow-panel) flex-col overflow-hidden transition-transform duration-300 ease-out"
>
  <!-- Header: brand-consistent icon chip + title, in the same navy band as the
       news rail this panel slides in over (see global.css) — the two share the
       right edge, so they have to be headed the same way. -->
  <div class="band bg-panel flex items-center gap-2.5 px-3.5 py-3 md:px-4 md:py-3.5 shrink-0 min-w-0 border-b border-hair">
    <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-hover shrink-0">
      <Building2 size={14} stroke-width={2} class="text-accent" />
    </div>
    <div class="min-w-0 flex-1">
      <h4 class="text-[9px] md:text-[10px] font-bold text-ink-4 uppercase tracking-wider leading-none whitespace-nowrap">
        Facility Detail
      </h4>
      <p id="mdp-title" class="text-[10.5px] md:text-[11.5px] font-semibold text-ink mt-1 leading-none truncate">
        &nbsp;
      </p>
    </div>
    <button
      id="mdp-close"
      type="button"
      aria-label="Close detail panel"
      class="w-7 h-7 flex items-center justify-center rounded-full text-ink-3 hover:text-ink hover:bg-hover transition shrink-0 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <!--
    One scroller, two children that are filled by different owners.

    `#mdp-content` is rewritten wholesale on every open (`innerHTML`), so
    anything that has to survive that has to be its sibling rather than its
    child — which is what `#mdp-cta` is. MapParent.astro parks the campaign
    action block there on phones instead of floating it in a MapLibre popup
    over this sheet; see the note on `openCampaignPopup`.

    The white surface is not decoration: that block is styled fixed
    dark-on-white for the popup it normally lives in (see MapDetailCta.astro),
    so on the dark theme it would be near-black type on a near-black panel
    anywhere else. `empty:hidden` keeps the box from appearing as a bare white
    strip when no block is parked in it — which is always, on desktop.
  -->
  <div id="mdp-scroll" class="flex-1 min-h-0 overflow-y-auto p-3">
    <div id="mdp-content"></div>
    <div id="mdp-cta" class="md:hidden empty:hidden mt-3 rounded-xl border border-neutral-200 bg-white p-3"></div>
  </div>
</div>

<script>
  import { onReady } from '~/lib/domReady';
  import { buildDetailHtml } from '~/lib/mapMarkers';
  import { hydrateRatepayerWidget } from '~/lib/ratepayerWidget';
  import type { Project } from '~/data/dataCenters';

  // `onReady` re-runs init after every Astro navigation (see domReady.ts), and
  // two of the listeners below are on `document`, which outlives one. Dropping
  // the previous set first is what keeps a second run from stacking a duplicate
  // that would open this panel twice per selection — every other island on the
  // page already does this.
  let detailCleanups: (() => void)[] = [];

  function initDetailPanel(): void {
    const panel = document.getElementById('map-detail-panel');
    const scroller = document.getElementById('mdp-scroll');
    const content = document.getElementById('mdp-content');
    const closeBtn = document.getElementById('mdp-close');
    const titleEl = document.getElementById('mdp-title');
    if (!panel || !content || !scroller) return;

    while (detailCleanups.length > 0) {
      detailCleanups.pop()?.();
    }

    // The pending half of `close()` — the panel is hidden a transition later,
    // not on the same tick, and until it fires this holds the handle to cancel
    // it with.
    //
    // Load-bearing, because a close and an open can overlap: selecting a
    // second facility within 300ms of any deselect (tapping one marker
    // straight after another, or after a click on empty map) used to leave the
    // first close's timer to land on the panel the second selection had just
    // opened. It put `hidden` back on a panel whose state said open, so the
    // record appeared and then vanished a third of a second later, and nothing
    // short of selecting again could bring it back.
    let hideTimer: number | null = null;

    const cancelHide = (): void => {
      if (hideTimer === null) return;
      window.clearTimeout(hideTimer);
      hideTimer = null;
    };
    detailCleanups.push(cancelHide);

    function open(project: Project): void {
      cancelHide();
      content!.innerHTML = buildDetailHtml(project);
      // The ratepayer widget's utilization slider is the only interactive
      // control in this markup. Rewiring it per open is deliberate: the
      // previous node — and its listener — is discarded by the innerHTML
      // assignment above, so there is nothing to clean up.
      hydrateRatepayerWidget(content!);
      if (titleEl) titleEl.textContent = project.name;
      panel!.classList.remove('hidden');
      panel!.classList.add('flex');
      // Every open starts at the top — the status and power figures are the
      // point, and a retained scroll position from the last facility would
      // drop the reader mid-record. On the scroller, not on `#mdp-content`,
      // which no longer scrolls itself now that the CTA slot shares the pane.
      scroller!.scrollTop = 0;
      // Next frame so the transition actually animates in from the hidden state.
      requestAnimationFrame(() => {
        panel!.classList.remove('translate-y-full', 'md:translate-x-full');
      });
    }

    function close(): void {
      panel!.classList.add('translate-y-full', 'md:translate-x-full');
      cancelHide();
      hideTimer = window.setTimeout(() => {
        hideTimer = null;
        panel!.classList.add('hidden');
        panel!.classList.remove('flex');
      }, 300);
      if (titleEl) titleEl.textContent = '\u00A0';
    }

    const onMarkerSelect = (event: Event) => {
      const detail = (event as CustomEvent<{ project: Project } | null>).detail;
      if (detail?.project) {
        open(detail.project);
      } else {
        close();
      }
    };
    document.addEventListener('mapmarkerselect', onMarkerSelect);
    detailCleanups.push(() =>
      document.removeEventListener('mapmarkerselect', onMarkerSelect),
    );

    const onCloseClick = () => {
      document.dispatchEvent(new CustomEvent('mapmarkerselect', { detail: null }));
    };
    closeBtn?.addEventListener('click', onCloseClick);
    detailCleanups.push(() =>
      closeBtn?.removeEventListener('click', onCloseClick),
    );

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && !panel!.classList.contains('hidden')) {
        document.dispatchEvent(new CustomEvent('mapmarkerselect', { detail: null }));
      }
    };
    document.addEventListener('keydown', onKeyDown);
    detailCleanups.push(() =>
      document.removeEventListener('keydown', onKeyDown),
    );
  }

  onReady(initDetailPanel);
</script>