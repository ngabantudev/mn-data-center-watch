---
// src/components/MapFilters.astro
import { clientProjects, type ProjectStatus } from '~/data/dataCenters';
import { STATUS_META } from '~/data/mapStatusMeta';

const countsByStatus = STATUS_META.reduce((acc, meta) => {
  acc[meta.status] = clientProjects.filter((p) => p.status === meta.status).length;
  return acc;
}, {} as Record<ProjectStatus, number>);

const totalCount = clientProjects.length;
---

<!--
  Collapsible facility filter sidebar — dark themed, deflock.org/Google-Maps style.
  - Mobile: anchored bottom-4 left-4 right-4, collapses down to a slim header bar.
    The toggle handle sits centered on the panel's TOP edge.
  - Desktop: a true left-edge sidebar (below the theme control), collapses to a narrow icon rail.
    The toggle handle sits centered on the panel's RIGHT edge, like Google Maps / deflock.org.
  Dispatches a `mapfilterchange` CustomEvent on `document` with `{ statuses: string[] }`
  whenever the active set of statuses changes, so Map.astro can show/hide markers.
-->
<div
  id="map-filters"
  data-total={totalCount}
  class="absolute z-10 pointer-events-auto font-sans bottom-4 left-4 right-4 md:right-auto md:top-20 md:bottom-6 md:left-6 w-auto md:w-64 bg-[#0a0a0f]/95 backdrop-blur-md border border-white/10 shadow-2xl shadow-black/60 rounded-xl flex flex-col overflow-visible transition-[width] duration-300 ease-out"
>
  <!-- Header: title + live count -->
  <div class="flex items-center gap-2 px-3 py-2.5 md:px-3.5 md:py-3 shrink-0 min-w-0">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="shrink-0 text-neutral-500" xmlns="http://www.w3.org/2000/svg">
      <path d="M4 5h16l-6 8v6l-4-2v-4L4 5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
    </svg>
    <div class="min-w-0">
      <h4 class="text-[9px] md:text-[10px] font-bold text-neutral-500 uppercase tracking-wider leading-none whitespace-nowrap">
        Facility Filters
      </h4>
      <p id="mf-count" class="text-[10px] md:text-[11px] font-semibold text-neutral-200 mt-0.5 leading-none whitespace-nowrap">
        Showing {totalCount} of {totalCount}
      </p>
    </div>
  </div>

  <!-- Compact rail: shown only while collapsed. Dots double as quick toggles. -->
  <div id="mf-compact" class="hidden flex-row md:flex-col items-center gap-2 px-3 pb-3 md:px-0 md:pb-3">
    {STATUS_META.map((meta) => (
      <button
        type="button"
        class="mf-dot relative flex items-center justify-center w-6 h-6 md:w-7 md:h-7 rounded-full hover:bg-white/10 transition"
        data-status={meta.status}
        aria-label={`Toggle ${meta.filterLabel}`}
        title={`${meta.filterLabel} (${countsByStatus[meta.status]})`}
      >
        <span class={`block w-2.5 h-2.5 rounded-full ${meta.color}`} />
      </button>
    ))}
  </div>

  <!-- Full content: checkbox list, shown while expanded -->
  <div id="mf-content" class="px-3 pb-3 md:px-3.5 md:pb-3.5 flex flex-col gap-2.5 border-t border-white/10 pt-2.5">
    <div class="flex items-center gap-2 text-[10px] font-semibold">
      <button id="mf-select-all" type="button" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">
        All
      </button>
      <span class="text-neutral-700">/</span>
      <button id="mf-clear-all" type="button" class="text-neutral-500 hover:text-neutral-300 underline underline-offset-2">
        None
      </button>
    </div>

    <div class="grid grid-cols-2 gap-2 md:flex md:flex-col md:gap-2.5">
      {STATUS_META.map((meta) => (
        <label class="mf-row flex items-start gap-2 md:gap-3 cursor-pointer transition-opacity">
          <input
            type="checkbox"
            class="mf-checkbox mt-0.5 w-3 h-3 md:w-3.5 md:h-3.5 rounded border-neutral-600 bg-neutral-800 shrink-0 cursor-pointer"
            style={`accent-color: ${meta.hex}`}
            value={meta.status}
            data-count={countsByStatus[meta.status]}
            checked
          />
          <div class="relative w-2.5 h-2.5 md:w-3 md:h-3 mt-0.5 shrink-0 flex items-center justify-center">
            {meta.activePulse && (
              <span class="absolute inline-flex h-full w-full rounded-full bg-[#f97316] opacity-75 animate-ping"></span>
            )}
            <span class={`relative inline-block w-2.5 h-2.5 md:w-3 md:h-3 rounded-full ${meta.color}`} />
          </div>
          <span class="flex flex-col min-w-0">
            <span class="text-[11px] md:text-xs font-semibold text-neutral-100 leading-none">
              {meta.filterLabel}
            </span>
            <span class="hidden md:flex items-center gap-1 text-[10px] text-neutral-500 font-medium mt-0.5 leading-tight">
              <span>{meta.description}</span>
              <span class="text-neutral-700">&middot;</span>
              <span class="font-semibold text-neutral-400">{countsByStatus[meta.status]}</span>
            </span>
          </span>
        </label>
      ))}
    </div>
  </div>

  <!--
    Edge-centered collapse handle.
    Mobile: straddles the TOP edge, centered horizontally.
    Desktop: straddles the RIGHT edge, centered vertically (Google Maps / deflock.org style).
  -->
  <button
    id="mf-toggle"
    type="button"
    aria-expanded="true"
    aria-controls="mf-content"
    aria-label="Toggle filters panel"
    class="absolute z-20 flex items-center justify-center bg-[#111116] border border-white/10 text-neutral-400 hover:text-neutral-100 hover:bg-[#17171d] shadow-lg shadow-black/50 transition
           top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-6 rounded-full
           md:top-1/2 md:left-auto md:right-0 md:translate-x-1/2 md:w-6 md:h-10 md:rounded-full"
  >
    <svg id="mf-toggle-icon-mobile" width="12" height="12" viewBox="0 0 24 24" fill="none" class="transition-transform duration-300 md:hidden" xmlns="http://www.w3.org/2000/svg">
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <svg id="mf-toggle-icon-desktop" width="12" height="12" viewBox="0 0 24 24" fill="none" class="hidden md:block transition-transform duration-300" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>

<script>
  const STORAGE_KEY = 'mapFiltersCollapsed';

  function initMapFilters(): void {
    const root = document.getElementById('map-filters');
    if (!root) return;

    const toggleBtn = document.getElementById('mf-toggle') as HTMLButtonElement | null;
    const toggleIconMobile = document.getElementById('mf-toggle-icon-mobile') as SVGElement | null;
    const toggleIconDesktop = document.getElementById('mf-toggle-icon-desktop') as SVGElement | null;
    const content = document.getElementById('mf-content') as HTMLElement | null;
    const compact = document.getElementById('mf-compact') as HTMLElement | null;
    const countLabel = document.getElementById('mf-count') as HTMLElement | null;
    const selectAllBtn = document.getElementById('mf-select-all');
    const clearAllBtn = document.getElementById('mf-clear-all');
    const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('.mf-checkbox'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.mf-dot'));

    const totalCount = Number(root.dataset.total || checkboxes.length);

    let collapsed = false;
    try {
      collapsed = localStorage.getItem(STORAGE_KEY) === 'true';
    } catch {
      // localStorage unavailable (e.g. private browsing) — default to expanded
    }

    function checkboxFor(status: string): HTMLInputElement | undefined {
      return checkboxes.find((cb) => cb.value === status);
    }

    // --- Keep the bottom-right control stack (MapThemeSelector + MapLibre's
    // NavigationControl, see global.css) above this panel on mobile. ---
    const MOBILE_QUERY = '(max-width: 767px)';
    const FILTERS_BOTTOM_OFFSET = 16; // matches the `bottom-4` Tailwind class on `root`
    const CONTROLS_GAP_ABOVE_FILTERS = 12;

    function updateControlsOffset(): void {
      if (!window.matchMedia(MOBILE_QUERY).matches) {
        // Desktop: filters live in the left sidebar, so just use the
        // default inset defined in global.css — no need to raise anything.
        document.documentElement.style.removeProperty('--map-controls-bottom');
        return;
      }
      const filtersHeight = root!.getBoundingClientRect().height;
      const offset = FILTERS_BOTTOM_OFFSET + filtersHeight + CONTROLS_GAP_ABOVE_FILTERS;
      document.documentElement.style.setProperty('--map-controls-bottom', `${offset}px`);
    }

    // Panel height changes whenever it's toggled collapsed/expanded, or if
    // its content reflows (e.g. text wrapping on resize) — ResizeObserver
    // catches all of these, not just the explicit toggle click.
    const controlsResizeObserver = new ResizeObserver(() => updateControlsOffset());
    controlsResizeObserver.observe(root);
    window.addEventListener('resize', updateControlsOffset);

    function syncRowOpacity(): void {
      checkboxes.forEach((cb) => {
        const row = cb.closest('.mf-row') as HTMLElement | null;
        if (row) row.style.opacity = cb.checked ? '1' : '0.4';
      });
    }

    function syncDots(): void {
      dots.forEach((dot) => {
        const status = dot.dataset.status;
        const cb = status ? checkboxFor(status) : undefined;
        dot.style.opacity = cb && !cb.checked ? '0.35' : '1';
      });
    }

    function emitChange(): void {
      const active = checkboxes.filter((cb) => cb.checked).map((cb) => cb.value);
      const activeCount = checkboxes.reduce(
        (sum, cb) => sum + (cb.checked ? Number(cb.dataset.count || 0) : 0),
        0
      );
      if (countLabel) countLabel.textContent = `Showing ${activeCount} of ${totalCount}`;
      syncRowOpacity();
      syncDots();
      document.dispatchEvent(new CustomEvent('mapfilterchange', { detail: { statuses: active } }));
    }

    function applyCollapsedState(): void {
      if (collapsed) {
        content?.classList.add('hidden');
        compact?.classList.remove('hidden');
        compact?.classList.add('flex');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        // Mobile handle points up (expand upward); desktop handle points right (expand rightward)
        toggleIconMobile?.style.setProperty('transform', 'rotate(180deg)');
        toggleIconDesktop?.style.setProperty('transform', 'rotate(0deg)');
        root?.classList.remove('md:w-64');
        root?.classList.add('md:w-14');
      } else {
        content?.classList.remove('hidden');
        compact?.classList.add('hidden');
        compact?.classList.remove('flex');
        toggleBtn?.setAttribute('aria-expanded', 'true');
        // Mobile handle points down (collapse downward); desktop handle points left (collapse leftward)
        toggleIconMobile?.style.setProperty('transform', 'rotate(0deg)');
        toggleIconDesktop?.style.setProperty('transform', 'rotate(180deg)');
        root?.classList.remove('md:w-14');
        root?.classList.add('md:w-64');
      }
    }

    toggleBtn?.addEventListener('click', () => {
      collapsed = !collapsed;
      try {
        localStorage.setItem(STORAGE_KEY, String(collapsed));
      } catch {
        // ignore persistence failures
      }
      applyCollapsedState();
      updateControlsOffset();
    });

    checkboxes.forEach((cb) => cb.addEventListener('change', emitChange));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const status = dot.dataset.status;
        const cb = status ? checkboxFor(status) : undefined;
        if (cb) {
          cb.checked = !cb.checked;
          emitChange();
        }
      });
    });

    selectAllBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      emitChange();
    });

    clearAllBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      emitChange();
    });

    applyCollapsedState();
    emitChange();
    updateControlsOffset();
  }

  document.addEventListener('astro:page-load', initMapFilters);
  if (document.readyState !== 'loading') {
    initMapFilters();
  } else {
    document.addEventListener('DOMContentLoaded', initMapFilters);
  }
</script>