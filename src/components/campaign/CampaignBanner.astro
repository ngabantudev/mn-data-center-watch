---
// src/components/campaign/CampaignBanner.astro
//
// The statewide half of the campaign: a collapsible "Statewide Campaign Goals"
// banner over the map, listing the data center bills before the legislature
// with live status from Open States, plus a two-action center (email your
// legislator, comment to the PUC).
//
// Deliberately separate from MapDetailCta.astro. That block is *per-facility*
// and lives in the marker popup — it answers "what do I do about this site".
// This one is page-level and answers "what are we fighting for statewide", so
// it must be reachable without selecting a marker first.
//
// The bill list is not authored here or anywhere else in the repo. It is
// discovered per-request from /api/legislation, which searches the running
// session for the phrase "data center" — so this markup is a shell and every
// bill in it arrives at runtime.
import {
  Landmark,
  ChevronDown,
  Megaphone,
  Mail,
  MessageSquareText,
  ExternalLink,
  MapPin,
  Radar,
  X,
} from "lucide-astro";
import {
  MN_REVISOR_SEARCH_URL,
  PUC_COMMENT_URL,
  PUC_EDOCKETS_URL,
} from "~/data/legislation";
---

<!--
  Placement: top-centre of the map area. On desktop it's inset past both rails
  (18rem filters left, 24rem news right) so it never sits on top of either. On
  mobile the news card owns the very top, so NewsFeedParent.astro drops to
  top-16 to leave this collapsed pill the first row — see the note there.
-->
<div
  id="campaign-banner"
  class="fixed md:absolute top-3 left-4 right-4 mx-auto max-w-sm md:mx-0 md:left-76 md:right-100 md:max-w-md z-55 pointer-events-auto font-sans"
>
  <button
    id="cb-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="cb-panel"
    class="group w-full flex items-center gap-2 px-3.5 py-2 rounded-xl bg-panel/95 backdrop-blur-md border border-hair shadow-2xl shadow-(color:--shadow-panel) hover:bg-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
  >
    <Landmark size={14} class="shrink-0 text-accent" />
    <span
      class="text-[10px] font-bold uppercase tracking-wider text-ink-2 group-hover:text-ink truncate"
      >Statewide Campaign Goals</span
    >
    <ChevronDown
      id="cb-chevron"
      size={14}
      class="ml-auto shrink-0 text-ink-4 group-hover:text-ink-2 transition-transform duration-200 -rotate-90"
    />
  </button>

  <div
    id="cb-panel"
    class="hidden mt-2 rounded-xl bg-panel/95 backdrop-blur-md border border-hair shadow-2xl shadow-(color:--shadow-panel) overflow-hidden"
  >
    <div class="px-3.5 py-3 border-b border-hair">
      <p id="cb-intro" class="text-[11px] text-ink-3 leading-snug">
        Every data center bill before the Minnesota Legislature, pulled live
        from Open States.
      </p>
    </div>

    <!--
      Where every bill stands, in three numbers.

      Shown even when a count is zero, because the zero is the finding: "0
      Passed" next to two dozen proposed is the single most informative thing
      on this panel, and hiding empty groups would quietly delete it.
    -->
    <div
      id="cb-summary"
      class="flex items-stretch gap-1.5 px-3.5 py-2.5 border-b border-hair"
      aria-label="Bill counts by stage"
    ></div>

    <!--
      Chamber filter. Same pill affordance as the news panel's date ranges, so
      it's an interaction already established elsewhere on the page rather than
      a new one to learn.
    -->
    <div
      id="cb-chamber-group"
      role="group"
      aria-label="Filter bills by chamber"
      class="flex items-center gap-1.5 px-3.5 py-2 border-b border-hair"
    ></div>

    <!-- One scroll container for all three groups below, so the panel keeps a
         predictable height however many bills the search turns up. -->
    <div class="max-h-80 overflow-y-auto">
      <!-- Blindspots: bills that moved without saying "data center" in their
           title. Rendered above the main list because they are the ones a
           search for "data center bills" would never surface. -->
      <section id="cb-blindspot-wrap" class="hidden px-3.5 py-3 border-b border-hair">
        <h3
          class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider text-accent"
        >
          <Radar size={12} /> Blindspots
        </h3>
        <p class="mt-1 text-[10px] text-ink-4 leading-snug">
          These change the rules for data centers without naming them in the
          title.
        </p>
        <div id="cb-blindspots" class="mt-2 space-y-2"></div>
      </section>

      <div id="cb-bills" class="px-3.5 py-3 space-y-2">
        <p class="text-[11px] text-ink-4">Loading bills…</p>
      </div>

      <!-- The long tail: matched the phrase somewhere in the text, never
           moved. Collapsed because most of it is cross-references in unrelated
           tax bills, and presenting that as "data center legislation" would be
           the same overreach the tiering exists to avoid. -->
      <details id="cb-more" class="hidden border-t border-hair">
        <summary
          class="cursor-pointer px-3.5 py-2 text-[10px] font-semibold uppercase tracking-wider text-ink-3 hover:text-ink"
        >
          <span id="cb-more-label"></span>
        </summary>
        <div id="cb-mentions" class="px-3.5 pb-3 space-y-2"></div>
      </details>
    </div>

    <div class="px-3.5 py-3 border-t border-hair flex flex-wrap gap-2">
      <button
        id="cb-action-open"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg bg-accent px-3 py-1.5 text-[11px] font-bold text-on-accent hover:bg-accent-hover transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
      >
        <Megaphone size={12} />
        Take action
      </button>
      <a
        href={MN_REVISOR_SEARCH_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-hair px-3 py-1.5 text-[11px] font-semibold text-ink-2 hover:bg-hover hover:text-ink transition-colors"
      >
        All bills <ExternalLink size={11} />
      </a>
    </div>
  </div>
</div>

<!--
  Native <dialog> rather than a hand-rolled overlay: it gives us the top layer,
  focus trapping, Esc-to-close, and inert background for free, none of which is
  worth reimplementing for one modal.

  Centring is spelled out rather than inherited. The UA stylesheet centres a
  modal with `margin: auto` against `inset-block: 0`, but Tailwind's preflight
  zeroes margin on every element — dialog included — so the default lands the
  panel against the top edge. `inset-0 m-auto` with a fit height puts it back
  in the middle on both axes.

  Height is capped in dvh and the body scrolls inside it, so on a short or
  keyboard-shrunk mobile viewport the header and close button stay reachable
  instead of the whole panel running off-screen.

  `open:flex`, not `flex`: an author `display: flex` outranks the UA's
  `dialog:not([open]) { display: none }` and would leave the modal on screen
  permanently.
-->
<dialog
  id="cb-action"
  class="font-sans fixed inset-0 m-auto open:flex h-fit max-h-[92dvh] w-[min(32rem,92vw)] flex-col overflow-hidden rounded-2xl border border-hair bg-panel p-0 text-ink backdrop:bg-black/50 backdrop:backdrop-blur-sm"
>
  <div class="shrink-0 flex items-start justify-between gap-3 px-4 py-3.5 border-b border-hair">
    <div>
      <h2 class="text-sm font-bold text-ink">Take action</h2>
      <p class="text-[11px] text-ink-3 mt-0.5">
        Two ways to put this on the record in St. Paul.
      </p>
    </div>
    <button
      id="cb-action-close"
      type="button"
      aria-label="Close"
      class="shrink-0 rounded-lg p-1 text-ink-4 hover:text-ink hover:bg-hover transition-colors"
    >
      <X size={16} />
    </button>
  </div>

  <div class="min-h-0 flex-1 px-4 py-4 space-y-5 overflow-y-auto">
    <section class="space-y-2">
      <h3 class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-ink-2">
        <Mail size={13} class="text-accent" /> Email your state legislators
      </h3>

      <div id="cb-reps" class="space-y-2">
        <p class="text-[11px] text-ink-4">Loading…</p>
      </div>

      <!--
        Location is opt-in, from this button and nowhere else. The panel used to
        ask on page load, which is both rude and pointless — reading a bill list
        doesn't depend on where the reader lives. See `requestLocation` below.
      -->
      <button
        id="cb-locate"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-lg border border-hair px-3 py-1.5 text-[11px] font-semibold text-ink-2 hover:bg-hover hover:text-ink transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"
      >
        <MapPin size={12} /> Use my location to find mine
      </button>
      <p class="text-[10px] text-ink-4 leading-snug">
        Only if you tap that. Rounded to about a kilometre before it leaves your
        browser, sent once to look up which district you're in, and not stored
        by us.
      </p>

      <details id="cb-preview" class="hidden rounded-lg border border-hair bg-(--well) px-3 py-2">
        <summary class="cursor-pointer text-[11px] font-semibold text-ink-2">
          Preview the draft — edit it before sending
        </summary>
        <p
          id="cb-preview-body"
          class="mt-2 whitespace-pre-wrap text-[11px] leading-relaxed text-ink-3"
        >
        </p>
      </details>

      <p class="text-[10px] text-ink-4 leading-snug">
        Offices weigh a constituent's own sentence far more heavily than
        identical mass mail. The draft opens in your mail app — please add
        yours.
      </p>
    </section>

    <section class="space-y-2 border-t border-hair pt-4">
      <h3 class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-ink-2">
        <MessageSquareText size={13} class="text-accent" /> Submit a public
        comment to the PUC
      </h3>

      <div id="cb-dockets" class="space-y-2"></div>

      <div class="flex flex-wrap gap-2 pt-1">
        <a
          href={PUC_COMMENT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg bg-positive px-3 py-1.5 text-[11px] font-bold text-on-positive hover:bg-positive-hover transition-colors"
        >
          Comment to the PUC <ExternalLink size={11} />
        </a>
        <a
          href={PUC_EDOCKETS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg border border-hair px-3 py-1.5 text-[11px] font-semibold text-ink-2 hover:bg-hover hover:text-ink transition-colors"
        >
          Browse eDockets <ExternalLink size={11} />
        </a>
      </div>

      <p class="text-[10px] text-ink-4 leading-snug">
        Anyone may comment on a docket before the Commission — you do not need
        to be a party to the case.
      </p>
    </section>
  </div>
</dialog>

<script>
  import {
    STAGE_INK,
    STAGE_META_BY_STAGE,
    STAGES_IN_ORDER,
  } from "~/data/billStageMeta";
  import { MN_LEG_DIRECTORY_URL } from "~/data/legislation";
  import {
    CHAMBER_LABEL,
    composeRepEmail,
    mailtoHref,
    relativeAge,
    sponsorLine,
  } from "~/lib/legislation";
  import type {
    BillStage,
    LegislationPayload,
    LegislatorsPayload,
    LegislatorView,
    LiveBill,
  } from "~/lib/legislation";

  const STORAGE_KEY = "cb-expanded";

  /** Decimal places kept from a coordinate before it leaves the browser —
   *  ~1km, matching COORD_PRECISION in ~/pages/api/legislators.ts. Districts
   *  are far larger than that, so nothing useful is lost. */
  const COORD_PRECISION = 2;

  /** How many bills the emailed draft lists. A constituent letter enumerating
   *  two dozen bills reads as a mailing list, not a constituent. */
  const EMAIL_BILL_LIMIT = 3;

  const root = document.getElementById("campaign-banner");
  if (root) {
    const toggle = document.getElementById("cb-toggle") as HTMLButtonElement;
    const chevron = document.getElementById("cb-chevron")!;
    const panel = document.getElementById("cb-panel")!;
    const introEl = document.getElementById("cb-intro")!;
    const summaryEl = document.getElementById("cb-summary")!;
    const chamberEl = document.getElementById("cb-chamber-group")!;
    const billsEl = document.getElementById("cb-bills")!;
    const blindspotWrap = document.getElementById("cb-blindspot-wrap")!;
    const blindspotsEl = document.getElementById("cb-blindspots")!;
    const moreEl = document.getElementById("cb-more")!;
    const moreLabel = document.getElementById("cb-more-label")!;
    const mentionsEl = document.getElementById("cb-mentions")!;
    const repsEl = document.getElementById("cb-reps")!;
    const docketsEl = document.getElementById("cb-dockets")!;
    const previewEl = document.getElementById("cb-preview")!;
    const previewBody = document.getElementById("cb-preview-body")!;
    const dialog = document.getElementById("cb-action") as HTMLDialogElement;

    let legislation: LegislationPayload | null = null;
    let legislators: LegislatorsPayload | null = null;
    /** Guards the lazy load so re-opening the panel doesn't refetch. Bill
     *  status moves on the order of days and the route is edge-cached for
     *  hours, so one fetch per page view is already generous. */
    let started = false;

    /** Everything below builds nodes and assigns textContent rather than
     *  innerHTML: bill titles, action descriptions and member names all come
     *  from a third-party API, and none of it is ours to trust as markup. */
    const el = (tag: string, cls?: string, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    };

    const CHIP =
      "shrink-0 rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide";

    /** Which chamber the list is narrowed to, or null for both. */
    let chamberFilter: string | null = null;

    /**
     * The coloured stage pill.
     *
     * The label is always present, never colour alone — that's what keeps the
     * red/green pair meaningful to a colourblind reader, and it's why the pill
     * carries a `title` spelling the stage out in full as well.
     */
    function stageChip(stage: BillStage) {
      const meta = STAGE_META_BY_STAGE[stage];
      const chip = el(
        "span",
        `${CHIP} ${meta.color} ${STAGE_INK}`,
        meta.label,
      );
      chip.title = meta.description;
      return chip;
    }

    /** Small outlined pill for the chamber, so House/Senate is scannable
     *  without reading the bill number. */
    function chamberChip(chamber: string) {
      return el("span", `${CHIP} border border-hair text-ink-3`, chamber);
    }

    /** The three-number summary. Renders every stage including the zeros. */
    function renderSummary(bills: LiveBill[]) {
      summaryEl.replaceChildren();

      for (const stage of STAGES_IN_ORDER) {
        const meta = STAGE_META_BY_STAGE[stage];
        const n = bills.filter((b) => b.stage === stage).length;

        const cell = el(
          "div",
          "flex-1 min-w-0 rounded-lg border border-hair px-2 py-1.5",
        );
        const head = el("div", "flex items-center gap-1.5");
        head.append(el("span", `h-2 w-2 shrink-0 rounded-full ${meta.color}`));
        head.append(
          el("span", "text-[13px] font-bold leading-none text-ink", String(n)),
        );
        cell.append(head);
        cell.append(
          el(
            "p",
            "mt-1 text-[9px] font-bold uppercase tracking-wide text-ink-3 truncate",
            meta.label,
          ),
        );
        cell.title = `${n} ${meta.label} — ${meta.description}`;
        summaryEl.append(cell);
      }
    }

    /** House / Senate pills, with counts, plus an "All" reset. */
    function renderChamberFilter(bills: LiveBill[]) {
      chamberEl.replaceChildren();

      const chambers = Array.from(
        new Set(bills.map((b) => b.chamber).filter((c): c is string => !!c)),
      ).sort();

      // One chamber (or none) means there is nothing to choose between, and a
      // filter with a single option is just clutter.
      if (chambers.length < 2) {
        chamberEl.classList.add("hidden");
        return;
      }
      chamberEl.classList.remove("hidden");

      const options: { label: string; value: string | null }[] = [
        { label: `All ${bills.length}`, value: null },
        ...chambers.map((c) => ({
          label: `${c} ${bills.filter((b) => b.chamber === c).length}`,
          value: c,
        })),
      ];

      for (const opt of options) {
        const active = chamberFilter === opt.value;
        const btn = el(
          "button",
          "text-[9px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border transition-colors " +
            (active
              ? "text-accent border-accent/30 bg-accent-soft"
              : "text-ink-4 border-hair hover:text-ink"),
          opt.label,
        ) as HTMLButtonElement;
        btn.type = "button";
        btn.setAttribute("aria-pressed", String(active));
        btn.addEventListener("click", () => {
          chamberFilter = opt.value;
          if (legislation) renderBills(legislation);
        });
        chamberEl.append(btn);
      }
    }

    function billCard(bill: LiveBill, highlight = false) {
      const card = el(
        "div",
        highlight
          ? "rounded-lg border border-hair-strong bg-accent-soft px-2.5 py-2"
          : "rounded-lg border border-hair px-2.5 py-2",
      );

      const head = el("div", "flex items-center gap-1.5 flex-wrap");
      head.append(el("span", "text-[11px] font-bold text-accent", bill.identifier));
      head.append(stageChip(bill.stage));
      if (bill.chamber) head.append(chamberChip(bill.chamber));

      if (bill.stance) {
        head.append(
          el(
            "span",
            `${CHIP} bg-accent text-on-accent`,
            bill.stance.position === "oppose" ? "We oppose" : "Campaign priority",
          ),
        );
      }

      if (bill.url) {
        const a = el(
          "a",
          "ml-auto shrink-0 text-[10px] font-semibold text-ink-3 hover:text-ink underline",
          "Track",
        ) as HTMLAnchorElement;
        a.href = bill.url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        head.append(a);
      }
      card.append(head);

      // The live title, always. It is the bill's own description of itself and
      // the only summary here that nobody on this campaign wrote.
      card.append(el("p", "mt-1 text-[11px] text-ink-2 leading-snug", bill.title));

      if (bill.stance) {
        card.append(
          el(
            "p",
            "mt-1 text-[11px] font-semibold text-ink leading-snug",
            bill.stance.demand,
          ),
        );
      }

      for (const reason of bill.blindspots) {
        const row = el("p", "mt-1 text-[10px] font-semibold text-accent leading-snug");
        row.textContent = `⚠ ${reason}`;
        card.append(row);
      }

      const sponsors = sponsorLine(bill.sponsors);
      if (sponsors) {
        const line = bill.sponsors.primary
          ? `${bill.sponsors.primary} · ${sponsors}`
          : sponsors;
        card.append(el("p", "mt-1 text-[10px] text-ink-4 leading-snug", line));
      }

      // Verbatim, never paraphrased. "Author added Jones" is not progress and
      // the reader deserves to see that for themselves rather than take our
      // word for which rung the bill is on.
      if (bill.latestAction) {
        const date = bill.latestActionDate ? ` (${bill.latestActionDate})` : "";
        card.append(
          el(
            "p",
            "mt-1 text-[10px] text-ink-4 leading-snug",
            `Latest: ${bill.latestAction}${date}`,
          ),
        );
      }

      return card;
    }

    function renderIntro(payload: LegislationPayload) {
      if (payload.source === "unlinked") {
        introEl.textContent =
          "Live bill tracking is not configured on this deployment.";
        return;
      }
      if (payload.source === "degraded" || !payload.session) {
        introEl.textContent =
          "Could not reach Open States, and there's no earlier copy to fall back on — so no bill list is shown. An empty panel here means we don't know, not that the legislature is quiet.";
        return;
      }

      const s = payload.session;
      // State the adjournment date rather than concluding what it means for
      // any given bill. Bills do die at the end of a biennium, but saying so
      // for 43 bills at once is a claim about each of them.
      const when = s.adjourned
        ? `${s.name} adjourned ${s.endDate}.`
        : `${s.name} is in session.`;

      introEl.textContent =
        `${when} Bills containing “${payload.query}”: ${payload.totalMatched} matches, ` +
        `${payload.core.length} in title.` +
        (payload.truncated ? " List is partial." : "");

      // Say so, plainly and in the reader's terms, when this isn't current.
      // The alternative — showing a cached list as though it were live — is the
      // one failure mode that would make the tracker worth less than nothing.
      if (payload.source === "stale" && payload.fetchedAt) {
        const stamp = el(
          "span",
          "mt-1 block text-[10px] font-semibold text-accent",
          `Open States is unreachable — showing the list as fetched ${relativeAge(payload.fetchedAt, Date.now())}.`,
        );
        introEl.append(stamp);
      }
    }

    /** Heading for one stage group: colour, name, count. */
    function stageHeading(stage: BillStage, count: number) {
      const meta = STAGE_META_BY_STAGE[stage];
      const row = el(
        "div",
        "flex items-center gap-1.5 pt-1 first:pt-0 sticky top-0 bg-panel/95 backdrop-blur-md py-1 z-10",
      );
      row.append(el("span", `h-2 w-2 shrink-0 rounded-full ${meta.color}`));
      row.append(
        el(
          "h4",
          "text-[10px] font-bold uppercase tracking-wider text-ink-2",
          `${meta.label} · ${count}`,
        ),
      );
      row.append(
        el("span", "text-[9px] text-ink-4 truncate", meta.description),
      );
      return row;
    }

    function renderBills(payload: LegislationPayload) {
      renderIntro(payload);

      // Counts and the chamber filter describe the whole core set, never the
      // filtered view — otherwise clicking "House" would make the totals shrink
      // and the panel would look like bills had disappeared.
      renderSummary(payload.core);
      renderChamberFilter(payload.core);

      const inChamber = (b: LiveBill) =>
        chamberFilter === null || b.chamber === chamberFilter;

      const blindspots = payload.mentions.filter(
        (b) => b.blindspots.length > 0 && inChamber(b),
      );
      const quiet = payload.mentions.filter(
        (b) => b.blindspots.length === 0 && inChamber(b),
      );

      blindspotsEl.replaceChildren();
      blindspotWrap.classList.toggle("hidden", blindspots.length === 0);
      for (const bill of blindspots) blindspotsEl.append(billCard(bill, true));

      const core = payload.core.filter(inChamber);

      billsEl.replaceChildren();
      if (core.length === 0) {
        billsEl.append(
          el(
            "p",
            "text-[11px] text-ink-4 leading-snug",
            payload.source !== "live"
              ? "No bills to show."
              : chamberFilter
                ? `No ${chamberFilter} bill in this session names data centers in its title.`
                : "No bill in this session names data centers in its title.",
          ),
        );
      }

      // Grouped by stage, most consequential first. Empty groups are skipped
      // here — the summary strip above already reports their zero, so there's
      // no need for an empty heading to say it twice.
      for (const stage of STAGES_IN_ORDER) {
        const group = core.filter((b) => b.stage === stage);
        if (group.length === 0) continue;
        billsEl.append(stageHeading(stage, group.length));
        for (const bill of group) billsEl.append(billCard(bill));
      }

      mentionsEl.replaceChildren();
      moreEl.classList.toggle("hidden", quiet.length === 0);
      if (quiet.length > 0) {
        moreLabel.textContent = `Also mentions data centers (${quiet.length})`;
        for (const bill of quiet) mentionsEl.append(billCard(bill));
      }

      docketsEl.replaceChildren();
      for (const d of payload.dockets) {
        const card = el("div", "rounded-lg border border-hair px-3 py-2");
        card.append(el("p", "text-[11px] font-bold text-ink", `Docket ${d.docket}`));
        card.append(el("p", "text-[10px] text-ink-4 leading-snug", d.title));
        card.append(el("p", "mt-1 text-[11px] text-ink-2 leading-snug", d.ask));
        docketsEl.append(card);
      }
    }

    /** What the emailed draft should be about: the bills we've taken a public
     *  position on, and failing that the most recently active ones. */
    function emailBills(): LiveBill[] {
      const core = legislation?.core ?? [];
      const priorities = core.filter((b) => b.stance);
      return priorities.length > 0
        ? priorities
        : core.slice(0, EMAIL_BILL_LIMIT);
    }

    function repRow(rep: LegislatorView, bills: LiveBill[]) {
      const row = el(
        "div",
        "flex items-center justify-between gap-3 rounded-lg border border-hair px-3 py-2",
      );

      const info = el("div", "min-w-0");
      const party = rep.party ? ` (${rep.party})` : "";
      info.append(
        el("p", "truncate text-[11px] font-bold text-ink", `${rep.title} ${rep.name}${party}`),
      );
      const seat = [
        CHAMBER_LABEL[rep.chamber],
        rep.district ? `District ${rep.district}` : null,
      ]
        .filter(Boolean)
        .join(" · ");
      info.append(el("p", "truncate text-[10px] text-ink-4", seat));
      row.append(info);

      const href = mailtoHref(rep, bills);
      const link = el(
        "a",
        href
          ? "shrink-0 rounded-lg bg-accent px-2.5 py-1 text-[11px] font-bold text-on-accent hover:bg-accent-hover transition-colors"
          : "shrink-0 rounded-lg border border-hair px-2.5 py-1 text-[11px] font-semibold text-ink-2 hover:bg-hover hover:text-ink transition-colors",
        href ? "Email" : "Contact",
      ) as HTMLAnchorElement;

      if (href) {
        link.href = href;
      } else {
        // Not every member publishes an address — some only have a contact
        // form. Prefer the member's own form, then their Open States page,
        // rather than rendering a dead mailto.
        link.href = rep.contactUrl ?? rep.url ?? MN_LEG_DIRECTORY_URL;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      }
      row.append(link);

      return row;
    }

    /** A plain link to the state's own directory. The default, and on its own a
     *  complete answer to "who represents me" — it just costs a few more clicks
     *  than a district lookup would. */
    function directoryFallback(lead: string) {
      const p = el("p", "text-[11px] text-ink-4 leading-snug", `${lead} `);
      const a = el(
        "a",
        "font-semibold text-accent underline",
        "Look yours up at leg.mn.gov",
      ) as HTMLAnchorElement;
      a.href = MN_LEG_DIRECTORY_URL;
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      p.append(a);
      return p;
    }

    /**
     * The default state of the legislator section: no location requested, no
     * prompt raised, and a working way to find your representatives anyway.
     *
     * Nothing here touches navigator.geolocation. That is the whole point — see
     * the note on `requestLocation` below.
     */
    function renderRepsIdle() {
      repsEl.replaceChildren();
      previewEl.classList.add("hidden");

      if (legislators?.source === "unlinked") {
        repsEl.append(
          directoryFallback("District lookup isn't configured on this deployment."),
        );
        return;
      }

      repsEl.append(
        directoryFallback(
          "Every Minnesotan has one senator and one representative in St. Paul.",
        ),
      );
    }

    function renderReps() {
      const bills = emailBills();
      const found = legislators?.legislators ?? [];
      repsEl.replaceChildren();

      if (found.length === 0) {
        repsEl.append(
          directoryFallback(
            legislators?.source === "unlinked"
              ? "District lookup isn't configured on this deployment."
              : "That location didn't match a Minnesota district.",
          ),
        );
        previewEl.classList.add("hidden");
        return;
      }

      for (const rep of found) repsEl.append(repRow(rep, bills));

      previewBody.textContent = composeRepEmail(found[0]!, bills).body;
      previewEl.classList.remove("hidden");
    }

    /**
     * Asks the browser for coordinates — ONLY ever from a click handler.
     *
     * This used to run inside load(), which made it automatic in the worst way:
     * expanding the panel to read the bill list stored `cb-expanded=1`, and
     * every later visit then restored that state on page load and silently
     * re-raised the location prompt before the visitor had clicked anything.
     * Reading a list of bills has nothing to do with where someone lives.
     *
     * It also sat badly with this project's no-PII posture. We don't keep
     * request logs precisely so as not to hold IP addresses; asking unprompted
     * for something far more precise than an IP, to render a convenience, was
     * the same trade going the other way.
     *
     * Keep this reachable only from an explicit gesture. If a future change
     * needs coordinates somewhere else, that call site needs its own button.
     */
    function requestLocation(): Promise<{ lat: number; lng: number } | null> {
      return new Promise((resolve) => {
        if (!navigator.geolocation) return resolve(null);
        navigator.geolocation.getCurrentPosition(
          (pos) =>
            resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
          () => resolve(null),
          { timeout: 8000 },
        );
      });
    }

    async function findMyLegislators(btn: HTMLButtonElement) {
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = "Checking…";

      const point = await requestLocation();
      if (!point) {
        // Declined, dismissed, or unsupported. All three mean the same thing to
        // us, and none is an error worth scolding anyone about.
        btn.disabled = false;
        btn.textContent = original;
        renderRepsIdle();
        return;
      }

      // Round HERE, not just server-side.
      //
      // /api/legislators already rounds to 2dp before calling Open States, but
      // it was receiving full GPS precision in the query string first — which
      // is metre-level, and enough to identify a house. Districts are large;
      // ~1km is more than enough to place someone in one. Rounding in the
      // browser means the precise value never leaves the device at all, which
      // is what the note under the button promises.
      const lat = point.lat.toFixed(COORD_PRECISION);
      const lng = point.lng.toFixed(COORD_PRECISION);

      try {
        const res = await fetch(`/api/legislators?lat=${lat}&lng=${lng}`);
        if (res.ok) legislators = await res.json();
      } catch {
        // renderReps falls back to the directory link.
      }

      btn.disabled = false;
      btn.textContent = original;
      renderReps();
    }

    /** Loads the bill list. Deliberately does NOT touch location. */
    async function load() {
      if (started) return;
      started = true;

      try {
        const res = await fetch("/api/legislation");
        if (res.ok) legislation = await res.json();
      } catch {
        // Leave the loading row replaced by the message below.
      }

      if (legislation) {
        renderBills(legislation);
      } else {
        billsEl.replaceChildren(
          el("p", "text-[11px] text-ink-4", "Could not load the bill list."),
        );
      }

      renderRepsIdle();
    }

    function setExpanded(next: boolean) {
      panel.classList.toggle("hidden", !next);
      chevron.classList.toggle("-rotate-90", !next);
      toggle.setAttribute("aria-expanded", String(next));
      try {
        localStorage.setItem(STORAGE_KEY, next ? "1" : "0");
      } catch {
        // Private-mode storage failures shouldn't break the toggle.
      }
      if (next) load();
    }

    toggle.addEventListener("click", () => {
      setExpanded(panel.classList.contains("hidden"));
    });

    // Click anywhere off the banner collapses it. It floats over the map, so
    // leaving it open swallows clicks on the markers underneath.
    //
    // The take-action modal is a sibling of the banner, not a descendant, so a
    // click inside it — or on its backdrop, which reports the <dialog> itself
    // as the target — would otherwise read as "outside" and close the panel
    // behind it. `dialog.contains` covers both, and unlike a `dialog.open`
    // check it doesn't depend on whether the dialog's own handler ran first.
    document.addEventListener("click", (event) => {
      if (panel.classList.contains("hidden")) return;
      const target = event.target as Node;
      if (root.contains(target) || dialog.contains(target)) return;
      setExpanded(false);
    });

    document.getElementById("cb-action-open")!.addEventListener("click", () => {
      load();
      dialog.showModal();
    });

    // The only path to navigator.geolocation in this component. A click, every
    // time — nothing restores it from storage and nothing calls it on load.
    const locateBtn = document.getElementById("cb-locate") as HTMLButtonElement;
    locateBtn.addEventListener("click", () => {
      void findMyLegislators(locateBtn);
    });
    document.getElementById("cb-action-close")!.addEventListener("click", () => {
      dialog.close();
    });
    // Click-outside-to-close: the ::backdrop registers as a click on the
    // dialog element itself, so compare against the content box.
    dialog.addEventListener("click", (event) => {
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) dialog.close();
    });

    // Restore the stored preference after first paint rather than inlining it
    // into the markup — the page is prerendered, so the served HTML is shared
    // by every visitor and can't carry one visitor's choice.
    let restored = false;
    try {
      restored = localStorage.getItem(STORAGE_KEY) === "1";
    } catch {
      restored = false;
    }
    if (restored) setExpanded(true);
  }
</script>
