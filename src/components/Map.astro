---
// src/components/Map.astro
import { clientProjects } from '~/data/projects';
import MapLegend from './MapLegend.astro';
---

<section class="relative w-full h-dvh overflow-hidden bg-[#f4f4f5]">
  <!-- Top Left Theme Controller -->
  <div class="absolute top-3 left-3 md:top-4 md:left-4 z-10 bg-white/90 backdrop-blur-sm border border-neutral-200 shadow-lg rounded-xl p-1.5 md:p-2 flex flex-col gap-1 pointer-events-auto">
    <label for="map-style-select" class="text-[9px] md:text-[10px] font-bold text-neutral-400 uppercase tracking-wider px-1">Map Theme</label>
    <select 
      id="map-style-select" 
      class="bg-neutral-50 text-[11px] md:text-xs font-semibold text-neutral-800 border border-neutral-200 rounded-lg px-2 py-1 md:py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer min-w-28 md:min-w-32.5"
    >
      <option value="https://tiles.openfreemap.org/styles/fiord">Fiord (Muted)</option>
      <option value="https://tiles.openfreemap.org/styles/liberty">Liberty (Google Maps)</option>
      <option value="https://tiles.openfreemap.org/styles/positron">Light Minimal</option>
      <option value="https://tiles.openfreemap.org/styles/dark" selected>Dark Mode</option>
    </select>
  </div>

  <!-- Bottom Left Interactive Legend -->
  <MapLegend />

  <div class="relative w-full h-full">
    <div id="map" class="absolute inset-0 w-full h-full bg-[#f4f4f5]"></div>
  </div>
</section>

<style is:global>
  /* 1. Core glow dissolving smoothly */
  @keyframes pin-bottom-glow {
    0% { transform: translate(-50%, -50%) scale(0.2); opacity: 0.85; }
    40% { opacity: 0.6; }
    100% { transform: translate(-50%, -50%) scale(2.8); opacity: 0; }
  }

  /* 2. Concentric sharp ring fading completely outward */
  @keyframes pin-bottom-ripple {
    0% { transform: translate(-50%, -50%) scale(0.1); opacity: 0.95; }
    50% { opacity: 0.45; }
    100% { transform: translate(-50%, -50%) scale(3.8); opacity: 0; }
  }

  .custom-map-pin {
    overflow: visible !important;
  }

  .pin-icon-wrapper {
    position: relative;
    overflow: visible !important;
    width: 24px;
    height: 24px;
  }

  .construction-pulse-marker::before {
    content: ''; position: absolute; width: 20px; height: 20px; top: 90%; left: 50%;
    transform: translate(-50%, -50%); background-color: rgba(249, 115, 22, 0.4); border-radius: 50%; z-index: -1;
    animation: pin-bottom-glow 2.6s cubic-bezier(0.1, 0.8, 0.2, 1) infinite; pointer-events: none;
  }

  .construction-pulse-marker::after {
    content: ''; position: absolute; width: 20px; height: 20px; top: 90%; left: 50%;
    transform: translate(-50%, -50%); border: 1.5px solid rgba(249, 115, 22, 0.75); border-radius: 50%; z-index: -1;
    animation: pin-bottom-ripple 2.6s cubic-bezier(0.1, 0.8, 0.2, 1) infinite; animation-delay: 0.15s; pointer-events: none;
  }

  /* Structural protection for map popups */
  .maplibregl-popup {
    z-index: 50 !important;
    pointer-events: none;
  }

  .maplibregl-popup-content {
    border-radius: 12px !important;
    padding: 12px !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    pointer-events: auto !important;
    max-width: calc(100vw - 32px) !important;
    box-sizing: border-box !important;
  }

  @media (max-height: 500px) {
    .maplibregl-popup-content {
      max-height: 220px !important;
      overflow-y: auto !important;
    }
  }
</style>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css'; 
  import { clientProjects } from '~/data/projects';

  const MINNESOTA_CENTER: [number, number] = [-93.2650, 44.9778];
  const DEFAULT_ZOOM = window.innerWidth < 768 ? 5.8 : 7; 

  const STATUS_COLORS = {
    active: '#10b981',       
    construction: '#f97316', 
    planned: '#3b82f6',      
    paused: '#f59e0b',       
    rejected: '#ef4444'      
  };

  const STATUS_LABELS = {
    active: 'Operational Site',
    construction: 'Under Active Construction',
    planned: 'Proposed / Planned',
    paused: 'Development Paused',
    rejected: 'Rejected / Withdrawn'
  };

  function initMap(): void {
    const mapElement = document.getElementById('map');
    const styleSelector = document.getElementById('map-style-select') as HTMLSelectElement | null;
    if (!mapElement) return;

    const initialStyle = styleSelector?.value || 'https://tiles.openfreemap.org/styles/dark';

    const map = new maplibregl.Map({
      container: 'map',
      style: initialStyle, 
      center: MINNESOTA_CENTER,
      zoom: DEFAULT_ZOOM,
      scrollZoom: true,
      attributionControl: false,
      cooperativeGestures: window.innerWidth < 768 
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');
    
    map.on('load', () => {
      setTimeout(() => map.resize(), 100);
    });

    if (styleSelector) {
      styleSelector.addEventListener('change', (event) => {
        const targetStyle = (event.target as HTMLSelectElement).value;
        map.setStyle(targetStyle);
      });
    }

    let activePopup: maplibregl.Popup | null = null;
    let closeTimer: number | null = null;

    if (Array.isArray(clientProjects)) {
      clientProjects.forEach((project, index) => {
        if (!project.coordinates) return;
        const coords: [number, number] = [project.coordinates[1], project.coordinates[0]];
        const popupId = `dc-${index}`;
        
        const currentStatus = project.status || 'planned';
        const markerColor = STATUS_COLORS[currentStatus];
        const statusText = STATUS_LABELS[currentStatus];

        const el = document.createElement('div');
        el.className = 'custom-map-pin';
        el.innerHTML = `
          <div class="pin-icon-wrapper ${currentStatus === 'construction' ? 'construction-pulse-marker' : ''}">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="${markerColor}"/>
            </svg>
          </div>
        `;

        const marker = new maplibregl.Marker({ element: el })
          .setLngLat(coords)
          .addTo(map);

        function showPopup() {
          if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
          if (activePopup) { activePopup.remove(); }

          const pixel = map.project(coords);
          const width = map.getContainer().clientWidth;
          const height = map.getContainer().clientHeight;

          const verticalAnchor = pixel.y < height / 2 ? 'top' : 'bottom';
          const horizontalAnchor = pixel.x < width / 2 ? 'left' : 'right';
          const calculatedAnchor = `${verticalAnchor}-${horizontalAnchor}` as any;

          const metricsHtml = `
            ${project.estimatedCost ? `
              <div class="flex justify-between items-center text-[11px] border-b border-neutral-100 pb-1 mb-1">
                <span class="text-neutral-400 font-medium">Est. Cost:</span>
                <span class="font-bold text-neutral-800">${project.estimatedCost}</span>
              </div>
            ` : ''}
            ${project.powerCapacityMW ? `
              <div class="flex justify-between items-center text-[11px] border-b border-neutral-100 pb-1 mb-1">
                <span class="text-neutral-400 font-medium">Power Grid Draw:</span>
                <span class="font-bold text-neutral-800">${project.powerCapacityMW}</span>
              </div>
            ` : ''}
            ${project.waterFootprint ? `
              <div class="flex flex-col text-[11px]">
                <span class="text-neutral-400 font-medium">Water System Footprint:</span>
                <span class="font-semibold text-neutral-700 mt-0.5 leading-tight">${project.waterFootprint}</span>
              </div>
            ` : ''}
          `;

          const publicRecordHtml = project.publicRecord ? `
            <div class="mt-2 pt-2 border-t border-dashed border-neutral-200">
              <span class="block text-[9px] text-neutral-400 font-bold uppercase tracking-wider mb-1">Official Registry</span>
              <a href="${project.publicRecord.url}" target="_blank" rel="noopener noreferrer" class="text-[11px] font-medium text-blue-600 hover:text-blue-800 hover:underline inline-flex items-center gap-1">
                📄 ${project.publicRecord.title} &rarr;
              </a>
            </div>
          ` : '';

          activePopup = new maplibregl.Popup({ 
            offset: [horizontalAnchor === 'left' ? 12 : -12, verticalAnchor === 'top' ? 12 : -12],
            closeButton: window.innerWidth < 768, 
            anchor: calculatedAnchor,
            maxWidth: window.innerWidth < 768 ? '240px' : '310px' 
          }).setHTML(`
            <div id="container-${popupId}" class="p-0.5 text-neutral-900 font-sans max-h-[45vh] sm:max-h-[55vh] overflow-y-auto overflow-x-hidden select-text">
              <div class="flex items-center gap-2 mb-1">
                <span class="inline-block w-2 h-2 rounded-full" style="background-color: ${markerColor}"></span>
                <span class="text-[9px] font-bold text-neutral-400 uppercase tracking-wider">${statusText}</span>
              </div>
              <h3 class="font-bold text-sm md:text-base text-neutral-900 border-b border-neutral-200 pb-1 mb-2 leading-snug break-words">${project.name}</h3>
              <p class="text-[11px] md:text-xs text-neutral-600 leading-relaxed mb-3 break-words">${project.description}</p>
              
              <div class="bg-neutral-50 border border-neutral-200/60 p-2 rounded-lg mb-2">
                <span class="block text-[9px] text-neutral-400 font-bold uppercase tracking-wider mb-1">Impact & Status</span>
                <p class="text-[11px] md:text-xs text-neutral-700 leading-normal font-medium mb-2 break-words">${project.businessImpact}</p>
                ${metricsHtml}
              </div>

              ${publicRecordHtml}

              <div class="mt-3">
                <a href="${project.url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full text-center text-[11px] bg-neutral-900 text-white py-2 px-3 rounded-lg hover:bg-neutral-800 transition font-medium tracking-wide shadow-sm pointer-events-auto">
                  Track News Source &rarr;
                </a>
              </div>
            </div>
          `).setLngLat(coords).addTo(map);

          if (window.innerWidth >= 768) {
            const popupNode = activePopup.getElement();
            if (popupNode) {
              popupNode.addEventListener('mouseenter', () => {
                if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
              });
              popupNode.addEventListener('mouseleave', () => {
                closeTimer = window.setTimeout(() => { if (activePopup) activePopup.remove(); }, 300);
              });
            }
          }
        }

        if (window.innerWidth >= 768) {
          el.addEventListener('mouseenter', showPopup);
          el.addEventListener('mouseleave', () => {
            closeTimer = window.setTimeout(() => { if (activePopup) activePopup.remove(); }, 300);
          });
        } else {
          el.addEventListener('click', (e) => {
            e.stopPropagation();
            showPopup();
          });
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initMap);
  if (document.readyState !== 'loading') {
    initMap();
  } else {
    document.addEventListener('DOMContentLoaded', initMap);
  }
</script>