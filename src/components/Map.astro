---
// src/components/Map.astro
import MapThemeSelector from './MapThemeSelector.astro';
import MapFilters from './MapFilters.astro';
import MapDetailPanel from './MapDetailPanel.astro';
import '../styles/mapPins.css';
---

<section class="relative w-full h-dvh overflow-hidden bg-[#f4f4f5]">
  <!-- Collapsible Map Theme Selector (layers icon → popover) -->
  <MapThemeSelector />

  <!-- Collapsible Facility Filters Sidebar -->
  <MapFilters />

  <!-- Full-detail panel, opened on marker click (see mapmarkerselect events below) -->
  <MapDetailPanel />

  <div class="relative w-full h-full">
    <div id="map" class="absolute inset-0 w-full h-full bg-[#f4f4f5]"></div>
  </div>
</section>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { clientProjects } from '~/data/dataCenters';
  import { getDefaultMapStyleUrl } from '~/data/mapStyles';
  import { createMarkerElement, buildPreviewHtml, MarkerFilterController, type MarkerRecord } from '~/lib/mapMarkers';

  const MINNESOTA_CENTER: [number, number] = [-93.2650, 44.9778];
  const MOBILE_ZOOM = 6.8;
  const DESKTOP_ZOOM = 6;
  const DEFAULT_ZOOM = window.innerWidth < 768 ? MOBILE_ZOOM : DESKTOP_ZOOM;

  // Owns the marker-visibility registry; listens for `mapfilterchange` on its own.
  const filterController = new MarkerFilterController();

  function initMap(): void {
    const mapElement = document.getElementById('map');
    if (!mapElement) return;

    const map = new maplibregl.Map({
      container: 'map',
      style: getDefaultMapStyleUrl(),
      center: MINNESOTA_CENTER,
      zoom: DEFAULT_ZOOM,
      scrollZoom: true,
      attributionControl: false,
      cooperativeGestures: window.innerWidth < 768
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'bottom-right');

    map.on('load', () => {
      setTimeout(() => map.resize(), 100);
    });

    // Empty-map click closes an open detail panel (marker clicks stopPropagation
    // below, so this only fires for genuine background clicks).
    map.on('click', () => {
      document.dispatchEvent(new CustomEvent('mapmarkerselect', { detail: null }));
    });

    // Tracks whether a marker is currently selected, and what the camera looked
    // like right before the user started browsing pins — so deselecting returns
    // to wherever they actually were, not a hardcoded default.
    let hasSelection = false;
    let previousView: { center: maplibregl.LngLat; zoom: number } | null = null;

    // Fires for every mapmarkerselect dispatch — including the × button and
    // Escape in MapDetailPanel.astro, and the map background click above —
    // so "zoom back out" is handled in one place regardless of how a
    // selection got cleared.
    document.addEventListener('mapmarkerselect', (event) => {
      const detail = (event as CustomEvent<{ project: (typeof clientProjects)[number] } | null>).detail;
      if (!detail?.project && hasSelection) {
        hasSelection = false;
        const target = previousView ?? { center: MINNESOTA_CENTER, zoom: DEFAULT_ZOOM };
        map.flyTo({ center: target.center, zoom: target.zoom, essential: true });
        previousView = null;
      }
    });

    // MapThemeSelector.astro dispatches this when the user picks a new style.
    document.addEventListener('mapstylechange', (event) => {
      const detail = (event as CustomEvent<{ url: string }>).detail;
      if (detail?.url) map.setStyle(detail.url);
    });

    let activePopup: maplibregl.Popup | null = null;
    let closeTimer: number | null = null;
    const markerRegistry: MarkerRecord[] = [];

    function closePreview(): void {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      if (activePopup) { activePopup.remove(); activePopup = null; }
    }

    /** Flies the camera to a project and opens its full detail panel. Used by both desktop click and mobile tap. */
    function selectProject(project: (typeof clientProjects)[number], coords: [number, number]): void {
      closePreview();
      if (!hasSelection) {
        // First click in this browsing session — remember where the user was
        // so deselecting later returns here, not to a fixed default.
        previousView = { center: map.getCenter(), zoom: map.getZoom() };
      }
      hasSelection = true;
      map.flyTo({ center: coords, zoom: Math.max(map.getZoom(), 11), essential: true });
      document.dispatchEvent(new CustomEvent('mapmarkerselect', { detail: { project } }));
    }

    if (Array.isArray(clientProjects)) {
      clientProjects.forEach((project, index) => {
        if (!project.coordinates) return;
        const coords: [number, number] = [project.coordinates[1], project.coordinates[0]];
        const currentStatus = project.status || 'planned';

        const el = createMarkerElement(currentStatus);
        const marker = new maplibregl.Marker({ element: el }).setLngLat(coords).addTo(map);
        markerRegistry.push({ el, status: currentStatus });

        function showPreview() {
          closePreview();

          const pixel = map.project(coords);
          const width = map.getContainer().clientWidth;
          const height = map.getContainer().clientHeight;

          const verticalAnchor = pixel.y < height / 2 ? 'top' : 'bottom';
          const horizontalAnchor = pixel.x < width / 2 ? 'left' : 'right';
          const calculatedAnchor = `${verticalAnchor}-${horizontalAnchor}` as any;

          activePopup = new maplibregl.Popup({
            offset: [horizontalAnchor === 'left' ? 12 : -12, verticalAnchor === 'top' ? 12 : -12],
            closeButton: false,
            anchor: calculatedAnchor,
            maxWidth: '280px'
          }).setHTML(buildPreviewHtml(project)).setLngLat(coords).addTo(map);

          const popupNode = activePopup.getElement();
          if (popupNode) {
            popupNode.addEventListener('mouseenter', () => {
              if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
            });
            popupNode.addEventListener('mouseleave', () => {
              closeTimer = window.setTimeout(closePreview, 300);
            });
          }
        }

        // Desktop: hover shows the compact preview; click flies in and opens full detail.
        // Mobile: no hover state, so tap goes straight to full detail.
        if (window.innerWidth >= 768) {
          el.addEventListener('mouseenter', showPreview);
          el.addEventListener('mouseleave', () => {
            closeTimer = window.setTimeout(closePreview, 300);
          });
        }

        el.addEventListener('click', (e) => {
          e.stopPropagation();
          selectProject(project, coords);
        });
      });
    }

    filterController.setRegistry(markerRegistry);
  }

  document.addEventListener('astro:page-load', initMap);
  if (document.readyState !== 'loading') {
    initMap();
  } else {
    document.addEventListener('DOMContentLoaded', initMap);
  }
</script>