---
// src/components/map/MapThemeSelector.astro
import { MAP_STYLE_OPTIONS } from "~/data/mapStyles";
import { Sun, Moon } from "lucide-astro";

// Site chrome theme first, basemap second. They're two different things but
// one decision in the user's head ("make this light"), so they share a
// popover rather than competing for space in the control stack.
const SITE_THEMES = [
  { id: "light", label: "Light", icon: Sun },
  { id: "dark", label: "Dark", icon: Moon },
] as const;
---

<!--
  Minimized "layers" control, popover-style like Google Maps' map-type button.
  Collapsed: a single icon button, stacked directly above MapLibre's
  NavigationControl. Both share the --map-ctrl-edge / --map-controls-bottom
  CSS variables defined in global.css, so they always line up and move
  together — MapFilterParent.astro raises --map-controls-bottom on mobile to
  clear its own panel, which shifts this whole stack up in sync.
  Expanded: a small popover panel listing each style, opening upward so it
  doesn't run off the bottom of the viewport; picking one dispatches a
  `mapstylechange` CustomEvent on `document` with `{ url, id }` for MapParent.astro
  to consume.
-->
<div
  id="map-theme-selector"
  class="absolute right-(--map-ctrl-edge) bottom-[calc(var(--map-controls-bottom)+var(--map-ctrl-attrib-height)+var(--map-ctrl-gap)+var(--map-ctrl-group-height)+var(--map-ctrl-gap))] z-20 pointer-events-auto font-sans transition-[bottom] duration-250 ease-out"
>
  <button
    id="mts-toggle"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="mts-panel"
    aria-label="Change map layer"
    class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-white/90 backdrop-blur-sm border border-neutral-200 shadow-lg hover:bg-white text-neutral-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/60"
  >
    <!-- "Layers" icon: three stacked planes, same visual language as Google Maps' map-type control -->
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M12 2 2 7l10 5 10-5-10-5Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <path
        d="M2 12l10 5 10-5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <path
        d="M2 17l10 5 10-5"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <div
    id="mts-panel"
    role="menu"
    class="hidden absolute bottom-full right-0 mb-2 w-48 bg-white/95 backdrop-blur-sm border border-neutral-200 shadow-xl rounded-xl p-1.5 flex-col gap-0.5"
  >
    <span
      class="text-[9px] font-bold text-neutral-400 uppercase tracking-wider px-2 py-1"
    >
      Site Theme
    </span>

    <div class="grid grid-cols-2 gap-1 px-1 pb-1.5" role="radiogroup" aria-label="Site theme">
      {
        SITE_THEMES.map((option) => {
          const Icon = option.icon;
          return (
            <button
              type="button"
              role="radio"
              aria-checked="false"
              class="mts-theme flex items-center justify-center gap-1.5 text-[11px] font-semibold text-neutral-600 rounded-lg px-2 py-1.5 border border-neutral-200 hover:bg-neutral-100 transition"
              data-theme={option.id}
            >
              <Icon size={13} stroke-width={2.25} />
              <span>{option.label}</span>
            </button>
          );
        })
      }
    </div>

    <div class="border-t border-neutral-200 mx-1"></div>

    <span
      class="text-[9px] font-bold text-neutral-400 uppercase tracking-wider px-2 py-1"
    >
      Map Theme
    </span>
    {
      MAP_STYLE_OPTIONS.map((option) => (
        <button
          type="button"
          role="menuitemradio"
          class="mts-option flex items-center justify-between gap-2 text-left text-[11px] md:text-xs font-semibold text-neutral-700 rounded-lg px-2 py-1.5 hover:bg-neutral-100 transition"
          data-style-id={option.id}
          data-style-url={option.url}
        >
          <span>{option.label}</span>
          <svg
            class="mts-check w-3.5 h-3.5 text-emerald-500 opacity-0 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 13l4 4L19 7"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      ))
    }
  </div>
</div>

<script>
  import {
    clearStoredMapStyleId,
    getInitialMapStyleId,
    getMapStyleIdForTheme,
    getMapStyleUrlById,
    storeMapStyleId,
  } from "~/data/mapStyles";
  import { onReady } from "~/lib/domReady";
  import {
    getActiveTheme,
    isSiteTheme,
    setTheme,
    type SiteTheme,
  } from "~/lib/siteTheme";

  function initThemeSelector(): void {
    const root = document.getElementById("map-theme-selector");
    if (!root) return;

    const toggle = document.getElementById(
      "mts-toggle",
    ) as HTMLButtonElement | null;
    const panel = document.getElementById("mts-panel") as HTMLElement | null;
    const options = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".mts-option"),
    );
    const themeButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".mts-theme"),
    );

    let open = false;
    // Always a valid id from MAP_STYLE_OPTIONS — an explicit past choice, or the
    // basemap paired with the stored site theme. There used to be a chain of
    // fallbacks behind this (a data-attribute default, then the first option,
    // then an empty string); none of them was reachable.
    let currentStyleId = getInitialMapStyleId();

    function applyStyle(styleId: string): void {
      currentStyleId = styleId;
      syncChecks();
      document.dispatchEvent(
        new CustomEvent("mapstylechange", {
          detail: { url: getMapStyleUrlById(styleId), id: styleId },
        }),
      );
    }

    function syncChecks(): void {
      options.forEach((opt) => {
        const check = opt.querySelector<SVGElement>(".mts-check");
        const active = opt.dataset.styleId === currentStyleId;
        if (check) check.style.opacity = active ? "1" : "0";
        opt.classList.toggle("bg-neutral-100", active);
      });

      const theme = getActiveTheme();
      themeButtons.forEach((btn) => {
        const active = btn.dataset.theme === theme;
        btn.setAttribute("aria-checked", String(active));
        btn.classList.toggle("bg-neutral-100", active);
        btn.classList.toggle("border-neutral-400", active);
        btn.classList.toggle("text-neutral-900", active);
        btn.classList.toggle("border-neutral-200", !active);
        btn.classList.toggle("text-neutral-600", !active);
      });
    }

    function selectTheme(theme: SiteTheme): void {
      // Theme and basemap move together: picking Light also drops the map to
      // its paired basemap, and likewise for Dark.
      //
      // This *clears* any hand-picked basemap rather than persisting the one it
      // just applied. It used to store it, which looked equivalent — a reload
      // came back to the same map either way — but wasn't: `getInitialMapStyleId`
      // reads a stored id as a deliberate override that outranks the pairing, so
      // every visitor who had ever clicked a theme was pinned to whatever the
      // pairing happened to be that day, and repointing `THEME_BASEMAP` later
      // could never reach them. Nothing is lost by not writing it, because the
      // pairing is recoverable from the stored *theme* (see mapStyles.ts).
      setTheme(theme);
      clearStoredMapStyleId();
      applyStyle(getMapStyleIdForTheme(theme));
    }

    function setOpen(next: boolean): void {
      open = next;
      panel?.classList.toggle("hidden", !open);
      toggle?.setAttribute("aria-expanded", String(open));
    }

    toggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!open);
    });

    document.addEventListener("click", (e) => {
      if (open && root && !root.contains(e.target as Node)) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const styleId = opt.dataset.styleId;
        if (!styleId) return;
        // Picking a basemap by hand makes it sticky — see storeMapStyleId.
        storeMapStyleId(styleId);
        applyStyle(styleId);
        setOpen(false);
      });
    });

    themeButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const theme = btn.dataset.theme;
        if (isSiteTheme(theme)) selectTheme(theme);
      });
    });

    syncChecks();
  }

  onReady(initThemeSelector);
</script>
