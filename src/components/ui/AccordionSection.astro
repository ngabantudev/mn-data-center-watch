---
// src/components/ui/AccordionSection.astro
//
// One collapsible section of the filters sidebar. Every section ships closed —
// MapFilterParent's exclusive-accordion script is what opens one at a time, and
// it reads the classes below rather than any per-section configuration. The
// component previously took `id` and `openByDefault` props; nothing read the
// former, and every one of the five call sites passed the latter as false.
import { ChevronDown } from "lucide-astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="mf-accordion-section border-b border-hair">
  <!--
    `group` + the group-hover ink lifts read as normal hover emphasis, and also
    keep the contrast: hover shifts the row to --hover, a step away from the
    panel in both themes, which the muted ink tokens have to follow to stay
    clear of 4.5:1.
  -->
  <button
    type="button"
    class="mf-accordion-trigger group w-full flex items-center justify-between px-3.5 md:px-4 py-3 hover:bg-hover text-left transition-colors"
    aria-expanded="false"
  >
    <span
      class="text-[10px] font-bold text-ink-3 group-hover:text-ink uppercase tracking-wider"
      >{title}</span
    >
    <ChevronDown
      size={14}
      class="text-ink-4 group-hover:text-ink-2 transition-transform duration-200 -rotate-90"
    />
  </button>

  <div
    class="mf-accordion-content transition-[grid-template-rows] duration-200 ease-out grid grid-rows-[0fr]"
  >
    <div class="overflow-hidden">
      <slot />
    </div>
  </div>
</div>
