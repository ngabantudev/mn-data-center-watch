---
// src/components/MapLegend.astro

const legendItems = [
  { color: 'bg-[#10b981]', label: 'Operational Site', description: 'Active and on the grid', activePulse: false },
  { color: 'bg-[#f97316]', label: 'Active Construction', description: 'Formally approved / building out', activePulse: true },
  { color: 'bg-[#3b82f6]', label: 'Proposed / Planned', description: 'In zoning reviews or permitting', activePulse: false },
  { color: 'bg-[#f59e0b]', label: 'Development Paused', description: 'Held by legal stays or moratorium', activePulse: false },
  { color: 'bg-[#ef4444]', label: 'Rejected / Withdrawn', description: 'Voted down or cancelled', activePulse: false },
];
---

<!-- Added responsive positioning: absolute on desktop, but safely padded on mobile so it doesn't crowd out the map -->
<div class="absolute bottom-4 left-4 right-4 md:right-auto md:bottom-6 md:left-6 z-10 bg-white/95 backdrop-blur-sm border border-neutral-200 shadow-xl rounded-xl p-3 md:p-3.5 max-w-full md:max-w-64 font-sans pointer-events-auto">
  <h4 class="text-[9px] md:text-[10px] font-bold text-neutral-400 uppercase tracking-wider mb-2 md:b-2.5 px-0.5">
    Tracking 29 MN Facilities
  </h4>
  
  <!-- Grid layout on mobile (2 columns) to save vertical space; single column on desktop -->
  <div class="grid grid-cols-2 gap-2 md:flex md:flex-col md:gap-2.5">
    {legendItems.map((item) => (
      <div class="flex items-start gap-2 md:gap-3">
        <div class="relative w-2.5 h-2.5 md:w-3 md:h-3 mt-0.5 shrink-0 flex items-center justify-center">
          {item.activePulse && (
            <span class="absolute inline-flex h-full w-full rounded-full bg-[#f97316] opacity-75 animate-ping"></span>
          )}
          <span class={`relative inline-block w-2.5 h-2.5 md:w-3 md:h-3 rounded-full ${item.color}`} />
        </div>
        <div class="flex flex-col">
          <span class="text-[11px] md:text-xs font-semibold text-neutral-800 leading-none">
            {item.label}
          </span>
          <!-- Subtext hidden on mobile to keep the viewport clean, visible on tablet/desktop -->
          <span class="hidden md:inline-block text-[10px] text-neutral-500 font-medium mt-0.5 leading-tight">
            {item.description}
          </span>
        </div>
      </div>
    ))}
  </div>
</div>