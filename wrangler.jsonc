{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "mn-data-center-watch",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// The cross-colo cache layer, shared by the legislative tracker and the news
	// route via ~/lib/edgeCache.ts.
	//
	// It stayed optional for a long time and no longer is, because an outage
	// proved what the other layers can't do. Module memory dies with the
	// isolate; the Cache API is per-colo *and* evictable under memory pressure —
	// production's last-good news copy was serving real headlines one hour and
	// had been evicted the next, while Google was refusing our egress. With
	// nothing durable behind it the panel had nothing to fall back to. KV is the
	// only layer that survives both an isolate restart and a colo it has never
	// been seen in.
	//
	// This does NOT speed up a warm request. `read()` checks memory, then the
	// Cache API, then this — so a hit above never reaches it, and a true miss
	// now pays a KV read (tens of ms) before going upstream. What it buys is the
	// cold case: a colo that has never served this key answers from KV instead
	// of from Google, which is ~1s normally and up to the full 8s query budget
	// when Google is refusing us.
	//
	// WRITE BUDGET — read before adding a caller. KV's free tier allows 1,000
	// writes/day. The routes together write at most 176: one per key per
	// freshness period (news 15m/30m/1h/6h, legislation 6h). That headroom only
	// exists because cooldown markers are explicitly kept out of KV — see the
	// `durable` option in edgeCache.ts. Writing those here would cost 5,760/day
	// during a sustained outage and exhaust the quota the real copies need.
	//
	// SECOND WRITER, added deliberately: `.github/workflows/refresh-news.yml`
	// writes four `news:mirror:v1:*` keys every 30 minutes — 192/day — because
	// Google answers a GitHub runner and refuses this Worker's egress. See
	// ~/lib/newsMirror.ts for the measurements. Running total is therefore ~368
	// of the 1,000, and the schedule is the dial: halving the interval doubles
	// that half of it. Those keys are namespaced away from the cache's own
	// `news:v3:*` on purpose — CI is an upstream the route reads, not a cache
	// layer racing the one in edgeCache.ts, which would lose anyway because KV
	// is the last layer `read()` consults.
	//
	// Reads are bounded by traffic against a 100,000/day allowance and only
	// occur on a memory + Cache API miss. Every KV call in edgeCache.ts is
	// wrapped in `.catch(() => {})`, so if a limit is ever reached the layer
	// simply drops out and the cache degrades to what it was before this
	// binding existed.
	//
	// (The `SESSION` namespace this project already has is Astro's, created by
	// the Cloudflare adapter for sessions — don't reuse it for this.)
	"kv_namespaces": [
		{ "binding": "LEGISLATION_CACHE", "id": "484d2a31d0f24f99aed7ab9ea061616a" }
	],
	// OFF, deliberately — this is the no-PII posture applied to our own logs.
	//
	// Worker request logs carry client IP addresses. An IP is personal data in
	// most frameworks even on a site like this one, which has no forms, no
	// accounts, and asks for nothing about anybody. No wrangler flag strips
	// them, and retention alone still means holding them for a window; the
	// only way not to hold them is not to collect them. So we don't.
	//
	// The cost is real and worth stating: with this off there are no
	// server-side error logs, so a broken upstream (Open States, the tile
	// bucket) surfaces as degraded UI rather than as a log line. Both routes
	// are built to fail visibly for exactly that reason — /api/legislation
	// returns `source: "degraded"` when every lookup comes back empty, and the
	// banner explains itself rather than showing a wall of "status unknown".
	//
	// To debug a production incident, turn this on, reproduce, and turn it
	// back off — rather than leaving it on for the day you might need it.
	// `head_sampling_rate` is the middle setting if that trade ever needs to
	// be reopened. Same caveat applies on any other host: Vercel's function
	// logs behave the same way.
	"observability": {
		"enabled": false
	}
}
