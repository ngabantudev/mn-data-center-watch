{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "mn-data-center-watch",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// OPTIONAL cache upgrade for the legislative tracker.
	//
	// ~/lib/edgeCache.ts looks for a `LEGISLATION_CACHE` KV binding and uses it
	// when present, falling back to isolate memory plus the Cache API when it
	// isn't. Nothing needs this to work — it ships without a binding on purpose.
	//
	// What KV adds: the memory layer dies with the isolate and the Cache API is
	// per-colo and a no-op on workers.dev, so on a cold isolate the tracker
	// refreshes from Open States again. That's fine at 4 requests against a
	// 10/min ceiling, and it stops being fine if traffic arrives from many
	// regions at once. KV is the only layer that survives both.
	//
	// To enable:
	//   wrangler kv namespace create LEGISLATION_CACHE
	// then uncomment below with the returned id. (The `SESSION` namespace this
	// project already has is Astro's, created by the Cloudflare adapter for
	// sessions — don't reuse it for this.)
	//
	// "kv_namespaces": [
	// 	{ "binding": "LEGISLATION_CACHE", "id": "<id from the command above>" }
	// ],
	// OFF, deliberately — this is the no-PII posture applied to our own logs.
	//
	// Worker request logs carry client IP addresses. An IP is personal data in
	// most frameworks even on a site like this one, which has no forms, no
	// accounts, and asks for nothing about anybody. No wrangler flag strips
	// them, and retention alone still means holding them for a window; the
	// only way not to hold them is not to collect them. So we don't.
	//
	// The cost is real and worth stating: with this off there are no
	// server-side error logs, so a broken upstream (Open States, the tile
	// bucket) surfaces as degraded UI rather than as a log line. Both routes
	// are built to fail visibly for exactly that reason — /api/legislation
	// returns `source: "degraded"` when every lookup comes back empty, and the
	// banner explains itself rather than showing a wall of "status unknown".
	//
	// To debug a production incident, turn this on, reproduce, and turn it
	// back off — rather than leaving it on for the day you might need it.
	// `head_sampling_rate` is the middle setting if that trade ever needs to
	// be reopened. Same caveat applies on any other host: Vercel's function
	// logs behave the same way.
	"observability": {
		"enabled": false
	}
}
